<view class="ann-detail-page" style="background: {{theme.surface || '#1A1A2E'}}; min-height: 100vh; padding-bottom: 180rpx; padding-top: {{statusBarHeight + 44}}px;">
  <!-- Custom Navigation Bar -->
  <view class="nav-bar" style="background: {{theme.gradientHeader || theme.surfaceColor || '#1A1A2E'}}; padding-top: {{statusBarHeight}}px; height: {{statusBarHeight + 44}}px; box-sizing: border-box;">
    <view class="nav-bar-content">
      <view class="nav-back" bindtap="onBack">
        <text class="nav-back-icon" style="color: {{theme.textPrimary || '#F5F0E8'}}">❮</text>
      </view>
      <text class="nav-title" style="color: {{theme.textPrimary || '#F5F0E8'}};">公告详情</text>
      <view class="nav-action"></view>
    </view>
  </view>

  <!-- Loading -->
  <view wx:if="{{loading}}" style="padding: 32rpx;">
    <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 28rpx;">加载中...</text>
  </view>

  <!-- Content -->
  <block wx:if="{{!loading && announcement}}">
    <!-- Priority Badge + Confirm Status -->
    <view style="padding: 32rpx; padding-bottom: 0;">
      <view style="display: flex; align-items: center; gap: 12rpx; margin-bottom: 20rpx;">
        <theme-badge wx:if="{{announcement.priority !== 'normal'}}" theme="{{theme}}" status="{{announcement.priority}}" type="role" text="{{announcement.priority === 'urgent' ? '紧急' : announcement.priority === 'important' ? '重要' : '普通'}}" />
        <view wx:if="{{announcement.needsConfirm && !needsConfirm}}" style="background: rgba(74, 222, 128, 0.15); color: #4ADE80; padding: 6rpx 16rpx; border-radius: 999rpx; font-size: 22rpx;">已确认</view>
        <view wx:if="{{announcement.needsConfirm && needsConfirm}}" style="background: rgba(251, 191, 36, 0.15); color: #FBBF24; padding: 6rpx 16rpx; border-radius: 999rpx; font-size: 22rpx;">待确认</view>
      </view>
    </view>

    <!-- Title + Meta -->
    <view style="padding: 0 32rpx 32rpx;">
      <text style="color: {{theme.textPrimary || '#F5F0E8'}}; font-size: 44rpx; font-weight: 700; display: block; margin-bottom: 16rpx; line-height: 1.4;">{{announcement.title}}</text>
      <view style="display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx;">
        <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 26rpx;">{{announcement.createdByName}}</text>
        <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 26rpx;">·</text>
        <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 26rpx;">{{formattedTime}}</text>
        <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 26rpx;">·</text>
        <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 26rpx;">{{readCount}}人已读</text>
      </view>
      <!-- Display Time -->
      <view style="display: flex; align-items: center; gap: 8rpx; margin-bottom: 24rpx; background: {{theme.elevated || '#252540'}}; border-radius: 12rpx; padding: 14rpx 20rpx; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.08)'}};">
        <text style="color: {{theme.accentColor || '#C9A96E'}}; font-size: 26rpx;">📅</text>
        <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 24rpx;">显示时间：</text>
        <text style="color: {{theme.textPrimary || '#F5F0E8'}}; font-size: 24rpx; font-weight: 500;">{{displayDateText}}</text>
      </view>
      <view style="height: 1rpx; background: {{theme.divider || 'rgba(255,255,255,0.08)'}};"></view>
    </view>

    <!-- Content Body -->
    <view style="padding: 0 32rpx;">
      <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 30rpx; line-height: 1.9; display: block; white-space: pre-wrap;">{{announcement.content}}</text>
    </view>

    <!-- Read/Unread Staff List -->
    <view wx:if="{{announcement.needsConfirm}}" style="padding: 32rpx; margin-top: 16rpx;">
      <view style="background: {{theme.elevated || '#252540'}}; border-radius: 16rpx; padding: 24rpx; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}};">
        <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 24rpx; display: block; margin-bottom: 16rpx;">确认状态</text>
        <view style="display: flex; gap: 24rpx;">
          <!-- Confirmed list -->
          <view style="flex: 1;">
            <text style="color: #4ADE80; font-size: 24rpx; font-weight: 600; display: block; margin-bottom: 10rpx;">✓ 已确认 ({{readStaff.length}})</text>
            <view wx:for="{{readStaff}}" wx:key="id" style="padding: 6rpx 0; border-bottom: 1rpx solid {{theme.divider || 'rgba(255,255,255,0.04)'}};">
              <text style="color: {{theme.textPrimary || '#F5F0E8'}}; font-size: 26rpx;">{{item.name}}</text>
            </view>
            <view wx:if="{{readStaff.length === 0}}">
              <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 24rpx;">暂无</text>
            </view>
          </view>
          <!-- Unconfirmed list -->
          <view style="flex: 1;">
            <text style="color: #F87171; font-size: 24rpx; font-weight: 600; display: block; margin-bottom: 10rpx;">○ 未确认 ({{unreadStaff.length}})</text>
            <view wx:for="{{unreadStaff}}" wx:key="id" style="padding: 6rpx 0; border-bottom: 1rpx solid {{theme.divider || 'rgba(255,255,255,0.04)'}};">
              <text style="color: {{theme.textPrimary || '#F5F0E8'}}; font-size: 26rpx;">{{item.name}}</text>
            </view>
            <view wx:if="{{unreadStaff.length === 0}}">
              <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 24rpx;">全部已确认</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- Day Navigation Strip -->
  <view style="margin: 40rpx 32rpx 0; padding: 24rpx; background: {{theme.elevated || '#252540'}}; border-radius: 16rpx; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}};">
    <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 24rpx; display: block; margin-bottom: 16rpx;">当日其他公告 ({{dayAnnouncements.length}}条)</text>
    <view wx:for="{{dayAnnouncements}}" wx:key="_id" style="margin-bottom: 10rpx;">
      <view bindtap="onDayAnnouncementTap" data-id="{{item._id}}" style="background: {{item._id === announcement._id ? 'rgba(201,169,110,0.15)' : (theme.surface || '#1A1A2E')}}; border-radius: 10rpx; padding: 14rpx 18rpx; display: flex; align-items: center; gap: 10rpx; border: 1rpx solid {{item._id === announcement._id ? 'rgba(201,169,110,0.4)' : (theme.borderColor || 'rgba(255,255,255,0.10)')}};">
        <view wx:if="{{item.priority === 'urgent'}}" style="width: 12rpx; height: 12rpx; border-radius: 50%; background: #EF4444; flex-shrink: 0;"></view>
        <view wx:elif="{{item.priority === 'important'}}" style="width: 12rpx; height: 12rpx; border-radius: 50%; background: #FBBF24; flex-shrink: 0;"></view>
        <text style="color: {{item._id === announcement._id ? (theme.accentColor || '#C9A96E') : (theme.textSecondary || '#9A9AB0')}}; font-size: 26rpx; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{item.title}}</text>
        <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 22rpx;">›</text>
      </view>
    </view>
  </view>

  <!-- Bottom Action Bar -->
  <view wx:if="{{!loading && announcement}}" style="position: fixed; bottom: 0; left: 0; right: 0; z-index: 200; padding: 20rpx 32rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); background: rgba(15,15,26,0.98); border-top: 1rpx solid {{theme.dividerColor || 'rgba(255,255,255,0.08)'}}; display: flex; gap: 16rpx; align-items: center;">

    <!-- Edit + Delete buttons (for editors) -->
    <block wx:if="{{canEdit}}">
      <view bindtap="onEdit" style="flex: 1; background: linear-gradient(135deg, #C9A96E, #E8D5A8); border-radius: 999rpx; padding: 22rpx; display: flex; align-items: center; justify-content: center; box-shadow: 0 8rpx 24rpx rgba(201,169,110,0.3);">
        <text style="color: #0F0F1A; font-size: 30rpx; font-weight: 700; letter-spacing: 2rpx;">修改</text>
      </view>
      <view bindtap="onDeleteDirect" style="background: rgba(248,113,113,0.12); border: 1rpx solid rgba(248,113,113,0.3); border-radius: 999rpx; padding: 22rpx 36rpx; display: flex; align-items: center; justify-content: center;">
        <text style="color: #F87171; font-size: 30rpx; font-weight: 600;">删除</text>
      </view>
    </block>

    <!-- Confirm Read (for non-editors who need to confirm) -->
    <block wx:elif="{{announcement.needsConfirm === true}}">
      <view wx:if="{{needsConfirm}}" bindtap="onConfirmRead" style="flex: 1; background: linear-gradient(135deg, #C9A96E, #E8D5A8); border-radius: 999rpx; padding: 24rpx; display: flex; align-items: center; justify-content: center; box-shadow: 0 8rpx 24rpx rgba(201,169,110,0.3);">
        <text style="color: #0F0F1A; font-size: 32rpx; font-weight: 700; letter-spacing: 4rpx;">确认已读</text>
      </view>
      <view wx:else style="flex: 1; background: rgba(74,222,128,0.12); border: 1rpx solid rgba(74,222,128,0.3); border-radius: 999rpx; padding: 24rpx; display: flex; align-items: center; justify-content: center;">
        <text style="color: #4ADE80; font-size: 28rpx; font-weight: 600;">✓ 已确认阅读</text>
      </view>
    </block>
  </view>

  <!-- Edit Modal -->
  <theme-modal theme="{{theme}}" visible="{{showEditModal}}" title="编辑公告" confirmText="保存" cancelText="取消" bind:confirm="onSaveEdit" bind:close="onCloseEditModal" position="center">
    <view style="padding: 8rpx 0;">
      <view style="margin-bottom: 24rpx;">
        <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 24rpx; display: block; margin-bottom: 12rpx;">标题</text>
        <input class="modal-input" placeholder="公告标题" placeholder-style="color: {{theme.textMuted || '#5C5C72'}};" value="{{editTitle}}" bindinput="onEditTitleInput" style="background: {{theme.surface || '#1A1A2E'}}; border: 1rpx solid {{theme.border || 'rgba(255,255,255,0.1)'}}; border-radius: 12rpx; padding: 16rpx 20rpx; color: {{theme.textPrimary || '#F0F0F5'}}; font-size: 28rpx;" />
      </view>
      <view style="margin-bottom: 24rpx;">
        <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 24rpx; display: block; margin-bottom: 12rpx;">内容</text>
        <textarea class="modal-textarea" placeholder="公告内容" placeholder-style="color: {{theme.textMuted || '#5C5C72'}};" value="{{editContent}}" bindinput="onEditContentInput" style="background: {{theme.surface || '#1A1A2E'}}; border: 1rpx solid {{theme.border || 'rgba(255,255,255,0.1)'}}; border-radius: 12rpx; padding: 16rpx 20rpx; color: {{theme.textPrimary || '#F0F0F5'}}; font-size: 28rpx; width: 100%; min-height: 200rpx; resize: none;" />
      </view>
      <view style="margin-bottom: 24rpx;">
        <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 24rpx; display: block; margin-bottom: 12rpx;">优先级</text>
        <view style="display: flex; gap: 12rpx;">
          <view class="priority-pill {{editPriority === 'normal' ? 'active' : ''}}" data-priority="normal" bindtap="onEditPriorityChange" style="{{editPriority === 'normal' ? 'background:' + (theme.accentColor || '#C9A96E') + ';color:' + (theme.textInverse || '#0F0F1A') + ';' : 'background:' + (theme.elevated || '#252540') + ';color:' + (theme.textSecondary || '#9A9AB0') + ';'}} padding: 10rpx 24rpx; border-radius: 999rpx; font-size: 26rpx;">普通</view>
          <view class="priority-pill {{editPriority === 'important' ? 'active' : ''}}" data-priority="important" bindtap="onEditPriorityChange" style="{{editPriority === 'important' ? 'background:' + (theme.statusWarning || '#FBBF24') + ';color:#000;' : 'background:' + (theme.elevated || '#252540') + ';color:' + (theme.textSecondary || '#9A9AB0') + ';'}} padding: 10rpx 24rpx; border-radius: 999rpx; font-size: 26rpx;">重要</view>
          <view class="priority-pill {{editPriority === 'urgent' ? 'active' : ''}}" data-priority="urgent" bindtap="onEditPriorityChange" style="{{editPriority === 'urgent' ? 'background:' + (theme.statusDanger || '#F87171') + ';color:#fff;' : 'background:' + (theme.elevated || '#252540') + ';color:' + (theme.textSecondary || '#9A9AB0') + ';'}} padding: 10rpx 24rpx; border-radius: 999rpx; font-size: 26rpx;">紧急</view>
        </view>
      </view>
      <view style="margin-bottom: 24rpx;">
        <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 24rpx; display: block; margin-bottom: 12rpx;">显示时间</text>
        <view style="display: flex; gap: 16rpx; align-items: center;">
          <picker mode="date" value="{{editStartDate}}" bindchange="onEditStartDateChange">
            <view style="background: {{theme.surface || '#1A1A2E'}}; border: 1rpx solid {{theme.border || 'rgba(255,255,255,0.1)'}}; border-radius: 12rpx; padding: 16rpx 20rpx; flex: 1; color: {{theme.textPrimary || '#F0F0F5'}}; font-size: 26rpx;">
              {{editStartDate || '起始日期'}}
            </view>
          </picker>
          <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 24rpx;">至</text>
          <picker mode="date" value="{{editEndDate}}" bindchange="onEditEndDateChange">
            <view style="background: {{theme.surface || '#1A1A2E'}}; border: 1rpx solid {{theme.border || 'rgba(255,255,255,0.1)'}}; border-radius: 12rpx; padding: 16rpx 20rpx; flex: 1; color: {{theme.textPrimary || '#F0F0F5'}}; font-size: 26rpx;">
              {{editEndDate || '结束日期'}}
            </view>
          </picker>
        </view>
      </view>
      <view class="toggle-row">
        <view style="flex: 1;">
          <text style="color: {{theme.textPrimary || '#F0F0F5'}}; font-size: 28rpx; font-weight: 500;">需要员工确认</text>
          <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 24rpx; display: block; margin-top: 4rpx;">开启后员工需点击确认才计入已读</text>
        </view>
        <switch checked="{{editNeedsConfirm}}" bindchange="onEditNeedsConfirmChange" color="{{theme.accentColor || '#C9A96E'}}" />
      </view>

      <!-- Delete Button -->
      <view style="margin-top: 40rpx; padding-top: 32rpx; border-top: 1rpx solid {{theme.divider || 'rgba(255,255,255,0.08)'}};">
        <view bindtap="onDeleteFromEdit" style="background: rgba(248,113,113,0.10); border: 1rpx solid rgba(248,113,113,0.25); border-radius: 16rpx; padding: 22rpx; display: flex; align-items: center; justify-content: center;">
          <text style="color: #F87171; font-size: 28rpx; font-weight: 600;">删除此公告</text>
        </view>
      </view>
    </view>
  </theme-modal>
</view>
