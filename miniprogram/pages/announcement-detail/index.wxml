<view class="ann-detail-page" style="background: {{theme.surface || '#1A1A2E'}}; min-height: 100vh; padding-bottom: 120rpx; padding-top: {{statusBarHeight + 44}}px;">
  <!-- Custom Navigation Bar -->
  <view class="nav-bar" style="background: {{theme.gradientHeader || theme.surfaceColor || '#1A1A2E'}}; padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar-content">
      <view class="nav-back" bindtap="onBack">
        <text class="nav-back-icon" style="color: {{theme.textPrimary || '#F5F0E8'}}">❮</text>
      </view>
      <text class="nav-title" style="color: {{theme.textPrimary || '#F5F0E8'}};">公告详情</text>
      <view class="nav-action"></view>
    </view>
  </view>

  <!-- Loading -->
  <view wx:if="{{loading}}" style="padding: 32rpx;">
    <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 28rpx;">加载中...</text>
  </view>

  <!-- Content -->
  <block wx:if="{{!loading && announcement}}">
    <!-- Priority Badge + Confirm Status -->
    <view style="padding: 32rpx; padding-bottom: 0;">
      <view style="display: flex; align-items: center; gap: 12rpx; margin-bottom: 20rpx;">
        <theme-badge wx:if="{{announcement.priority !== 'normal'}}" theme="{{theme}}" status="{{announcement.priority}}" type="role" text="{{announcement.priority === 'urgent' ? '紧急' : announcement.priority === 'important' ? '重要' : '普通'}}" />
        <view wx:if="{{announcement.needsConfirm && !needsConfirm}}" style="background: rgba(74, 222, 128, 0.15); color: #4ADE80; padding: 6rpx 16rpx; border-radius: 999rpx; font-size: 22rpx;">已确认</view>
        <view wx:if="{{announcement.needsConfirm && needsConfirm}}" style="background: rgba(251, 191, 36, 0.15); color: #FBBF24; padding: 6rpx 16rpx; border-radius: 999rpx; font-size: 22rpx;">待确认</view>
      </view>
    </view>

    <!-- Title + Meta -->
    <view style="padding: 0 32rpx 32rpx;">
      <text style="color: {{theme.textPrimary || '#F5F0E8'}}; font-size: 44rpx; font-weight: 700; display: block; margin-bottom: 16rpx; line-height: 1.4;">{{announcement.title}}</text>
      <view style="display: flex; align-items: center; gap: 16rpx; margin-bottom: 32rpx;">
        <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 26rpx;">{{announcement.createdByName}}</text>
        <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 26rpx;">·</text>
        <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 26rpx;">{{formattedTime}}</text>
        <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 26rpx;">·</text>
        <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 26rpx;">{{announcement.readBy.length}}人已读</text>
      </view>
      <view style="height: 1rpx; background: {{theme.divider || 'rgba(255,255,255,0.08)'}};"></view>
    </view>

    <!-- Content Body -->
    <view style="padding: 0 32rpx;">
      <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 30rpx; line-height: 1.9; display: block; white-space: pre-wrap;">{{announcement.content}}</text>
    </view>

    <!-- Read/Unread Staff List -->
    <view wx:if="{{announcement.needsConfirm}}" style="padding: 32rpx; margin-top: 16rpx;">
      <view style="background: {{theme.elevated || '#252540'}}; border-radius: 16rpx; padding: 24rpx; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}};">
        <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 24rpx; display: block; margin-bottom: 16rpx;">确认状态</text>
        <view style="display: flex; gap: 24rpx;">
          <!-- Confirmed list -->
          <view style="flex: 1;">
            <text style="color: #4ADE80; font-size: 24rpx; font-weight: 600; display: block; margin-bottom: 10rpx;">✓ 已确认 ({{readStaff.length}})</text>
            <view wx:for="{{readStaff}}" wx:key="id" style="padding: 6rpx 0; border-bottom: 1rpx solid {{theme.divider || 'rgba(255,255,255,0.04)'}};">
              <text style="color: {{theme.textPrimary || '#F5F0E8'}}; font-size: 26rpx;">{{item.name}}</text>
            </view>
            <view wx:if="{{readStaff.length === 0}}">
              <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 24rpx;">暂无</text>
            </view>
          </view>
          <!-- Unconfirmed list -->
          <view style="flex: 1;">
            <text style="color: #F87171; font-size: 24rpx; font-weight: 600; display: block; margin-bottom: 10rpx;">○ 未确认 ({{unreadStaff.length}})</text>
            <view wx:for="{{unreadStaff}}" wx:key="id" style="padding: 6rpx 0; border-bottom: 1rpx solid {{theme.divider || 'rgba(255,255,255,0.04)'}};">
              <text style="color: {{theme.textPrimary || '#F5F0E8'}}; font-size: 26rpx;">{{item.name}}</text>
            </view>
            <view wx:if="{{unreadStaff.length === 0}}">
              <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 24rpx;">全部已确认</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- Day Navigation Strip -->
  <view style="margin: 40rpx 32rpx 0; padding: 24rpx; background: {{theme.elevated || '#252540'}}; border-radius: 16rpx; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}};">
    <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 24rpx; display: block; margin-bottom: 16rpx;">当日其他公告 ({{dayAnnouncements.length}}条)</text>
    <view wx:for="{{dayAnnouncements}}" wx:key="_id" style="margin-bottom: 10rpx;">
      <view bindtap="onDayAnnouncementTap" data-id="{{item._id}}" style="background: {{item._id === announcement._id ? 'rgba(201,169,110,0.15)' : (theme.surface || '#1A1A2E')}}; border-radius: 10rpx; padding: 14rpx 18rpx; display: flex; align-items: center; gap: 10rpx; border: 1rpx solid {{item._id === announcement._id ? 'rgba(201,169,110,0.4)' : (theme.borderColor || 'rgba(255,255,255,0.10)')}};">
        <view wx:if="{{item.priority === 'urgent'}}" style="width: 12rpx; height: 12rpx; border-radius: 50%; background: #EF4444; flex-shrink: 0;"></view>
        <view wx:elif="{{item.priority === 'important'}}" style="width: 12rpx; height: 12rpx; border-radius: 50%; background: #FBBF24; flex-shrink: 0;"></view>
        <text style="color: {{item._id === announcement._id ? (theme.accentColor || '#C9A96E') : (theme.textSecondary || '#9A9AB0')}}; font-size: 26rpx; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{item.title}}</text>
        <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 22rpx;">›</text>
      </view>
    </view>
  </view>

  <!-- Confirm Read Button (only show when needsConfirm is explicitly true) -->
  <view wx:if="{{!loading && announcement && announcement.needsConfirm === true}}" style="position: fixed; bottom: 0; left: 0; right: 0; z-index: 200; padding: 24rpx 32rpx; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); background: rgba(15,15,26,0.98); border-top: 1rpx solid {{theme.dividerColor || 'rgba(255,255,255,0.08)'}};">
    <view wx:if="{{needsConfirm}}" bindtap="onConfirmRead" style="background: linear-gradient(135deg, #C9A96E, #E8D5A8); border-radius: 999rpx; padding: 24rpx; display: flex; align-items: center; justify-content: center; box-shadow: 0 8rpx 24rpx rgba(201,169,110,0.3);">
      <text style="color: #0F0F1A; font-size: 32rpx; font-weight: 700; letter-spacing: 4rpx;">确认已读</text>
    </view>
    <view wx:else style="background: rgba(74,222,128,0.12); border: 1rpx solid rgba(74,222,128,0.3); border-radius: 999rpx; padding: 24rpx; display: flex; align-items: center; justify-content: center;">
      <text style="color: #4ADE80; font-size: 28rpx; font-weight: 600;">✓ 已确认阅读</text>
    </view>
  </view>
</view>
