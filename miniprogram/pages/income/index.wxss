@import '../../styles/mixins.wxss';

.income-page {
  min-height: 100vh;
}

/* Navigation Bar */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-bar-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 44rpx;
  font-weight: 300;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
}

.nav-action {
  min-width: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.month-header {
  padding-top: 48rpx;
}

.month-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
}

.nav-arrow {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: rgba(255,255,255,0.6);
  border: 1rpx solid rgba(255,255,255,0.1);
  border-radius: 50%;
  transition: opacity 0.2s;
}

.nav-arrow-disabled {
  opacity: 0.3;
  pointer-events: none;
}

.month-label {
  font-size: 32rpx;
  font-weight: 600;
  min-width: 160rpx;
  text-align: center;
}

.filter-bar {
  border-bottom: 1rpx solid rgba(255,255,255,0.04);
}

.summary-card {
  position: relative;
  overflow: hidden;
}

.summary-card::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 200rpx;
  height: 200rpx;
  background: rgba(74, 222, 128, 0.05);
  border-radius: 50%;
  transform: translate(50%, -50%);
}

.income-list {
  padding-top: 8rpx;
}

.income-item {
  transition: transform 0.15s ease;
}

.income-item:active {
  transform: scale(0.98);
}

.item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-meta {
  display: flex;
  align-items: center;
}

.fab {
  position: fixed;
  bottom: 160rpx;
  right: 40rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.fab:active {
  transform: scale(0.93);
}
