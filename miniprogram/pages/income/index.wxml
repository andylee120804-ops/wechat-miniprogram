<view class="income-page" style="background: {{theme.surface || '#1A1A2E'}}; min-height: 100vh; padding-bottom: 120rpx;">
  <!-- Custom Navigation Bar -->
  <view class="nav-bar" style="background: {{theme.gradientHeader || theme.surfaceColor}}; padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar-content">
      <view class="nav-back"></view>
      <text class="nav-title" style="color: {{theme.textPrimary || '#F5F0E8'}};">收入管理</text>
      <view class="nav-action"></view>
    </view>
  </view>

  <!-- Header with month nav -->
  <view class="month-header" style="padding-top: {{statusBarHeight + 44}}px;">
    <view class="month-nav">
      <view class="nav-arrow" bindtap="onPrevMonth">❮</view>
      <text class="month-label" style="color: {{theme.textPrimary || '#F0F0F5'}};">{{currentMonth}}</text>
      <view class="nav-arrow {{monthOffset >= 0 ? 'nav-arrow-disabled' : ''}}" bindtap="onNextMonth">❯</view>
    </view>
  </view>

  <!-- Filters -->
  <view class="filter-bar" style="padding: 16rpx 32rpx; background: {{theme.surface || '#1A1A2E'}};">
    <filter-chips theme="{{theme}}" items="{{typeOptions}}" activeId="{{activeType}}" bind:change="onTypeChange" />
  </view>

  <view style="padding: 0 32rpx;">
    <search-bar theme="{{theme}}" placeholder="搜索来源/备注" value="{{searchKeyword}}" bind:search="onSearch" />
  </view>

  <!-- Summary Card -->
  <view class="summary-card" style="background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border: 1rpx solid {{theme.border || 'rgba(255,255,255,0.06)'}}; border-radius: 24rpx; margin: 24rpx 32rpx; padding: 28rpx 32rpx;">
    <text class="summary-label" style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 26rpx;">本月收入</text>
    <text class="summary-amount" style="color: {{theme.amountPositive || '#4ADE80'}}; font-size: 52rpx; font-weight: 800; font-family: 'DIN Alternate', 'SF Mono', monospace; margin-top: 8rpx;">¥{{totalAmount}}</text>
    <text class="summary-count" style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 24rpx; margin-top: 8rpx;">{{filteredIncomes.length}} 条记录</text>
  </view>

  <!-- Skeleton -->
  <skeleton wx:if="{{loading}}" theme="{{theme}}" type="list" count="3" />

  <!-- Income List -->
  <view class="income-list" wx:else>
    <view class="income-item stagger-item" wx:for="{{filteredIncomes}}" wx:key="_id" bindtap="onItemTap" data-id="{{item._id}}" style="background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border: 1rpx solid {{theme.border || 'rgba(255,255,255,0.06)'}}; border-radius: 24rpx; margin: 0 32rpx 16rpx; padding: 24rpx;">
      <view class="item-header">
        <theme-badge theme="{{theme}}" status="{{item.type}}" type="status" text="{{item.typeText}}" />
        <text class="item-amount" style="color: {{theme.amountPositive || '#4ADE80'}}; font-size: 36rpx; font-weight: 700; font-family: 'DIN Alternate', monospace;">+¥{{item.amountText}}</text>
      </view>
      <view class="item-meta" style="margin-top: 12rpx;">
        <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 26rpx;">{{item.source || '无来源'}} · {{item.dateText}}</text>
        <text wx:if="{{item.reservationId}}" style="color: {{theme.accentColor || '#C9A96E'}}; font-size: 22rpx; margin-left: 12rpx;">📅 已关联</text>
      </view>
      <view class="item-remark" wx:if="{{item.remark}}" style="margin-top: 8rpx;">
        <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 24rpx;">{{item.remark}}</text>
      </view>
    </view>

    <empty-state wx:if="{{filteredIncomes.length === 0}}" theme="{{theme}}" type="no-income" title="暂无收入记录" description="点击底部按钮记录第一笔收入" />
  </view>

  <!-- FAB -->
  <view class="fab" bindtap="onAddIncome" style="background: {{theme.buttonGradient || 'linear-gradient(135deg, #C9A96E, #E8D5A8)'}}; box-shadow: {{theme.shadowLg || '0 8rpx 32rpx rgba(201,169,110,0.3)'}};">
    <text style="color: {{theme.textInverse || '#0F0F1A'}}; font-size: 48rpx; font-weight: 300; line-height: 1;">+</text>
  </view>
</view>
