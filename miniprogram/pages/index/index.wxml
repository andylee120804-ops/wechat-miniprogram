<view class="home-page" style="background: {{theme.surface || '#1A1A2E'}};">

  <!-- Loading skeleton -->
  <skeleton wx:if="{{loading}}" theme="{{theme}}" type="home" />

  <block wx:else>

    <!-- Custom Navigation Bar -->
    <view class="nav-bar" style="background: {{theme.gradientHeader || theme.surfaceColor}}; padding-top: {{statusBarHeight}}px; height: {{statusBarHeight + 44}}px; box-sizing: border-box;">
      <view class="nav-bar-content" style="height: 80rpx; display: flex; box-sizing: border-box">
        <view class="nav-back"></view>
        <text class="nav-title" style="color: {{theme.textPrimary || '#F5F0E8'}};">❤️ {{venueName || '我们的小食堂'}} ❤️</text>
        <view class="nav-action"></view>
      </view>
    </view>

    <!-- Main Content -->
    <view class="home-content" style="padding-top: {{statusBarHeight + 44}}px;">

      <!-- Announcement Marquee -->
      <view class="announcement-marquee" bindtap="onAnnouncementTap" bindtouchstart="onMarqueeTouchStart" bindtouchend="onMarqueeTouchEnd">
        <view class="marquee-icon">{{announcementEmoji}}</view>
        <view class="marquee-content">
          <view wx:if="{{announcements.length > 0 && !marqueeReset}}" class="marquee-text-wrap" style="animation: marquee-scroll 15s ease-out both;">{{currentAnnouncement.title}}</view>
          <view wx:elif="{{announcements.length === 0}}" class="marquee-text-wrap" style="color: {{theme.textMuted || '#5C5C72'}};">暂无公告</view>
        </view>
        <view class="marquee-arrow">›</view>
      </view>

      <!-- Block 1: 今日预约 (Hero Section) -->
      <view class="section-block section-today">
        <view class="section-header">
          <text class="section-title" style="color: {{theme.accentColor || '#C9A96E'}};">今日预约</text>
          <text class="section-badge">{{lunchReservations.length + dinnerReservations.length}} 组</text>
        </view>

        <!-- Lunch -->
        <view class="time-section" wx:if="{{lunchReservations.length > 0 || dinnerReservations.length > 0}}">
          <view class="time-label">
            <text class="time-label-icon">🍽</text>
            <text class="time-label-text lunch">午餐</text>
          </view>
          <view wx:for="{{lunchReservations}}" wx:key="_id" class="res-card" bindtap="onReservationTap" data-id="{{item._id}}">
            <view class="res-card-main">
              <view class="res-card-left">
                <text class="res-card-room" style="color: {{theme.accentColor || '#C9A96E'}};">{{item.roomName || (item.room === 'big' ? '大包厢' : '小包厢')}}</text>
                <text class="res-card-price" style="color: {{theme.textMuted || '#5C5C72'}};">{{item.dishPrice > 0 ? '菜价¥' + item.dishPrice : '¥' + (item.standard || 300) + '/人'}}</text>
              </view>
              <text class="res-card-customer" style="color: {{theme.textPrimary || '#F0F0F5'}};">{{item.customerName}}</text>
            </view>
            <view class="res-card-meta">
              <text class="res-card-guests" style="color: {{theme.textMuted || '#5C5C72'}};">{{item.guestCount}}人</text>
            </view>
            <view wx:if="{{item.remark}}" class="res-card-remark" style="color: {{theme.textMuted || '#5C5C72'}};">📝 {{item.remark}}</view>
          </view>
        </view>

        <!-- Dinner -->
        <view class="time-section" wx:if="{{dinnerReservations.length > 0}}">
          <view class="time-label">
            <text class="time-label-icon">🌙</text>
            <text class="time-label-text dinner">晚餐</text>
          </view>
          <view wx:for="{{dinnerReservations}}" wx:key="_id" class="res-card" bindtap="onReservationTap" data-id="{{item._id}}">
            <view class="res-card-main">
              <view class="res-card-left">
                <text class="res-card-room" style="color: {{theme.accentColor || '#C9A96E'}};">{{item.roomName || (item.room === 'big' ? '大包厢' : '小包厢')}}</text>
                <text class="res-card-price" style="color: {{theme.textMuted || '#5C5C72'}};">{{item.dishPrice > 0 ? '菜价¥' + item.dishPrice : '¥' + (item.standard || 300) + '/人'}}</text>
              </view>
              <text class="res-card-customer" style="color: {{theme.textPrimary || '#F0F0F5'}};">{{item.customerName}}</text>
            </view>
            <view class="res-card-meta">
              <text class="res-card-guests" style="color: {{theme.textMuted || '#5C5C72'}};">{{item.guestCount}}人</text>
            </view>
            <view wx:if="{{item.remark}}" class="res-card-remark" style="color: {{theme.textMuted || '#5C5C72'}};">📝 {{item.remark}}</view>
          </view>
        </view>

        <!-- Empty state -->
        <view wx:if="{{lunchReservations.length === 0 && dinnerReservations.length === 0}}" class="empty-state">
          <text class="empty-state-text" style="color: {{theme.textMuted || '#5C5C72'}};">今日暂无预约</text>
        </view>
      </view>

      <!-- Block 2: 明日预约 -->
      <view class="section-block section-tomorrow">
        <view class="section-header">
          <text class="section-title">明日预约</text>
          <text wx:if="{{tomorrowReservations.length > 0}}" class="section-badge" style="background: rgba(255,255,255,0.08); color: {{theme.textSecondary || '#9A9AB0'}};">{{tomorrowReservations.length}} 组</text>
        </view>

        <block wx:if="{{tomorrowReservations.length > 0}}">
          <view wx:for="{{tomorrowPreview}}" wx:key="index" class="tomorrow-item" bindtap="onReservationTap" data-id="{{item._id}}">
            <view>
              <view class="tomorrow-time" style="color: {{theme.textMuted || '#5C5C72'}};">{{item.time === '中午' ? '午餐' : '晚餐'}}</view>
              <view class="tomorrow-customer" style="color: {{theme.textPrimary || '#F0F0F5'}};">{{item.customerName}}</view>
            </view>
            <view class="tomorrow-right">
              <view class="tomorrow-room">{{item.roomName || (item.room === 'big' ? '大包厢' : '小包厢')}}</view>
              <view class="tomorrow-price" style="color: {{theme.textMuted || '#5C5C72'}};">{{item.dishPrice > 0 ? '菜价¥' + item.dishPrice : '¥' + (item.standard || 300) + '/人'}}</view>
            </view>
          </view>
          <view wx:if="{{tomorrowReservations.length > 3}}" class="tomorrow-more">
            还有 {{tomorrowReservations.length - 3}} 组...
          </view>
        </block>
        <view wx:else class="empty-state">
          <text class="empty-state-text" style="color: {{theme.textMuted || '#5C5C72'}};">无</text>
        </view>
      </view>

      <!-- Block 3: 今日收支 (boss only) -->
      <view wx:if="{{showSummary}}" class="section-block section-summary">
        <view class="section-header" style="margin-bottom: 20rpx;">
          <text class="section-title" style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 26rpx;">今日收支</text>
        </view>
        <view class="summary-row">
          <view class="summary-item" bindtap="onIncomeTap">
            <text class="summary-value" style="color: {{theme.statusSuccess || '#4ADE80'}};">¥{{todayIncome}}</text>
            <text class="summary-label" style="color: {{theme.textMuted || '#5C5C72'}};">收入</text>
          </view>
          <view class="summary-divider"></view>
          <view class="summary-item" bindtap="onExpenseTap">
            <text class="summary-value" style="color: {{theme.statusWarning || '#FBBF24'}};">¥{{todayExpense}}</text>
            <text class="summary-label" style="color: {{theme.textMuted || '#5C5C72'}};">支出</text>
          </view>
        </view>
        <view wx:if="{{monthlyFixedCost > 0}}" class="summary-row" style="margin-top: 12rpx;">
          
        </view>
      </view>

      <!-- Block 4: 快捷操作 -->
      <view class="section-block section-actions">
        <view class="section-header" style="margin-bottom: 20rpx;">
          <text class="section-title" style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 26rpx;">快捷操作</text>
        </view>
        <view class="actions-grid">
          <view wx:if="{{canAddReservation}}" class="action-item reservation" bindtap="onAddReservation">
            <view class="action-icon-wrap">
              <text class="action-icon">📅</text>
            </view>
            <text class="action-text">新增预约</text>
            <text class="action-sub">快速记录</text>
          </view>
          <view wx:if="{{canAddPurchase}}" class="action-item purchase" bindtap="onAddPurchase">
            <view class="action-icon-wrap">
              <text class="action-icon">🛒</text>
            </view>
            <text class="action-text">采购登记</text>
            <text class="action-sub">物品支出</text>
          </view>
          <view wx:if="{{canAddIncome}}" class="action-item income" bindtap="onAddIncome">
            <view class="action-icon-wrap">
              <text class="action-icon">💰</text>
            </view>
            <text class="action-text">收入记录</text>
            <text class="action-sub">快速记账</text>
          </view>
        </view>
      </view>

      <!-- Block 5: 待办 -->
      <view wx:if="{{showTodo && (pendingApprovalCount > 0 || pendingReimburseCount > 0)}}" class="section-block section-todo" bindtap="onTodoTap">
        <view class="section-header">
          <text class="section-title" style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 26rpx;">📋 待办</text>
        </view>
        <view class="todo-card" style="background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}}; border-radius: 16rpx;">
          <view class="todo-row" wx:if="{{pendingApprovalCount > 0}}" style="padding: 32rpx; display: flex; align-items: center; gap: 24rpx; border-bottom: 1rpx solid {{theme.dividerColor || 'rgba(255,255,255,0.06)'}};">
            <text style="font-size: 40rpx;">🟡</text>
            <text style="flex:1; color: {{theme.textPrimary || '#F5F0E8'}}; font-size: 30rpx;">待审批</text>
            <view style="background: rgba(251,191,36,0.15); padding: 4rpx 20rpx; border-radius: 99rpx;"><text style="color: #FBBF24; font-size: 24rpx; font-weight: 700;">{{pendingApprovalCount}}</text></view>
            <text style="color: {{theme.textMuted || 'rgba(245,240,232,0.4)'}}; font-size: 40rpx;">›</text>
          </view>
          <view class="todo-row" wx:if="{{pendingReimburseCount > 0}}" style="padding: 32rpx; display: flex; align-items: center; gap: 24rpx;">
            <text style="font-size: 40rpx;">💰</text>
            <text style="flex:1; color: {{theme.textPrimary || '#F5F0E8'}}; font-size: 30rpx;">待报销</text>
            <view style="background: rgba(74,222,128,0.15); padding: 4rpx 20rpx; border-radius: 99rpx;"><text style="color: #4ADE80; font-size: 24rpx; font-weight: 700;">{{pendingReimburseCount}}</text></view>
            <text style="color: {{theme.textMuted || 'rgba(245,240,232,0.4)'}}; font-size: 40rpx;">›</text>
          </view>
        </view>
      </view>

    </view>

    <!-- Bottom spacing -->
    <view class="tab-bar-safe-bottom"></view>

  </block>
</view>