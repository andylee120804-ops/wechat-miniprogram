@import '../../styles/mixins.wxss';

.mypage {
  min-height: 100vh;
}

/* Navigation Bar */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-bar-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 40rpx;
  font-weight: 300;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
}

.nav-action {
  min-width: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

/* Status Card */
.cards-row {
  box-sizing: border-box;
}

.status-card:active {
  opacity: 0.7;
  transform: scale(0.97);
}

/* Purchase Item */
.purchase-item:active {
  opacity: 0.7;
}

/* Section Label */
.section-label {
  text-transform: uppercase;
  letter-spacing: 2rpx;
}
