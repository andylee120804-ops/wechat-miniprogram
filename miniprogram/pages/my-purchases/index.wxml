<view class="mypage" style="background: {{theme.surfaceColor || '#1A1A2E'}}; min-height: 100vh; padding-top: {{statusBarHeight + 44}}px;">
  <!-- Custom Navigation Bar -->
  <view class="nav-bar" style="background: {{theme.gradientHeader || theme.surfaceColor}}; padding-top: {{statusBarHeight}}px; height: {{statusBarHeight + 44}}px; box-sizing: border-box;">
    <view class="nav-bar-content">
      <view class="nav-back" bindtap="onBack">
        <text class="nav-back-icon" style="color: {{theme.textPrimary || '#F5F0E8'}};">❮</text>
      </view>
      <text class="nav-title" style="color: {{theme.textPrimary || '#F5F0E8'}};">我的采购</text>
      <view class="nav-action"></view>
    </view>
  </view>

  <!-- Skeleton Loading -->
  <view wx:if="{{loading}}" style="padding: 16rpx 24rpx;">
    <!-- Status cards skeleton — single row -->
    <view style="display: flex; gap: 10rpx; margin-bottom: 16rpx;">
      <view wx:for="{{[1,2,3,4,5]}}" wx:key="*this"
        style="flex:1; background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border-radius: 14rpx; height: 80rpx; opacity: 0.5;"></view>
    </view>
    <!-- List skeleton -->
    <view wx:for="{{[1,2,3]}}" wx:key="*this"
      style="background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border-radius: 20rpx; padding: 24rpx 28rpx; margin-bottom: 12rpx; opacity: 0.5;">
      <view style="height: 32rpx; width: 60%; background: {{theme.border || 'rgba(255,255,255,0.06)'}}; border-radius: 8rpx; margin-bottom: 12rpx;"></view>
      <view style="height: 24rpx; width: 40%; background: {{theme.border || 'rgba(255,255,255,0.06)'}}; border-radius: 8rpx; margin-bottom: 8rpx;"></view>
      <view style="height: 24rpx; width: 30%; background: {{theme.border || 'rgba(255,255,255,0.06)'}}; border-radius: 8rpx;"></view>
    </view>
  </view>

  <!-- Content -->
  <block wx:else>
    <!-- No Records Empty State -->
    <view wx:if="{{!hasRecords}}" style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding-top: 200rpx;">
      <text style="font-size: 80rpx;">📦</text>
      <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 30rpx; margin-top: 24rpx;">没有申请记录</text>
    </view>

    <view wx:else style="padding: 16rpx 24rpx 8rpx;">
      <!-- Status Cards Row — sorted by current-month count -->
      <view style="display: flex; gap: 10rpx; margin-bottom: 16rpx;">
        <view
          wx:for="{{statusCards}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onCardTap"
          style="flex:1; background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border: 2rpx solid {{activeStatus === item.key ? item.color : (theme.borderColor || 'rgba(255,255,255,0.08)')}}; border-radius: 14rpx; padding: 12rpx 6rpx; display: flex; flex-direction: column; align-items: center; min-width: 0;">
          <text style="color: {{activeStatus === item.key ? item.color : (theme.textMuted || '#9A9AB0')}}; font-size: 22rpx;">{{item.label}}</text>
          <text style="color: {{activeStatus === item.key ? item.color : (theme.textPrimary || '#F5F0E8')}}; font-size: 32rpx; font-weight: 700; margin-top: 2rpx;">{{item.count}}</text>
        </view>
      </view>

      <!-- Section Label -->
      <text style="color: {{theme.textMuted || 'rgba(245,240,232,0.40)'}}; font-size: 24rpx; font-weight: 500; display: block; margin-bottom: 12rpx; padding-left: 4rpx;">{{sectionLabel}}</text>

      <!-- Purchase List -->
      <view class="purchase-list">
        <view
          wx:for="{{filteredList}}"
          wx:key="_id"
          class="purchase-item"
          bindtap="onItemTap"
          data-id="{{item._id}}"
          style="background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.06)'}}; border-radius: 20rpx; padding: 20rpx 24rpx; margin-bottom: 10rpx;"
        >
          <view style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10rpx;">
            <text style="color: {{theme.textPrimary || '#F5F0E8'}}; font-size: 30rpx; font-weight: 600; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{item.item}}</text>
            <text style="color: {{theme.amountNegative || '#F87171'}}; font-size: 30rpx; font-weight: 700; margin-left: 16rpx; flex-shrink: 0;">-¥{{item.amount}}</text>
          </view>
          <view style="display: flex; align-items: center; justify-content: space-between;">
            <view style="display: flex; align-items: center; gap: 12rpx;">
              <view style="background: {{theme.elevated || '#252540'}}; border-radius: 8rpx; padding: 4rpx 14rpx;">
                <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 23rpx;">{{item.categoryName}}</text>
              </view>
              <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 23rpx;">· {{item.formattedDate}}</text>
            </view>
          </view>
        </view>

        <!-- Filtered Empty State -->
        <view wx:if="{{filteredList.length === 0 && hasRecords}}" style="display: flex; flex-direction: column; align-items: center; padding-top: 120rpx;">
          <text style="font-size: 60rpx;">🔍</text>
          <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 28rpx; margin-top: 16rpx;">暂无此类状态的采购记录</text>
        </view>
      </view>
    </view>
  </block>
</view>
