<view class="page" style="background: {{theme.surfaceColor || '#1A1A2E'}}; min-height: 100vh;">
  <!-- Custom Navigation Bar -->
  <view class="nav-bar" style="background: {{theme.gradientHeader || theme.surfaceColor || '#1A1A2E'}}; padding-top: {{statusBarHeight}}px; height: {{statusBarHeight + 44}}px; box-sizing: border-box;">
    <view class="nav-bar-content">
      <view class="nav-back" bindtap="onBack">
        <text class="nav-back-icon" style="color: {{theme.textPrimary || '#F5F0E8'}}">❮</text>
      </view>
      <text class="nav-title" style="color: {{theme.textPrimary || '#F5F0E8'}};">{{isEdit ? '编辑预约' : '新增预约'}}</text>
      <view class="nav-action"></view>
    </view>
  </view>
  <scroll-view scroll-y class="form-scroll" style="padding-top: {{statusBarHeight + 44}}px;">
    <!-- Section 1: Date & Time -->
    <theme-card theme="{{theme}}">
      <view class="section-title" style="color: {{theme.textPrimary || '#F5F0E8'}};">日期与时间</view>

      <theme-form-item theme="{{theme}}" label="日期" required="{{true}}" error="{{errors.date || ''}}">
        <picker mode="date" value="{{date}}" bindchange="onDateChange">
          <view class="picker-value" style="color: {{date ? (theme.textPrimary || '#F5F0E8') : (theme.textMuted || 'rgba(245,240,232,0.40)')}};">
            {{date || '请选择日期'}}
          </view>
        </picker>
      </theme-form-item>

      <view class="form-item-custom">
        <text class="form-label" style="color: {{theme.textSecondary || 'rgba(245,240,232,0.65)'}};">时段</text>
        <view class="pill-selector">
          <view
            class="pill {{time === item ? 'pill-active' : ''}}"
            wx:for="{{timeOptions}}"
            wx:key="*this"
            data-value="{{item}}"
            bindtap="selectTime"
            style="{{time === item ? 'background:' + (theme.accentColor || '#C9A96E') + ';color:' + (theme.textInverse || '#0F0F1A') + ';' : 'background:' + (theme.glassBg || 'rgba(255,255,255,0.06)') + ';color:' + (theme.textSecondary || 'rgba(245,240,232,0.65)') + ';'}}"
          >
            {{item}}
          </view>
        </view>
      </view>
    </theme-card>

    <!-- Section 2: Room -->
    <theme-card theme="{{theme}}">
      <view class="section-title" style="color: {{theme.textPrimary || '#F5F0E8'}};">包厢</view>

      <view class="pill-selector">
        <view
          class="pill {{room === item.value ? 'pill-active' : ''}}"
          wx:for="{{roomOptions}}"
          wx:key="value"
          data-value="{{item.value}}"
          bindtap="selectRoom"
          style="{{room === item.value ? 'background:' + (theme.accentColor || '#C9A96E') + ';color:' + (theme.textInverse || '#0F0F1A') + ';' : 'background:' + (theme.glassBg || 'rgba(255,255,255,0.06)') + ';color:' + (theme.textSecondary || 'rgba(245,240,232,0.65)') + ';'}}"
        >
          {{item.label}}
        </view>
      </view>
      <text class="error-text" wx:if="{{errors.room}}" style="color: {{theme.statusDanger || '#F87171'}};">{{errors.room}}</text>
    </theme-card>

    <!-- Section 3: Exclusive -->
    <theme-card theme="{{theme}}">
      <view class="section-title" style="color: {{theme.textPrimary || '#F5F0E8'}};">包场</view>

      <view class="pill-selector">
        <view class="pill {{exclusiveType === 'none' ? 'pill-active' : ''}}"
              data-value="none" bindtap="selectExclusive"
              style="{{exclusiveType === 'none' ? 'background:' + (theme.accentColor || '#C9A96E') + ';color:' + (theme.textInverse || '#0F0F1A') + ';' : 'background:' + (theme.glassBg || 'rgba(255,255,255,0.06)') + ';color:' + (theme.textSecondary || 'rgba(245,240,232,0.65)') + ';'}}">不包场</view>
        <view class="pill {{exclusiveType === 'noon' ? 'pill-active' : ''}}"
              data-value="noon" bindtap="selectExclusive"
              style="{{exclusiveType === 'noon' ? 'background:' + (theme.accentColor || '#C9A96E') + ';color:' + (theme.textInverse || '#0F0F1A') + ';' : 'background:' + (theme.glassBg || 'rgba(255,255,255,0.06)') + ';color:' + (theme.textSecondary || 'rgba(245,240,232,0.65)') + ';'}}">午包场</view>
        <view class="pill {{exclusiveType === 'night' ? 'pill-active' : ''}}"
              data-value="night" bindtap="selectExclusive"
              style="{{exclusiveType === 'night' ? 'background:' + (theme.accentColor || '#C9A96E') + ';color:' + (theme.textInverse || '#0F0F1A') + ';' : 'background:' + (theme.glassBg || 'rgba(255,255,255,0.06)') + ';color:' + (theme.textSecondary || 'rgba(245,240,232,0.65)') + ';'}}">晚包场</view>
        <view class="pill {{exclusiveType === 'full' ? 'pill-active' : ''}}"
              data-value="full" bindtap="selectExclusive"
              style="{{exclusiveType === 'full' ? 'background:' + (theme.accentColor || '#C9A96E') + ';color:' + (theme.textInverse || '#0F0F1A') + ';' : 'background:' + (theme.glassBg || 'rgba(255,255,255,0.06)') + ';color:' + (theme.textSecondary || 'rgba(245,240,232,0.65)') + ';'}}">包场全天</view>
      </view>
    </theme-card>

    <!-- Section 4: Standard -->
    <theme-card theme="{{theme}}">
      <view class="section-title" style="color: {{theme.textPrimary || '#F5F0E8'}};">餐标</view>

      <view class="pill-selector standard-selector">
        <view class="pill {{isPartner ? 'pill-active' : ''}}"
              bindtap="togglePartner"
              style="{{isPartner ? 'background:' + (theme.accentColor || '#C9A96E') + ';color:' + (theme.textInverse || '#0F0F1A') + ';' : 'background:' + (theme.glassBg || 'rgba(255,255,255,0.06)') + ';color:' + (theme.textSecondary || 'rgba(245,240,232,0.65)') + ';'}}">股东</view>
        <view
          class="pill {{standard === item ? 'pill-active' : ''}}"
          wx:for="{{standardOptions}}"
          wx:key="*this"
          data-value="{{item}}"
          bindtap="selectStandard"
          style="{{standard === item ? 'background:' + (theme.accentColor || '#C9A96E') + ';color:' + (theme.textInverse || '#0F0F1A') + ';' : 'background:' + (theme.glassBg || 'rgba(255,255,255,0.06)') + ';color:' + (theme.textSecondary || 'rgba(245,240,232,0.65)') + ';'}}"
        >
          ¥{{item}}/人
        </view>
      </view>
    </theme-card>

    <!-- Section 4: Customer Info -->
    <theme-card theme="{{theme}}">
      <view class="section-title" style="color: {{theme.textPrimary || '#F5F0E8'}};">客户信息</view>

      <theme-form-item theme="{{theme}}" label="客户姓名" required="{{true}}" error="{{errors.customerName || ''}}">
        <input
          class="form-input"
          value="{{customerName}}"
          bindinput="onCustomerNameInput"
          placeholder="请输入客户姓名"
          placeholder-style="color: {{theme.textMuted || 'rgba(245,240,232,0.40)'}};"
          style="color: {{theme.textPrimary || '#F5F0E8'}};"
        />
      </theme-form-item>

      <theme-form-item theme="{{theme}}" label="手机号" required="{{false}}" error="{{errors.phone || ''}}">
        <input
          class="form-input"
          type="number"
          maxlength="11"
          value="{{phone}}"
          bindinput="onPhoneInput"
          placeholder="请输入手机号"
          placeholder-style="color: {{theme.textMuted || 'rgba(245,240,232,0.40)'}};"
          style="color: {{theme.textPrimary || '#F5F0E8'}};"
        />
      </theme-form-item>

      <theme-form-item theme="{{theme}}" label="人数" required="{{true}}" error="{{errors.guestCount || ''}}">
        <input
          class="form-input"
          type="number"
          value="{{guestCount}}"
          bindinput="onGuestCountInput"
          placeholder="请输入用餐人数"
          placeholder-style="color: {{theme.textMuted || 'rgba(245,240,232,0.40)'}};"
          style="color: {{theme.textPrimary || '#F5F0E8'}};"
        />
      </theme-form-item>

      <theme-form-item theme="{{theme}}" label="备注">
        <textarea
          class="form-textarea"
          value="{{remark}}"
          bindinput="onRemarkInput"
          placeholder="备注信息（选填）"
          placeholder-style="color: {{theme.textMuted || 'rgba(245,240,232,0.40)'}};"
          style="color: {{theme.textPrimary || '#F5F0E8'}};"
          auto-height
          maxlength="200"
        />
      </theme-form-item>
    </theme-card>

    <!-- Spacer for bottom bar -->
    <view class="bottom-spacer"></view>
  </scroll-view>

  <!-- Fixed Bottom Bar -->
  <view class="bottom-bar">
    <view class="bottom-bar-inner {{isEdit ? 'two-btns' : 'single-btn'}}">
      <view wx:if="{{isEdit}}" class="bar-btn bar-btn-danger" bindtap="onDelete">删除</view>
      <view class="bar-btn bar-btn-primary bar-btn-primary-wide" bindtap="onSubmit">{{isEdit ? '保存修改' : '创建预约'}}</view>
    </view>
    <view class="safe-bottom-bar"></view>
  </view>

  <!-- Delete Confirmation Modal -->
  <theme-modal
    theme="{{theme}}"
    visible="{{showDeleteModal}}"
    title="确认删除"
    confirmText="删除"
    bind:close="onCloseDeleteModal"
    bind:confirm="onConfirmDelete"
  >
    <text style="color: {{theme.textSecondary || 'rgba(245,240,232,0.65)'}};">删除后将无法恢复，确认删除该预约吗？</text>
  </theme-modal>
</view>