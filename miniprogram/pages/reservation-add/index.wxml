<wxs module="m">
  function isSelected(value, opt) {
    if (!value) return false
    var arr = value.split(',')
    for (var i = 0; i < arr.length; i++) {
      if (arr[i] === opt) return true
    }
    return false
  }
  module.exports = { isSelected: isSelected }
</wxs>
<view class="page" style="background: {{theme.surfaceColor || '#1A1A2E'}}; min-height: 100vh;">
  <!-- Custom Navigation Bar -->
  <view class="nav-bar" style="background: {{theme.gradientHeader || theme.surfaceColor || '#1A1A2E'}}; padding-top: {{statusBarHeight}}px; height: {{statusBarHeight + 44}}px; box-sizing: border-box;">
    <view class="nav-bar-content">
      <view class="nav-back" bindtap="onBack">
        <text class="nav-back-icon" style="color: {{theme.textPrimary || '#F5F0E8'}}">❮</text>
      </view>
      <text class="nav-title" style="color: {{theme.textPrimary || '#F5F0E8'}};">{{isEdit ? '编辑预约' : '新增预约'}}</text>
      <view class="nav-action"></view>
    </view>
  </view>

  <scroll-view scroll-y class="form-scroll" style="padding-top: {{statusBarHeight + 44}}px;">
    <!-- Section: Date & Time -->
    <theme-card theme="{{theme}}">
      <view class="section-title" style="color: {{theme.textPrimary || '#F5F0E8'}};">日期与时间</view>

      <theme-form-item theme="{{theme}}" label="日期" required="{{true}}" error="{{errors.date || ''}}">
        <picker mode="date" value="{{date}}" start="{{todayDate}}" bindchange="onDateChange">
          <view class="picker-value" style="color: {{date ? (theme.textPrimary || '#F5F0E8') : (theme.textMuted || 'rgba(245,240,232,0.40)')}};">
            {{date || '请选择日期'}}
          </view>
        </picker>
      </theme-form-item>

      <view class="form-item-custom">
        <text class="form-label" style="color: {{theme.textSecondary || 'rgba(245,240,232,0.65)'}};">时段</text>
        <view class="pill-selector">
          <view wx:for="{{timeOptions}}" wx:key="*this"
            class="pill {{time === item ? 'pill-active' : ''}}"
            data-value="{{item}}" bindtap="selectTime"
            style="{{time === item ? 'background:' + (theme.accentColor || '#C9A96E') + ';color:' + (theme.textInverse || '#0F0F1A') + ';' : 'background:' + (theme.glassBg || 'rgba(255,255,255,0.06)') + ';color:' + (theme.textSecondary || 'rgba(245,240,232,0.65)') + ';'}}"
          >{{item}}</view>
        </view>
      </view>
    </theme-card>

    <!-- Section: Room (dynamic from config) -->
    <theme-card theme="{{theme}}">
      <view class="section-title" style="color: {{theme.textPrimary || '#F5F0E8'}};">包厢</view>
      <view class="pill-selector">
        <view wx:for="{{roomOptions}}" wx:key="id"
          class="pill {{room === item.id ? 'pill-active' : ''}}"
          data-value="{{item.id}}" bindtap="selectRoom"
          style="{{room === item.id ? 'background:' + (theme.accentColor || '#C9A96E') + ';color:' + (theme.textInverse || '#0F0F1A') + ';' : 'background:' + (theme.glassBg || 'rgba(255,255,255,0.06)') + ';color:' + (theme.textSecondary || 'rgba(245,240,232,0.65)') + ';'}}"
        >{{item.name}}</view>
      </view>
      <text class="error-text" wx:if="{{errors.room}}" style="color: {{theme.statusDanger || '#F87171'}};">{{errors.room}}</text>
    </theme-card>

    <!-- Section: Exclusive (dynamic from currentRoomConfig.exclusiveTypes) -->
    <theme-card theme="{{theme}}" wx:if="{{exclusiveOptions.length > 1 || (exclusiveOptions.length === 1 && exclusiveOptions[0] !== 'none')}}">
      <view class="section-title" style="color: {{theme.textPrimary || '#F5F0E8'}};">包场</view>
      <view class="pill-selector">
        <view wx:for="{{exclusiveOptions}}" wx:key="*this"
          class="pill {{exclusiveType === item ? 'pill-active' : ''}}"
          data-value="{{item}}" bindtap="selectExclusive"
          style="{{exclusiveType === item ? 'background:' + (theme.accentColor || '#C9A96E') + ';color:' + (theme.textInverse || '#0F0F1A') + ';' : 'background:' + (theme.glassBg || 'rgba(255,255,255,0.06)') + ';color:' + (theme.textSecondary || 'rgba(245,240,232,0.65)') + ';'}}"
        >{{item === 'none' ? '不包场' : item === 'noon' ? '午包场' : item === 'night' ? '晚包场' : '包场全天'}}</view>
      </view>
    </theme-card>

    <!-- Section: Standard (dynamic from currentRoomConfig.standards) -->
    <theme-card theme="{{theme}}" wx:if="{{standardOptions.length > 0}}">
      <view class="section-title" style="color: {{theme.textPrimary || '#F5F0E8'}};">餐标<text wx:if="{{!allowNoStandard}}" style="color: #FF6B6B; margin-left: 4rpx;">*</text></view>
      <view class="pill-selector standard-selector">
        <view class="pill {{isPartner ? 'pill-active' : ''}}" bindtap="togglePartner"
          style="{{isPartner ? 'background:' + (theme.accentColor || '#C9A96E') + ';color:' + (theme.textInverse || '#0F0F1A') + ';' : 'background:' + (theme.glassBg || 'rgba(255,255,255,0.06)') + ';color:' + (theme.textSecondary || 'rgba(245,240,232,0.65)') + ';'}}">股东</view>
        <view wx:for="{{standardOptions}}" wx:key="*this"
          class="pill {{standard === item ? 'pill-active' : ''}}"
          data-value="{{item}}" bindtap="selectStandard"
          style="{{standard === item ? 'background:' + (theme.accentColor || '#C9A96E') + ';color:' + (theme.textInverse || '#0F0F1A') + ';' : 'background:' + (theme.glassBg || 'rgba(255,255,255,0.06)') + ';color:' + (theme.textSecondary || 'rgba(245,240,232,0.65)') + ';'}}"
        >¥{{item}}/人</view>
      </view>
      <view wx:if="{{errors.standard}}" class="mt-sm" style="background: rgba(255,107,107,0.15); border: 2rpx solid #FF6B6B; border-radius: 12rpx; padding: 16rpx 20rpx;">
        <text style="color: #FF6B6B; font-size: 26rpx; font-weight: 500;">{{errors.standard}}</text>
      </view>
    </theme-card>

    <!-- Section: Customer Info (dynamic form fields) -->
    <theme-card theme="{{theme}}">
      <view class="section-title" style="color: {{theme.textPrimary || '#F5F0E8'}};">客户信息</view>

      <block wx:for="{{formFields}}" wx:key="id">
        <!-- customerName: partner mode uses boss picker -->
        <block wx:if="{{item.id === 'customerName'}}">
          <theme-form-item theme="{{theme}}" label="{{item.label}}" required="{{!isPartner}}" error="{{errors.customerName || ''}}">
            <view class="form-input-wrap">
              <block wx:if="{{isPartner && bossList.length > 0}}">
                <view class="form-input view-mode" bindtap="onBossPickerTap" style="color: {{selectedBossIndex >= 0 ? (theme.textPrimary || '#F5F0E8') : (theme.textMuted || 'rgba(245,240,232,0.40)')}};">
                  {{selectedBossIndex >= 0 ? bossList[selectedBossIndex].name : '请选择股东'}}
                </view>
              </block>
              <block wx:else>
                <input class="form-input" value="{{formData.customerName}}" data-fieldid="customerName" bindinput="onFieldInput"
                  placeholder="请输入客户姓名"
                  placeholder-style="color: {{theme.textMuted || 'rgba(245,240,232,0.40)'}}; font-size: 28rpx;"
                  style="color: {{theme.textPrimary || '#F5F0E8'}};" />
              </block>
            </view>
            <!-- Customer presets: quick-fill buttons (outside fixed-height wrap) -->
            <view wx:if="{{!isPartner && customerPresets.length > 0}}" class="customer-preset-row">
              <view class="customer-preset-label" style="color: {{theme.textMuted || 'rgba(245,240,232,0.40)'}};">常用：</view>
              <view class="customer-preset-pills">
                <view wx:for="{{customerPresets}}" wx:for-item="preset" wx:key="*this"
                  class="customer-preset-pill {{formData.customerName === preset ? 'preset-pill-active' : ''}}"
                  data-name="{{preset}}" bindtap="onPickPresetCustomer"
                  style="{{formData.customerName === preset ? 'background:' + (theme.accentColor || '#C9A96E') + ';color:' + (theme.textInverse || '#0F0F1A') + ';' : 'background:' + (theme.glassBg || 'rgba(255,255,255,0.06)') + ';color:' + (theme.textSecondary || 'rgba(245,240,232,0.65)') + ';'}}"
                >{{preset}}</view>
              </view>
            </view>
          </theme-form-item>
        </block>

        <!-- dishPrice: conditional required -->
        <block wx:elif="{{item.id === 'dishPrice'}}">
          <theme-form-item theme="{{theme}}" label="{{item.label}}" required="{{_dishPriceRequired}}">
            <input class="form-input" type="digit" value="{{formData.dishPrice}}" data-fieldid="dishPrice" bindinput="onFieldInput"
              placeholder="{{_dishPriceRequired ? '请输入菜价总额' : '请输入菜价总额（选填）'}}"
              placeholder-style="color: {{theme.textMuted || 'rgba(245,240,232,0.40)'}}; font-size: 28rpx;"
              style="color: {{theme.textPrimary || '#F5F0E8'}};" />
            <view wx:if="{{errors.dishPrice}}" class="mt-sm" style="background: rgba(255,107,107,0.15); border: 2rpx solid #FF6B6B; border-radius: 12rpx; padding: 16rpx 20rpx;">
              <text style="color: #FF6B6B; font-size: 26rpx; font-weight: 500;">{{errors.dishPrice}}</text>
            </view>
          </theme-form-item>
        </block>

        <!-- guestCount: number with special validation -->
        <block wx:elif="{{item.id === 'guestCount'}}">
          <theme-form-item theme="{{theme}}" label="{{item.label}}" required="{{item.required}}" error="{{errors.guestCount || ''}}">
            <input class="form-input" type="number" value="{{formData.guestCount}}" data-fieldid="guestCount" bindinput="onFieldInput"
              placeholder="请输入用餐人数"
              placeholder-style="color: {{theme.textMuted || 'rgba(245,240,232,0.40)'}};"
              style="color: {{theme.textPrimary || '#F5F0E8'}};" />
          </theme-form-item>
        </block>

        <!-- phone: number with format validation -->
        <block wx:elif="{{item.id === 'phone'}}">
          <theme-form-item theme="{{theme}}" label="{{item.label}}" required="{{item.required}}" error="{{errors.phone || ''}}">
            <input class="form-input" type="number" maxlength="11" value="{{formData.phone}}" data-fieldid="phone" bindinput="onFieldInput"
              placeholder="请输入手机号"
              placeholder-style="color: {{theme.textMuted || 'rgba(245,240,232,0.40)'}};"
              style="color: {{theme.textPrimary || '#F5F0E8'}};" />
          </theme-form-item>
        </block>

        <!-- remark: textarea -->
        <block wx:elif="{{item.type === 'textarea'}}">
          <theme-form-item theme="{{theme}}" label="{{item.label}}" required="{{item.required}}">
            <textarea class="form-textarea" value="{{formData[item.id]}}" data-fieldid="{{item.id}}" bindinput="onFieldInput"
              placeholder="{{item.label}}（选填）"
              placeholder-style="color: {{theme.textMuted || 'rgba(245,240,232,0.40)'}};"
              style="color: {{theme.textPrimary || '#F5F0E8'}};" auto-height maxlength="200" />
          </theme-form-item>
        </block>

        <!-- select: multi-select pills + input for new option -->
        <block wx:elif="{{item.type === 'select'}}">
          <theme-form-item theme="{{theme}}" label="{{item.label}}" required="{{item.required}}" error="{{errors[item.id] || ''}}">
            <view class="select-field">
              <view class="pill-selector" wx:if="{{item.options && item.options.length > 0}}">
                <view wx:for="{{item.options}}" wx:for-item="opt" wx:key="*this"
                  class="pill {{m.isSelected(formData[item.id], opt) ? 'pill-active' : ''}}"
                  data-fieldid="{{item.id}}" data-option="{{opt}}" bindtap="onSelectOptionToggle"
                  style="{{m.isSelected(formData[item.id], opt) ? 'background:' + (theme.accentColor || '#C9A96E') + ';color:' + (theme.textInverse || '#0F0F1A') + ';' : 'background:' + (theme.glassBg || 'rgba(255,255,255,0.06)') + ';color:' + (theme.textSecondary || 'rgba(245,240,232,0.65)') + ';'}}"
                >{{opt}}</view>
              </view>
              <input class="form-input" data-fieldid="{{item.id}}" bindconfirm="onSelectOptionAdd"
                placeholder="输入新选项后回车"
                placeholder-style="color: {{theme.textMuted || 'rgba(245,240,232,0.40)'}}; font-size: 24rpx;"
                style="color: {{theme.textPrimary || '#F5F0E8'}}; margin-top: 12rpx; font-size: 24rpx;" />
            </view>
          </theme-form-item>
        </block>

        <!-- number (generic custom) -->
        <block wx:elif="{{item.type === 'number'}}">
          <theme-form-item theme="{{theme}}" label="{{item.label}}" required="{{item.required}}" error="{{errors[item.id] || ''}}">
            <input class="form-input" type="digit" value="{{formData[item.id]}}" data-fieldid="{{item.id}}" bindinput="onFieldInput"
              placeholder="请输入{{item.label}}"
              placeholder-style="color: {{theme.textMuted || 'rgba(245,240,232,0.40)'}};"
              style="color: {{theme.textPrimary || '#F5F0E8'}};" />
          </theme-form-item>
        </block>

        <!-- text (generic custom) -->
        <block wx:else>
          <theme-form-item theme="{{theme}}" label="{{item.label}}" required="{{item.required}}" error="{{errors[item.id] || ''}}">
            <input class="form-input" value="{{formData[item.id]}}" data-fieldid="{{item.id}}" bindinput="onFieldInput"
              placeholder="请输入{{item.label}}"
              placeholder-style="color: {{theme.textMuted || 'rgba(245,240,232,0.40)'}}; font-size: 28rpx;"
              style="color: {{theme.textPrimary || '#F5F0E8'}};" />
          </theme-form-item>
        </block>
      </block>
    </theme-card>

    <!-- Spacer for bottom bar -->
    <view class="bottom-spacer"></view>
  </scroll-view>

  <!-- Fixed Bottom Bar -->
  <view class="bottom-bar">
    <view class="bottom-bar-inner {{isEdit ? 'two-btns' : 'single-btn'}}">
      <view wx:if="{{isEdit}}" class="bar-btn bar-btn-danger" bindtap="onDelete">删除</view>
      <view class="bar-btn bar-btn-primary bar-btn-primary-wide" bindtap="onSubmit">{{isEdit ? '保存修改' : '创建预约'}}</view>
    </view>
    <view class="safe-bottom-bar"></view>
  </view>

  <!-- Boss Picker Modal -->
  <theme-modal theme="{{theme}}" visible="{{showBossPicker}}" title="选择股东" showFooter="{{false}}" bind:close="onBossPickerClose">
    <view class="boss-picker-list">
      <view wx:for="{{bossList}}" wx:key="index" class="boss-picker-item"
        data-index="{{index}}" bindtap="onBossSelect"
        style="color: {{theme.textPrimary || '#F5F0E8'}}; border-bottom: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.06)'}};">
        <text class="boss-picker-name">{{item.name}}</text>
      </view>
    </view>
  </theme-modal>

  <!-- Delete Confirmation Modal -->
  <theme-modal theme="{{theme}}" visible="{{showDeleteModal}}" title="确认删除" confirmText="删除" bind:close="onCloseDeleteModal" bind:confirm="onConfirmDelete">
    <text style="color: {{theme.textSecondary || 'rgba(245,240,232,0.65)'}};">删除后将无法恢复，确认删除该预约吗？</text>
  </theme-modal>
</view>
