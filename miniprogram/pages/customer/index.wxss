@import '../../styles/mixins.wxss';

.customer-page {
  min-height: 100vh;
}

/* Navigation Bar */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-bar-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 44rpx;
  font-weight: 300;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
}

.nav-action {
  min-width: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.sort-bar {
  display: flex;
  gap: 12rpx;
}

.sort-pill {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.customer-item {
  transition: transform 0.15s ease;
}

.customer-item:active {
  transform: scale(0.98);
}

.customer-header {
  display: flex;
  align-items: center;
}

.customer-stats {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
