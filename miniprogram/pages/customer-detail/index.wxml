<view class="customer-detail-page" style="background: {{theme.surface || '#1A1A2E'}}; min-height: 100vh; padding-bottom: 32rpx; padding-top: {{statusBarHeight + 44}}px;">
  <!-- Custom Navigation Bar -->
  <view class="nav-bar" style="background: {{theme.gradientHeader || theme.surfaceColor}}; padding-top: {{statusBarHeight}}px; height: {{statusBarHeight + 44}}px; box-sizing: border-box;">
    <view class="nav-bar-content">
      <view class="nav-back" bindtap="onBack">
        <text class="nav-back-icon" style="color: {{theme.textPrimary || '#F5F0E8'}}">❮</text>
      </view>
      <text class="nav-title" style="color: {{theme.textPrimary || '#F5F0E8'}};">客户详情</text>
      <view class="nav-action"></view>
    </view>
  </view>

  <!-- Profile Header (avatar + name, kept below nav-bar) -->
  <view class="profile-header" style="background: {{theme.headerGradient || 'linear-gradient(135deg, #1A1A2E, #252540)'}}; padding: 48rpx 32rpx;">
    <view class="avatar" style="background: {{theme.accentBg || 'rgba(201,169,110,0.15)'}}; color: {{theme.accentColor || '#C9A96E'}}; width: 120rpx; height: 120rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 56rpx; font-weight: 700; margin: 0 auto 24rpx;">
      {{customerNameInitial}}
    </view>
    <text style="color: {{theme.textPrimary || '#F0F0F5'}}; font-size: 40rpx; font-weight: 700; display: block; text-align: center;">{{customerName}}</text>
  </view>

  <!-- Stats Row -->
  <view class="stats-row" style="padding: 0 32rpx; margin-top: -32rpx;">
    <view class="stat-card" style="background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border: 1rpx solid {{theme.border || 'rgba(255,255,255,0.06)'}}; border-radius: 24rpx; padding: 28rpx; flex: 1; text-align: center;">
      <text style="color: {{theme.accentColor || '#C9A96E'}}; font-size: 36rpx; font-weight: 800; font-family: 'DIN Alternate', monospace; display: block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{totalVisits}}</text>
      <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 24rpx; margin-top: 8rpx; display: block;">来访次数</text>
    </view>
    <view class="stat-card" style="background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border: 1rpx solid {{theme.border || 'rgba(255,255,255,0.06)'}}; border-radius: 24rpx; padding: 28rpx; flex: 1; text-align: center; margin: 0 12rpx;">
      <text style="color: {{theme.amountPositive || '#4ADE80'}}; font-size: 30rpx; font-weight: 800; font-family: 'DIN Alternate', monospace; display: block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">¥{{totalSpending}}</text>
      <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 24rpx; margin-top: 8rpx; display: block;">累计消费</text>
    </view>
    <view class="stat-card" style="background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border: 1rpx solid {{theme.border || 'rgba(255,255,255,0.06)'}}; border-radius: 24rpx; padding: 28rpx; flex: 1; text-align: center;">
      <text style="color: {{theme.textPrimary || '#F0F0F5'}}; font-size: 28rpx; font-weight: 700; display: block;">{{preferredRoom}}</text>
      <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 24rpx; margin-top: 8rpx; display: block;">偏好房间</text>
    </view>
  </view>

  <!-- Stored Value Account -->
  <view class="stored-value-section">
    <view class="section-title-row">
      <text class="section-title" style="color: {{theme.textPrimary || '#F0F0F5'}};">储值账户</text>
      <view wx:if="{{canRecharge}}" class="recharge-entry" bindtap="openRechargeModal" style="background: {{theme.accentBg || 'rgba(201,169,110,0.15)'}}; color: {{theme.accentColor || '#C9A96E'}};">充值</view>
    </view>

    <skeleton wx:if="{{loading}}" theme="{{theme}}" type="card" count="1" />

    <view wx:else class="stored-value-card" style="background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border: 1rpx solid {{theme.border || 'rgba(255,255,255,0.06)'}};">
      <view wx:if="{{storedValueAccount}}">
        <view class="balance-block">
          <text class="balance-label" style="color: {{theme.textMuted || '#5C5C72'}};">当前余额</text>
          <text class="balance-amount" style="color: {{theme.amountPositive || '#4ADE80'}};">¥{{storedValueAccount.balanceText}}</text>
        </view>
        <view class="stored-value-metrics">
          <view class="stored-value-metric">
            <text class="metric-value" style="color: {{theme.textPrimary || '#F0F0F5'}};">¥{{storedValueAccount.totalRechargeText}}</text>
            <text class="metric-label" style="color: {{theme.textMuted || '#5C5C72'}};">累计充值</text>
          </view>
          <view class="stored-value-metric">
            <text class="metric-value" style="color: {{theme.textPrimary || '#F0F0F5'}};">¥{{storedValueAccount.totalConsumeText}}</text>
            <text class="metric-label" style="color: {{theme.textMuted || '#5C5C72'}};">累计消费</text>
          </view>
        </view>

        <view class="transaction-header">
          <text class="transaction-title" style="color: {{theme.textPrimary || '#F0F0F5'}};">储值流水</text>
        </view>
        <view wx:if="{{storedValueTransactions.length}}" class="transaction-list">
          <view class="transaction-item" wx:for="{{storedValueTransactions}}" wx:key="_id">
            <view class="transaction-main">
              <text class="transaction-name" style="color: {{theme.textPrimary || '#F0F0F5'}};">{{item.title}}</text>
              <text class="transaction-time" style="color: {{theme.textMuted || '#5C5C72'}};">{{item.formattedTime}}</text>
            </view>
            <view class="transaction-side">
              <text class="transaction-amount {{item.amountClass}}">{{item.amountText}}</text>
              <text class="transaction-balance" style="color: {{theme.textMuted || '#5C5C72'}};">{{item.balanceText}}</text>
            </view>
          </view>
        </view>
        <view wx:else class="empty-transactions" style="color: {{theme.textMuted || '#5C5C72'}};">暂无储值流水</view>
      </view>

      <view wx:else class="stored-value-empty">
        <text class="empty-title" style="color: {{theme.textPrimary || '#F0F0F5'}};">暂无储值账户</text>
        <text class="empty-desc" style="color: {{theme.textMuted || '#5C5C72'}};">为客户充值后将自动创建储值账户</text>
      </view>
    </view>
  </view>

  <!-- Visit History -->
  <view style="padding: 32rpx;">
    <text style="color: {{theme.textPrimary || '#F0F0F5'}}; font-size: 32rpx; font-weight: 600; display: block; margin-bottom: 20rpx;">来访记录</text>

    <skeleton wx:if="{{loading}}" theme="{{theme}}" type="list" count="5" />

    <view wx:else>
      <view class="timeline-item" wx:for="{{visitHistory}}" wx:key="_id" style="background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border: 1rpx solid {{theme.border || 'rgba(255,255,255,0.06)'}}; border-radius: 20rpx; padding: 24rpx; margin-bottom: 16rpx;">
        <view style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx;">
          <text style="color: {{theme.textPrimary || '#F0F0F5'}}; font-size: 28rpx; font-weight: 600;">{{item.formattedDate}}</text>
          <theme-badge theme="{{theme}}" status="{{item.status}}" type="status" text="{{item.status === 'confirmed' ? '已确认' : '已取消'}}" size="sm" />
        </view>
        <view style="display: flex; align-items: center; gap: 24rpx;">
          <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 26rpx;">{{item.roomName || item.room}} · {{item.time}} · {{item.guestCount}}人</text>
          <text style="color: {{theme.accentColor || '#C9A96E'}}; font-size: 26rpx;">¥{{(item.standard || 0) * (item.guestCount || 0)}}</text>
        </view>
      </view>
    </view>
  </view>

  <theme-modal theme="{{theme}}" visible="{{showRechargeModal}}" title="储值充值" confirmText="{{rechargeSubmitting ? '充值中...' : '确认充值'}}" cancelText="取消" position="bottom" bind:confirm="submitRecharge" bind:close="closeRechargeModal">
    <view class="recharge-form">
      <view class="form-item">
        <text class="form-label" style="color: {{theme.textSecondary || '#9A9AB0'}};">客户</text>
        <view class="form-readonly" style="background: {{theme.surface || '#1A1A2E'}}; color: {{theme.textPrimary || '#F0F0F5'}}; border: 1rpx solid {{theme.border || 'rgba(255,255,255,0.06)'}};">{{customerName}}</view>
      </view>
      <view class="form-item">
        <text class="form-label" style="color: {{theme.textSecondary || '#9A9AB0'}};">充值金额</text>
        <input class="form-input" style="background: {{theme.surface || '#1A1A2E'}}; color: {{theme.textPrimary || '#F0F0F5'}}; border: 1rpx solid {{theme.border || 'rgba(255,255,255,0.06)'}};" type="digit" placeholder="请输入充值金额" placeholder-style="color: rgba(154,154,176,0.55);" value="{{rechargeAmount}}" bindinput="onRechargeAmountInput" />
      </view>
      <view class="form-item">
        <text class="form-label" style="color: {{theme.textSecondary || '#9A9AB0'}};">手机号</text>
        <input class="form-input" style="background: {{theme.surface || '#1A1A2E'}}; color: {{theme.textPrimary || '#F0F0F5'}}; border: 1rpx solid {{theme.border || 'rgba(255,255,255,0.06)'}};" type="number" maxlength="11" placeholder="可选，用于匹配客户账户" placeholder-style="color: rgba(154,154,176,0.55);" value="{{rechargePhone}}" bindinput="onRechargePhoneInput" />
      </view>
      <view class="form-item">
        <text class="form-label" style="color: {{theme.textSecondary || '#9A9AB0'}};">收款方式</text>
        <picker mode="selector" range="{{paymentMethodOptions}}" range-key="label" bindchange="onRechargePaymentMethodChange">
          <view class="form-picker" style="background: {{theme.surface || '#1A1A2E'}}; color: {{theme.textPrimary || '#F0F0F5'}}; border: 1rpx solid {{theme.border || 'rgba(255,255,255,0.06)'}};">
            <text>{{rechargePaymentMethodLabel}}</text>
            <text class="picker-arrow" style="color: {{theme.textMuted || '#5C5C72'}};">›</text>
          </view>
        </picker>
      </view>
      <view class="form-item">
        <text class="form-label" style="color: {{theme.textSecondary || '#9A9AB0'}};">备注</text>
        <textarea class="form-textarea" style="background: {{theme.surface || '#1A1A2E'}}; color: {{theme.textPrimary || '#F0F0F5'}}; border: 1rpx solid {{theme.border || 'rgba(255,255,255,0.06)'}};" placeholder="可选" placeholder-style="color: rgba(154,154,176,0.55);" value="{{rechargeRemark}}" bindinput="onRechargeRemarkInput" maxlength="100" />
      </view>
    </view>
  </theme-modal>
</view>
