@import '../../styles/mixins.wxss';

.customer-detail-page {
  min-height: 100vh;
}

/* Navigation Bar */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-bar-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 44rpx;
  font-weight: 300;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
}

.nav-action {
  min-width: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.profile-header {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  margin-bottom: 24rpx;
}

.stats-row {
  display: flex;
  gap: 0;
  margin-bottom: 32rpx;
}

.stat-card {
  flex: 1;
}

.stored-value-section {
  padding: 0 32rpx 32rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
}

.recharge-entry {
  min-width: 112rpx;
  height: 56rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
}

.recharge-entry:active,
.timeline-item:active {
  transform: scale(0.98);
}

.stored-value-card {
  border-radius: 24rpx;
  padding: 28rpx;
}

.balance-block {
  margin-bottom: 24rpx;
}

.balance-label,
.metric-label,
.transaction-time,
.transaction-balance,
.empty-desc,
.form-label {
  display: block;
  font-size: 24rpx;
}

.balance-amount {
  display: block;
  margin-top: 8rpx;
  font-family: 'DIN Alternate', monospace;
  font-size: 48rpx;
  font-weight: 800;
}

.stored-value-metrics {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.stored-value-metric {
  flex: 1;
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.04);
}

.metric-value {
  display: block;
  font-family: 'DIN Alternate', monospace;
  font-size: 30rpx;
  font-weight: 700;
}

.metric-label {
  margin-top: 6rpx;
}

.transaction-header {
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.transaction-title {
  font-size: 28rpx;
  font-weight: 600;
}

.transaction-list {
  margin-top: 16rpx;
}

.transaction-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.transaction-item:last-child {
  border-bottom: 0;
}

.transaction-main {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.transaction-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.transaction-time,
.transaction-balance {
  margin-top: 6rpx;
}

.transaction-side {
  text-align: right;
}

.transaction-amount {
  display: block;
  font-family: 'DIN Alternate', monospace;
  font-size: 28rpx;
  font-weight: 800;
}

.transaction-amount.positive {
  color: #4ade80;
}

.transaction-amount.negative {
  color: #f87171;
}

.empty-transactions,
.stored-value-empty,
.stored-value-error {
  padding: 28rpx 0 8rpx;
  text-align: center;
  font-size: 26rpx;
}

.empty-title,
.error-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.empty-desc,
.error-desc {
  margin-top: 10rpx;
}

.error-desc {
  display: block;
  line-height: 1.6;
}

.recharge-form {
  padding-bottom: 8rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  margin-bottom: 10rpx;
}

.form-input,
.form-readonly,
.form-picker,
.form-textarea {
  width: 100%;
  box-sizing: border-box;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.form-input,
.form-readonly,
.form-picker {
  height: 88rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
}

.form-picker {
  justify-content: space-between;
}

.form-textarea {
  min-height: 144rpx;
  padding: 22rpx 24rpx;
}

.form-input:focus,
.form-textarea:focus {
  border-color: #c9a96e;
  box-shadow: 0 0 0 4rpx rgba(201, 169, 110, 0.12);
}

.picker-arrow {
  font-size: 36rpx;
}

.timeline-item {
  transition: transform 0.15s ease;
}
