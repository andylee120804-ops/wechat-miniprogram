@import '../../styles/mixins.wxss';

.customer-detail-page {
  min-height: 100vh;
}

/* Navigation Bar */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-bar-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 44rpx;
  font-weight: 300;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
}

.nav-action {
  min-width: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.profile-header {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  margin-bottom: 24rpx;
}

.stats-row {
  display: flex;
  gap: 0;
  margin-bottom: 32rpx;
}

.stat-card {
  flex: 1;
}

.timeline-item {
  transition: transform 0.15s ease;
}

.timeline-item:active {
  transform: scale(0.98);
}
