.customer-detail-page {
  min-height: 100vh;
}

.profile-header {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  margin-bottom: 24rpx;
}

.stats-row {
  display: flex;
  gap: 0;
  margin-bottom: 32rpx;
}

.stat-card {
  flex: 1;
}

.timeline-item {
  transition: transform 0.15s ease;
}

.timeline-item:active {
  transform: scale(0.98);
}
