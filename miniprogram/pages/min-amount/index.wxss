@import '../../styles/mixins.wxss';
@import '../../styles/bottom-bar.wxss';

.page {
  min-height: 100vh;
}

.page-content {
  padding-left: 0;
  padding-right: 0;
  padding-bottom: 120rpx;
}

.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-bar-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 44rpx;
  font-weight: 300;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
}

.nav-action {
  min-width: 64rpx;
}

.form-item {
  transition: border-color 0.2s;
}

.form-item:active {
  border-color: rgba(201, 169, 110, 0.4);
}
