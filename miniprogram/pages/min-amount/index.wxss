@import '../../styles/mixins.wxss';
@import '../../styles/bottom-bar.wxss';

.page {
  min-height: 100vh;
}

.page-content {
  padding-left: 0;
  padding-right: 0;
  padding-bottom: 40rpx;
}

.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-bar-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 44rpx;
  font-weight: 300;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
}

.nav-action {
  min-width: 64rpx;
}

.form-item {
  transition: border-color 0.2s;
}

.form-item:active {
  border-color: rgba(201, 169, 110, 0.4);
}

/* ── Tab Bar ──────────────────────────────────────────────── */

.tab-bar {
  display: flex;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.06);
  padding: 0 24rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #5C5C72;
  position: relative;
  transition: color 0.2s;
}

.tab-active {
  color: #C9A96E;
  font-weight: 600;
}

.tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 30%;
  right: 30%;
  height: 6rpx;
  background: #C9A96E;
  border-radius: 3rpx;
}

.tab-content {
  padding: 24rpx;
}

/* ── Room Cards (Tab 0) ───────────────────────────────────── */

.restore-btn {
  text-align: right;
  font-size: 26rpx;
  padding: 12rpx 24rpx;
  margin-bottom: 16rpx;
}

.room-card {
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  transition: opacity 0.2s;
}

.room-disabled {
  opacity: 0.5;
}

.room-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.room-card-name {
  font-size: 32rpx;
  font-weight: 600;
}

.room-card-badges {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.room-badge {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.badge-enabled {
  background: rgba(74, 222, 128, 0.12);
  color: #4ADE80;
}

.badge-disabled {
  background: rgba(248, 113, 113, 0.12);
  color: #F87171;
}

.room-more {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.room-card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.room-tag {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
}

.add-room-btn {
  border: 2rpx dashed rgba(255, 255, 255, 0.10);
  border-radius: 16rpx;
  padding: 40rpx;
  text-align: center;
  font-size: 28rpx;
  margin-top: 8rpx;
}

/* ── Room Editor Modal ────────────────────────────────────── */

.editor-field {
  margin-bottom: 24rpx;
}

.editor-label {
  display: block;
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.editor-input {
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.10);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.editor-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.editor-field-half {
  flex: 1;
}

.pill-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.pill {
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 500;
  transition: background 0.15s, color 0.15s;
}

.pill-active {
  /* inline styles override */
}

.pill-removable {
  position: relative;
}

.editor-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.editor-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.editor-btn-danger {
  border: 1rpx solid rgba(248, 113, 113, 0.3);
}

.editor-btn-primary {
  border: none;
}

/* ── Form Config (Tab 1) ──────────────────────────────────── */

.field-row {
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.field-main {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.field-info {
  flex: 1;
}

.field-label {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.field-badges {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.field-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 500;
}

.badge-system {
  background: rgba(96, 165, 250, 0.12);
  color: #60A5FA;
}

.badge-custom {
  background: rgba(201, 169, 110, 0.12);
  color: #C9A96E;
}

.badge-type {
  font-size: 18rpx;
}

.field-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.toggle-group {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.toggle-label {
  font-size: 22rpx;
}

.field-delete {
  font-size: 32rpx;
  color: #F87171;
  padding: 8rpx;
}

.field-options {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  align-items: center;
}

.option-pill {
  padding: 8rpx 18rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.option-input {
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.10);
  border-radius: 18rpx;
  padding: 8rpx 18rpx;
  font-size: 24rpx;
  width: 200rpx;
}

.field-hidden {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.hidden-label {
  font-size: 22rpx;
}

.hidden-pills {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.hidden-pill {
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.hidden-add {
  font-size: 22rpx;
  font-weight: 500;
}

.add-field-row {
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.add-field-form {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.add-field-input {
  flex: 1;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.10);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
}

.type-picker {
  font-size: 24rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.10);
  border-radius: 12rpx;
}

.add-field-btn {
  font-size: 28rpx;
  font-weight: 600;
  padding: 16rpx 24rpx;
}

.hidden-room-row {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

/* ── Add row (input + button) ─────────────────────────────── */

.add-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.add-row-input {
  flex: 1;
}

.add-row-btn {
  flex-shrink: 0;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
}

/* ── Customer Presets (Tab 3) ─────────────────────────────── */

.preset-list {
  margin-bottom: 8rpx;
}

.preset-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
}

.preset-name {
  font-size: 30rpx;
  font-weight: 500;
  flex: 1;
}

.preset-delete {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(248, 113, 113, 0.12);
}
