<view class="page" style="background: {{theme.surfaceColor || '#1A1A2E'}}; min-height: 100vh;">
  <view class="nav-bar" style="background: {{theme.gradientHeader || theme.surfaceColor}}; padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar-content">
      <view class="nav-back" bindtap="onBack">
        <text class="nav-back-icon" style="color: {{theme.textPrimary}}">❮</text>
      </view>
      <text class="nav-title" style="color: {{theme.textPrimary}};">最低消费设置</text>
      <view class="nav-action"></view>
    </view>
  </view>

  <view style="padding-top: {{statusBarHeight + 44}}px; padding: 32rpx;">
    <theme-card theme="{{theme}}" padding="32rpx">
      <view class="section-title" style="color: {{theme.textPrimary}}; margin-bottom: 24rpx;">包厢最低消费</view>
      <view class="form-item-row">
        <text class="form-label" style="color: {{theme.textSecondary}};">大包厢</text>
        <input class="form-input" type="number" value="{{min_big}}" bindinput="onBigInput" placeholder="请输入金额" placeholder-style="color: {{theme.textMuted}}" style="color: {{theme.textPrimary}}; flex: 1; text-align: right;" />
        <text style="color: {{theme.textSecondary}}; margin-left: 8rpx;">元</text>
      </view>
      <view class="form-item-row" style="margin-top: 20rpx;">
        <text class="form-label" style="color: {{theme.textSecondary}};">小包厢</text>
        <input class="form-input" type="number" value="{{min_small}}" bindinput="onSmallInput" placeholder="请输入金额" placeholder-style="color: {{theme.textMuted}}" style="color: {{theme.textPrimary}}; flex: 1; text-align: right;" />
        <text style="color: {{theme.textSecondary}}; margin-left: 8rpx;">元</text>
      </view>
    </theme-card>

    <theme-card theme="{{theme}}" padding="32rpx" style="margin-top: 24rpx;">
      <view class="section-title" style="color: {{theme.textPrimary}}; margin-bottom: 24rpx;">包场最低消费</view>
      <view class="form-item-row">
        <text class="form-label" style="color: {{theme.textSecondary}};">午包场</text>
        <input class="form-input" type="number" value="{{min_noon}}" bindinput="onNoonInput" placeholder="请输入金额" placeholder-style="color: {{theme.textMuted}}" style="color: {{theme.textPrimary}}; flex: 1; text-align: right;" />
        <text style="color: {{theme.textSecondary}}; margin-left: 8rpx;">元</text>
      </view>
      <view class="form-item-row" style="margin-top: 20rpx;">
        <text class="form-label" style="color: {{theme.textSecondary}};">晚包场</text>
        <input class="form-input" type="number" value="{{min_night}}" bindinput="onNightInput" placeholder="请输入金额" placeholder-style="color: {{theme.textMuted}}" style="color: {{theme.textPrimary}}; flex: 1; text-align: right;" />
        <text style="color: {{theme.textSecondary}}; margin-left: 8rpx;">元</text>
      </view>
      <view class="form-item-row" style="margin-top: 20rpx;">
        <text class="form-label" style="color: {{theme.textSecondary}};">全体包场</text>
        <input class="form-input" type="number" value="{{min_full}}" bindinput="onFullInput" placeholder="请输入金额" placeholder-style="color: {{theme.textMuted}}" style="color: {{theme.textPrimary}}; flex: 1; text-align: right;" />
        <text style="color: {{theme.textSecondary}}; margin-left: 8rpx;">元</text>
      </view>
    </theme-card>
  </view>

  <view class="bottom-bar">
    <view class="bottom-bar-inner single-btn">
      <view class="bar-btn bar-btn-primary" bindtap="onSave">保存设置</view>
    </view>
  </view>
</view>