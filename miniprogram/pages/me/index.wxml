<view class="me-page" style="background: {{theme.surfaceColor || '#1A1A2E'}}; min-height: 100vh;">
  <!-- Custom Navigation Bar -->
  <view class="nav-bar" style="background: {{theme.gradientHeader || theme.surfaceColor}}; padding-top: {{statusBarHeight}}px; height: {{statusBarHeight + 44}}px; box-sizing: border-box;">
    <view class="nav-bar-content">
      <view class="nav-back"></view>
      <text class="nav-title" style="color: {{theme.textPrimary || '#F5F0E8'}};">我的</text>
      <view class="nav-action"></view>
    </view>
  </view>

  <!-- Profile Hero -->
  <view class="profile-hero" style="padding-top: {{statusBarHeight + 44}}px;">
    <glass-card theme="{{theme}}" blur="20" opacity="0.06" padding="40rpx 32rpx" class="hero-card">
      <view class="profile-row">
        <!-- Avatar -->
        <view class="avatar-circle" style="background: {{theme.gradientAvatar || 'linear-gradient(135deg, #C9A96E, #8B6F3A)'}}; box-shadow: {{theme.shadowMd || '0 8rpx 24rpx rgba(0,0,0,0.28)'}};">
          <text class="avatar-char" style="color: {{theme.textInverse || '#0F0F1A'}};">{{userInfo.name ? userInfo.name[0] : '?'}}</text>
        </view>
        <!-- Info -->
        <view class="profile-info flex-1">
          <text class="profile-name text-title1" style="color: {{theme.textPrimary || '#F5F0E8'}};">{{userInfo.name || '未登录'}}</text>
          <view class="profile-role-row mt-xs">
            <theme-badge theme="{{theme}}" status="{{userInfo.role}}" type="role" text="{{roleName}}" size="sm" wx:if="{{userInfo.role}}" />
          </view>
        </view>
      </view>
    </glass-card>
  </view>

  <!-- Menu Groups -->
  <view class="menu-section px-lg mt-xl">
    <!-- Management Group -->
    <view class="menu-group" wx:if="{{managementGroup.length > 0}}">
      <text class="menu-group-title text-overline" style="color: {{theme.textMuted || 'rgba(245,240,232,0.40)'}};">管理</text>
      <view class="menu-card" style="background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}}; border-radius: 20rpx; overflow: hidden; box-shadow: {{theme.shadowSm || '0 2rpx 8rpx rgba(0,0,0,0.20)'}};">
        <view class="menu-item flex-row flex-between" wx:for="{{managementGroup}}" wx:key="key"
          data-key="{{item.key}}" bindtap="onMenuTap"
          style="border-bottom: {{index < managementGroup.length - 1 ? '1rpx solid ' + (theme.divider || 'rgba(255,255,255,0.08)') : 'none'}};">
          <view class="menu-item-left flex-row">
            <text class="menu-icon">{{item.icon}}</text>
            <text class="menu-text text-body" style="color: {{theme.textPrimary || '#F5F0E8'}};">{{item.text}}</text>
          </view>
          <text class="menu-arrow" style="color: {{theme.textMuted || 'rgba(245,240,232,0.40)'}};">›</text>
        </view>
      </view>
    </view>

    <!-- Todo Group -->
    <view class="menu-group mt-lg" wx:if="{{hasTodoPermission}}">
      <text class="menu-group-title text-overline" style="color: {{theme.textMuted || 'rgba(245,240,232,0.40)'}};">待办</text>
      <view class="menu-card" style="background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}}; border-radius: 20rpx; overflow: hidden; box-shadow: {{theme.shadowSm || '0 2rpx 8rpx rgba(0,0,0,0.20)'}};">
        <view class="menu-item flex-row flex-between" wx:for="{{pendingGroup}}" wx:key="key"
          data-key="{{item.key}}" bindtap="onMenuTap"
          style="border-bottom: {{index < pendingGroup.length - 1 ? '1rpx solid ' + (theme.divider || 'rgba(255,255,255,0.08)') : 'none'}};">
          <view class="menu-item-left flex-row">
            <text class="menu-icon">{{item.icon}}</text>
            <text class="menu-text text-body" style="color: {{theme.textPrimary || '#F5F0E8'}};">{{item.text}}</text>
          </view>
          <view class="menu-item-right flex-row" style="align-items: center;">
            <view wx:if="{{item.count > 0}}" class="todo-badge" style="background: rgba(251,191,36,0.15); margin-right: 12rpx;">
              <text class="todo-badge-text" style="color: #FBBF24;">{{item.count}}</text>
            </view>
            <text class="menu-arrow" style="color: {{theme.textMuted || 'rgba(245,240,232,0.40)'}};">›</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Feature Group -->
    <view class="menu-group mt-lg" wx:if="{{featureGroup.length > 0}}">
      <text class="menu-group-title text-overline" style="color: {{theme.textMuted || 'rgba(245,240,232,0.40)'}};">汇报</text>
      <view class="menu-card" style="background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}}; border-radius: 20rpx; overflow: hidden; box-shadow: {{theme.shadowSm || '0 2rpx 8rpx rgba(0,0,0,0.20)'}};">
        <view class="menu-item flex-row flex-between" wx:for="{{featureGroup}}" wx:key="key"
          data-key="{{item.key}}" bindtap="onMenuTap"
          style="border-bottom: {{index < featureGroup.length - 1 ? '1rpx solid ' + (theme.divider || 'rgba(255,255,255,0.08)') : 'none'}};">
          <view class="menu-item-left flex-row">
            <text class="menu-icon">{{item.icon}}</text>
            <text class="menu-text text-body" style="color: {{theme.textPrimary || '#F5F0E8'}};">{{item.text}}</text>
          </view>
          <text class="menu-arrow" style="color: {{theme.textMuted || 'rgba(245,240,232,0.40)'}};">›</text>
        </view>
      </view>
    </view>

    <!-- Settings Group -->
    <view class="menu-group mt-lg" wx:if="{{settingsGroup.length > 0}}">
      <text class="menu-group-title text-overline" style="color: {{theme.textMuted || 'rgba(245,240,232,0.40)'}};">设置</text>
      <view class="menu-card" style="background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}}; border-radius: 20rpx; overflow: hidden; box-shadow: {{theme.shadowSm || '0 2rpx 8rpx rgba(0,0,0,0.20)'}};">
        <view class="menu-item flex-row flex-between" wx:for="{{settingsGroup}}" wx:key="key"
          data-key="{{item.key}}" bindtap="onMenuTap"
          style="border-bottom: {{index < settingsGroup.length - 1 ? '1rpx solid ' + (theme.divider || 'rgba(255,255,255,0.08)') : 'none'}};">
          <view class="menu-item-left flex-row">
            <text class="menu-icon">{{item.icon}}</text>
            <text class="menu-text text-body" style="color: {{theme.textPrimary || '#F5F0E8'}};">{{item.text}}</text>
          </view>
          <text class="menu-arrow" style="color: {{theme.textMuted || 'rgba(245,240,232,0.40)'}};">›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Logout Button -->
  <view class="logout-section" wx:if="{{userInfo}}">
    <button bindtap="onLogout" class="logout-btn" style="background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border: 1rpx solid {{theme.border || 'rgba(255,255,255,0.06)'}}; border-radius: 20rpx; padding: 28rpx 48rpx; margin: 0 32rpx; width: auto; display: block; line-height: 1; font-size: 28rpx; font-weight: 500; color: {{theme.statusDanger || '#F87171'}};">
      退出登录
    </button>
  </view>

  <!-- Bottom Spacer for tab bar -->
  <view class="tab-bar-safe-bottom"></view>
</view>
