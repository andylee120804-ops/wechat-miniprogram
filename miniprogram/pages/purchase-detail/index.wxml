<view class="page" style="background: {{theme.surfaceColor || '#1A1A2E'}};">
  <!-- Custom Navigation Bar -->
  <view class="nav-bar" style="background: {{theme.gradientHeader || theme.surfaceColor}}; padding-top: {{statusBarHeight}}px; height: {{statusBarHeight + 44}}px; box-sizing: border-box;">
    <view class="nav-bar-content">
      <view class="nav-back" bindtap="onBack">
        <text class="nav-back-icon" style="color: {{theme.textPrimary || '#F5F0E8'}};">❮</text>
      </view>
      <text class="nav-title" style="color: {{theme.textPrimary || '#F5F0E8'}};">采购详情</text>
      <view class="nav-action"></view>
    </view>
  </view>

  <view class="page-content px-lg" style="padding-top: {{statusBarHeight + 44 + 16}}px;" wx:if="{{!loading && purchase}}">
    <!-- Amount Hero -->
    <view class="hero-section flex-col flex-center" style="background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border-radius: 20rpx; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}}; box-shadow: {{theme.shadowMd || '0 8rpx 24rpx rgba(0,0,0,0.28)'}};">
      <view class="p-xl flex-col flex-center">
        <text class="text-caption" style="color: {{theme.textMuted || '#5C5C72'}};">采购金额</text>
        <text class="hero-amount text-display font-mono mt-xs" style="color: {{theme.amountNegative || '#F87171'}};">-¥{{purchase.formattedAmount}}</text>
        <view class="hero-badge-row flex-row flex-center mt-sm">
          <theme-badge theme="{{theme}}" status="{{purchase.status}}" type="approvalStatus" size="md" />
          <theme-badge theme="{{theme}}" status="{{purchase.category}}" type="category" text="{{purchase.categoryName}}" size="md" style="margin-left: 12rpx;" />
        </view>
      </view>
    </view>

    <!-- Detail Card -->
    <theme-card theme="{{theme}}" class="mt-lg">
      <view class="p-lg">
        <view class="detail-row flex-row flex-between py-md" style="border-bottom: 1rpx solid {{theme.dividerColor || 'rgba(255,255,255,0.08)'}};">
          <text class="detail-label text-bodySmall" style="color: {{theme.textSecondary || '#9A9AB0'}};">物品名称</text>
          <text class="detail-value text-body" style="color: {{theme.textPrimary || '#F5F0E8'}};">{{purchase.item}}</text>
        </view>
        <view class="detail-row flex-row flex-between py-md" style="border-bottom: 1rpx solid {{theme.dividerColor || 'rgba(255,255,255,0.08)'}};">
          <text class="detail-label text-bodySmall" style="color: {{theme.textSecondary || '#9A9AB0'}};">采购分类</text>
          <text class="detail-value text-body" style="color: {{theme.textPrimary || '#F5F0E8'}};">{{purchase.categoryName}}</text>
        </view>
        <view class="detail-row flex-row flex-between py-md" style="border-bottom: 1rpx solid {{theme.dividerColor || 'rgba(255,255,255,0.08)'}};">
          <text class="detail-label text-bodySmall" style="color: {{theme.textSecondary || '#9A9AB0'}};">采购日期</text>
          <text class="detail-value text-body" style="color: {{theme.textPrimary || '#F5F0E8'}};">{{purchase.formattedDate}}</text>
        </view>
        <view class="detail-row flex-row flex-between py-md" wx:if="{{purchase.purchaseByName || purchase.autoGenerated}}" style="border-bottom: 1rpx solid {{theme.dividerColor || 'rgba(255,255,255,0.08)'}};">
          <text class="detail-label text-bodySmall" style="color: {{theme.textSecondary || '#9A9AB0'}};">采购人</text>
          <text class="detail-value text-body" style="color: {{theme.textPrimary || '#F5F0E8'}};">{{purchase.purchaseByName || '系统自动'}}</text>
        </view>
        <view class="detail-row flex-row flex-between py-md" wx:if="{{purchase.approverName}}" style="border-bottom: 1rpx solid {{theme.dividerColor || 'rgba(255,255,255,0.08)'}};">
          <text class="detail-label text-bodySmall" style="color: {{theme.textSecondary || '#9A9AB0'}};">审批人</text>
          <text class="detail-value text-body" style="color: {{theme.textPrimary || '#F5F0E8'}};">{{purchase.approverName}}</text>
        </view>
        <view class="detail-row flex-row flex-between py-md" wx:if="{{purchase.rejectionReason}}" style="border-bottom: 1rpx solid {{theme.dividerColor || 'rgba(255,255,255,0.08)'}};">
          <text class="detail-label text-bodySmall" style="color: {{theme.textSecondary || '#9A9AB0'}};">拒绝原因</text>
          <text class="detail-value text-body" style="color: #F87171; max-width: 420rpx; text-align: right;">{{purchase.rejectionReason}}</text>
        </view>
        <view class="detail-row flex-row flex-between py-md" wx:if="{{defaultReimburserName}}" style="border-bottom: 1rpx solid {{theme.dividerColor || 'rgba(255,255,255,0.08)'}};">
          <text class="detail-label text-bodySmall" style="color: {{theme.textSecondary || '#9A9AB0'}};">付款人</text>
          <text class="detail-value text-body" style="color: {{theme.textPrimary || '#F5F0E8'}};">{{defaultReimburserName}}</text>
        </view>
        <view class="detail-row flex-row flex-between py-md" wx:if="{{purchase.remark}}" style="border-bottom: 1rpx solid {{theme.dividerColor || 'rgba(255,255,255,0.08)'}};">
          <text class="detail-label text-bodySmall" style="color: {{theme.textSecondary || '#9A9AB0'}};">备注</text>
          <text class="detail-value text-body" style="color: {{theme.textPrimary || '#F5F0E8'}}; max-width: 420rpx; text-align: right;">{{purchase.remark}}</text>
        </view>
        <view class="detail-row flex-row flex-between py-md">
          <text class="detail-label text-bodySmall" style="color: {{theme.textSecondary || '#9A9AB0'}};">创建时间</text>
          <text class="detail-value text-caption" style="color: {{theme.textMuted || '#5C5C72'}};">{{purchase.formattedCreatedAt}}</text>
        </view>
      </view>
    </theme-card>

    <!-- Linked Reservation (for banquet purchases) -->
    <theme-card theme="{{theme}}" padding="32rpx" style="margin-top: 24rpx;" wx:if="{{reservation}}">
      <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx;">
        <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 24rpx; font-weight: 500;">关联预约</text>
        <view style="display: inline-flex; align-items: center; background: {{reservation.status === 'cancelled' ? 'rgba(248,113,113,0.15)' : 'rgba(74,222,128,0.15)'}}; padding: 6rpx 16rpx; border-radius: 100rpx;">
          <view style="width: 10rpx; height: 10rpx; border-radius: 50%; background: {{reservation.status === 'cancelled' ? '#F87171' : '#4ADE80'}}; margin-right: 8rpx;"></view>
          <text style="color: {{reservation.status === 'cancelled' ? '#F87171' : '#4ADE80'}}; font-size: 22rpx; font-weight: 500;">{{reservation.statusText}}</text>
        </view>
      </view>
      <view style="background: {{theme.glassBg || 'rgba(255,255,255,0.04)'}}; border-radius: 16rpx; padding: 24rpx; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.08)'}};">
        <view style="margin-bottom: 20rpx;">
          <text style="color: {{theme.textPrimary || '#F0F0F5'}}; font-size: 34rpx; font-weight: 700;">{{reservation.customerName}}</text>
        </view>
        <view style="display: flex; flex-wrap: nowrap; gap: 12rpx; margin-bottom: 16rpx; overflow: hidden;">
          <view style="display: flex; align-items: center; background: rgba(255,255,255,0.05); padding: 6rpx 12rpx; border-radius: 8rpx; flex-shrink: 0;">
            <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 22rpx;">📅</text>
            <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 22rpx; margin-left: 6rpx;">{{reservation.dateDisplay}}</text>
          </view>
          <view style="display: flex; align-items: center; background: rgba(255,255,255,0.05); padding: 6rpx 12rpx; border-radius: 8rpx; flex-shrink: 0;">
            <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 22rpx;">⏰</text>
            <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 22rpx; margin-left: 6rpx;">{{reservation.time}}</text>
          </view>
          <view style="display: flex; align-items: center; background: rgba(255,255,255,0.05); padding: 6rpx 12rpx; border-radius: 8rpx; flex-shrink: 0;">
            <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 22rpx;">👥</text>
            <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 22rpx; margin-left: 6rpx;">{{reservation.guestCount}}人</text>
          </view>
          <view style="display: flex; align-items: center; background: rgba(255,255,255,0.05); padding: 6rpx 12rpx; border-radius: 8rpx; flex-shrink: 0;">
            <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 22rpx;">🚪</text>
            <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 22rpx; margin-left: 6rpx;">{{reservation.roomNameDisplay}}</text>
          </view>
        </view>
        <view wx:if="{{reservation.phone}}" style="padding: 10rpx 0; border-top: 1rpx solid rgba(255,255,255,0.06);">
          <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 22rpx;">📞 </text>
          <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 22rpx;">{{reservation.phone}}</text>
        </view>
        <view wx:if="{{reservation.dishPrice > 0}}" style="padding: 10rpx 0; border-top: 1rpx solid rgba(255,255,255,0.06);">
          <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 22rpx;">菜价 </text>
          <text style="color: {{theme.accentColor || '#C9A96E'}}; font-size: 22rpx; font-weight: 600;">¥{{reservation.dishPrice}}</text>
        </view>
        <view style="padding: 10rpx 0; border-top: 1rpx solid rgba(255,255,255,0.06);">
          <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 22rpx;">人均 </text>
          <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 22rpx;">¥{{reservation.standard}}/人</text>
        </view>
        <view wx:if="{{reservation.remark}}" style="padding: 10rpx 0; border-top: 1rpx solid rgba(255,255,255,0.06);">
          <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 22rpx;">备注 </text>
          <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 22rpx;">{{reservation.remark}}</text>
        </view>
      </view>
    </theme-card>

    <!-- Receipt Images -->
    <view class="receipt-section mt-lg" wx:if="{{purchase.receiptImages.length > 0 || canEdit || canDelete}}">
      <text class="text-subtitle" style="display: block; color: {{theme.textSecondary || '#9A9AB0'}}; margin-bottom: 16rpx;">单据照片</text>
      <view style="background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}}; border-radius: 16rpx; padding: 20rpx;">
        <view class="receipt-header">
          <view class="receipt-header-right">
            <text class="receipt-count" style="color: {{theme.textMuted || '#5C5C72'}};">{{purchase.receiptImages.length || 0}}/3</text>
            <text class="receipt-add-link" style="color: {{theme.accentColor || '#C9A96E'}};" bindtap="onAddReceiptImage" wx:if="{{purchase.receiptImages.length < 3}}">+ 添加</text>
          </view>
        </view>
        <view class="receipt-grid">
          <view class="receipt-thumb" wx:for="{{purchase.receiptImages}}" wx:key="fileID" data-index="{{index}}" bindtap="onPreviewReceiptImage">
            <image class="receipt-thumb-image" src="{{item.fileID}}" mode="aspectFill" />
            <view class="receipt-thumb-del" data-index="{{index}}" catchtap="onRemoveReceiptImage">
              <text>×</text>
            </view>
          </view>
          <view class="receipt-add" wx:if="{{purchase.receiptImages.length < 3}}"
            style="background: rgba(201,169,110,0.1); border: 1.5rpx dashed rgba(201,169,110,0.4);"
            bindtap="onAddReceiptImage">
            <text class="receipt-add-icon" style="color: {{theme.accentColor || '#C9A96E'}};">+</text>
            <text class="receipt-add-text" style="color: {{theme.textMuted || '#5C5C72'}};">上传</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Approval Log Timeline - 3-step flow: 创建→审批→付款 -->
    <view class="log-section mt-lg">
      <text class="text-subtitle" style="display: block; color: {{theme.textSecondary || '#9A9AB0'}}; margin-bottom: 16rpx;">审批记录</text>
      <view class="log-list">
        <!-- Step 1: 采购创建 -->
        <view class="log-item" wx:if="{{purchase.purchaseByName || purchase.autoGenerated}}">
          <view class="log-step-badge" style="background: {{theme.accentColor || '#C9A96E'}};">
            <text style="color: {{theme.textInverse || '#0F0F1A'}};">创建</text>
          </view>
          <view class="log-body">
            <text class="log-action" style="color: {{theme.textPrimary || '#F5F0E8'}};">{{purchase.purchaseByName || '系统自动'}} 提交采购</text>
            <text class="log-time" style="color: {{theme.textMuted || '#5C5C72'}};">{{purchase.formattedCreatedAt}}</text>
          </view>
        </view>
        <!-- Step 2: 审批确认 -->
        <view class="log-item" wx:if="{{approvalStep.badge}}">
          <view class="log-step-badge" style="background: {{approvalStep.badgeBg}};">
            <text style="color: #fff;">{{approvalStep.badge}}</text>
          </view>
          <view class="log-body">
            <text class="log-action" style="color: {{theme.textPrimary || '#F5F0E8'}};">{{approvalStep.text}}</text>
            <text class="log-time" wx:if="{{approvalStep.time}}" style="color: {{theme.textMuted || '#5C5C72'}};">{{approvalStep.time}}</text>
          </view>
        </view>
        <!-- Step 3: 付款 -->
        <view class="log-item" wx:if="{{reimburseStep.badge}}">
          <view class="log-step-badge" style="background: {{reimburseStep.badgeBg}};">
            <text style="color: #fff;">{{reimburseStep.badge}}</text>
          </view>
          <view class="log-body">
            <text class="log-action" style="color: {{theme.textPrimary || '#F5F0E8'}};">{{reimburseStep.text}}</text>
            <text class="log-time" wx:if="{{reimburseStep.time}}" style="color: {{theme.textMuted || '#5C5C72'}};">{{reimburseStep.time}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Bottom Spacer -->
    <view style="height: 200rpx;"></view>
  </view>

  <!-- Loading State -->
  <view class="loading-container flex-col flex-center" wx:if="{{loading}}" style="padding-top: 400rpx;">
    <text style="color: {{theme.textMuted || '#5C5C72'}};">加载中...</text>
  </view>

  <!-- Fixed Bottom Action Bar -->
  <view class="bottom-bar" wx:if="{{!loading && purchase}}">
    <!-- Admin delete button (always available for admin/boss on any status) -->
    <!-- pending + isApprover → [编辑] [拒绝] [通过] -->
    <view class="bottom-bar-inner three-btns" wx:if="{{purchase.status === 'pending' && isApprover}}">
      <view wx:if="{{isAdmin}}" class="bar-btn bar-btn-danger" bindtap="onDelete">删除</view>
      <view wx:if="{{isSubmitter && canEdit}}" class="bar-btn bar-btn-outline" bindtap="onEdit">编辑</view>
      <view class="bar-btn bar-btn-danger" bindtap="onShowReject">拒绝</view>
      <view class="bar-btn bar-btn-primary bar-btn-primary-wide" bindtap="onApprove">通过</view>
    </view>
    <!-- pending + isSubmitter + !isApprover → [删除] [编辑] -->
    <view class="bottom-bar-inner two-btns" wx:elif="{{purchase.status === 'pending' && isSubmitter && !isApprover}}">
      <view wx:if="{{canDelete || isAdmin}}" class="bar-btn bar-btn-danger" bindtap="onDelete">删除</view>
      <view wx:if="{{canEdit}}" class="bar-btn bar-btn-primary bar-btn-primary-wide" bindtap="onEdit">编辑</view>
    </view>
    <!-- approved + canReimburse → [删除] [确认付款] -->
    <view class="bottom-bar-inner two-btns" wx:elif="{{purchase.status === 'approved' && canReimburse}}">
      <view wx:if="{{canDelete || isAdmin}}" class="bar-btn bar-btn-danger" bindtap="onDelete">删除</view>
      <view class="bar-btn bar-btn-primary bar-btn-primary-wide" bindtap="onReimburse">确认付款</view>
    </view>
    <!-- rejected + isSubmitter → [修改重提] -->
    <view class="bottom-bar-inner single-btn" wx:elif="{{purchase.status === 'rejected' && isSubmitter}}">
      <view class="bar-btn bar-btn-primary" bindtap="onResubmit">修改重提</view>
    </view>
    <!-- Admin delete on reimbursed/rejected/other statuses where no other bar is shown -->
    <view class="bottom-bar-inner single-btn" wx:elif="{{isAdmin}}">
      <view class="bar-btn bar-btn-danger" bindtap="onDelete">删除记录</view>
    </view>
  </view>

  <!-- Reject Reason Modal -->
  <theme-modal theme="{{theme}}" visible="{{showRejectModal}}" title="拒绝原因" confirmText="确认拒绝" cancelText="取消" bind:confirm="onRejectConfirm" bind:close="onRejectCancel">
    <view class="p-lg">
      <text style="color: {{theme.textSecondary || '#9A9AB0'}}; display: block; margin-bottom: 16rpx;">请输入拒绝原因：</text>
      <view class="reject-input-wrap">
        <input class="reject-input" value="{{rejectionReason}}" placeholder="请输入拒绝原因" placeholder-style="color: rgba(255,255,255,0.3);" bindinput="onRejectionReasonInput" style="background: {{theme.inputBg || 'rgba(255,255,255,0.06)'}}; color: {{theme.textPrimary || '#F5F0E8'}}; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.1)'}}; border-radius: 12rpx; padding: 20rpx 24rpx; font-size: 28rpx; width: 100%; box-sizing: border-box;" />
      </view>
    </view>
  </theme-modal>

  <!-- Delete Confirmation Modal (with required reason) -->
  <theme-modal theme="{{theme}}" visible="{{showDeleteModal}}" title="删除采购记录" confirmText="确认删除" cancelText="取消" bind:confirm="onDeleteConfirm" bind:close="onDeleteCancel">
    <view class="p-lg">
      <text style="color: {{theme.textSecondary || '#9A9AB0'}}; display: block; margin-bottom: 16rpx;">确定要删除此采购记录吗？删除后不可恢复。</text>
      <text style="color: #F87171; display: block; margin-bottom: 16rpx; font-size: 24rpx;">必须填写删除原因</text>
      <view class="reject-input-wrap">
        <textarea class="reject-input" value="{{deleteReason}}" placeholder="请输入删除原因（必填）" placeholder-style="color: rgba(255,255,255,0.3);" bindinput="onDeleteReasonInput" style="background: {{theme.inputBg || 'rgba(255,255,255,0.06)'}}; color: {{theme.textPrimary || '#F5F0E8'}}; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.1)'}}; border-radius: 12rpx; padding: 20rpx 24rpx; font-size: 28rpx; width: 100%; box-sizing: border-box; min-height: 120rpx;" auto-height maxlength="200" />
      </view>
    </view>
  </theme-modal>
</view>