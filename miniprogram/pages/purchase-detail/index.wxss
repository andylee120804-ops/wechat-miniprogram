@import '../../styles/mixins.wxss';
@import '../../styles/bottom-bar.wxss';

.page {
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* Navigation Bar */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-bar-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 44rpx;
  font-weight: 300;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
}

.nav-action {
  min-width: 64rpx;
}

/* Page Content */
.page-content {
  padding-top: calc(var(--status-bar-height, 44px) + 88rpx + 32rpx);
}

/* Hero Section */
.hero-section {
  overflow: hidden;
}

.hero-amount {
  line-height: 1.2;
}

.hero-badge {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Detail Rows */
.detail-row {
  align-items: center;
}

.detail-label {
  flex-shrink: 0;
}

.detail-value {
  flex: 1;
  text-align: right;
  margin-left: 32rpx;
}

/* Loading */
.loading-container {
  min-height: 60vh;
}

/* Hero Badge Row */
.hero-badge-row {
  gap: 12rpx;
}

/* Approval Log Timeline */
.log-section {
  padding: 0 8rpx;
}

.log-item {
  padding: 12rpx 0;
  border-left: 2rpx solid rgba(201, 169, 110, 0.3);
  padding-left: 24rpx;
  margin-left: 8rpx;
  position: relative;
}

.log-time {
  font-size: 24rpx;
  display: block;
}

.log-action {
  font-size: 26rpx;
  display: block;
  margin-top: 2rpx;
}

.log-remark {
  font-size: 24rpx;
  display: block;
  margin-top: 4rpx;
  opacity: 0.7;
}
