@import '../../styles/mixins.wxss';

.announcements-page {
  min-height: 100vh;
}

/* Navigation Bar */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-bar-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 44rpx;
  font-weight: 300;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
}

.nav-action {
  min-width: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.ann-item {
  transition: transform 0.15s ease;
}

.ann-item:active {
  transform: scale(0.98);
}

.ann-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ann-meta {
  display: flex;
  align-items: center;
}

.fab {
  position: fixed;
  bottom: 160rpx;
  right: 40rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.fab:active {
  transform: scale(0.93);
}

.modal-input, .modal-textarea {
  outline: none;
  font-family: inherit;
}

.date-picker-trigger {
  min-height: 60rpx;
  display: flex;
  align-items: center;
}

.toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
