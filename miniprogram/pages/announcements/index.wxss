.announcements-page {
  min-height: 100vh;
}

.ann-item {
  transition: transform 0.15s ease;
}

.ann-item:active {
  transform: scale(0.98);
}

.ann-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ann-meta {
  display: flex;
  align-items: center;
}

.fab {
  position: fixed;
  bottom: 160rpx;
  right: 40rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.fab:active {
  transform: scale(0.93);
}

.modal-input, .modal-textarea {
  outline: none;
  font-family: inherit;
}
