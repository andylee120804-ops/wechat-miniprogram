<view class="login-page" style="background: {{theme.headerGradient || 'linear-gradient(135deg, #1A1A2E, #252540)'}}; position: relative; left: 0rpx; top: 65rpx; height: 1619rpx; display: flex; box-sizing: border-box; width: 753rpx">
  <!-- Background decoration -->
  <view class="login-bg-decor">
    <view class="bg-circle circle-1" style="background: {{theme.accentColor || '#C9A96E'}}; opacity: 0.05;"></view>
    <view class="bg-circle circle-2" style="background: {{theme.accentColor || '#C9A96E'}}; opacity: 0.03;"></view>
  </view>

  <!-- Brand section -->
  <view class="login-brand safe-top" style="padding-top: {{statusBarHeight}}px; width: 648rpx; display: block; box-sizing: border-box; height: 291rpx">
    <text class="brand-name" style="color: {{theme.textPrimary || '#F5F0E8'}}; width: 648rpx; height: 181rpx; display: block; box-sizing: border-box; left: 0rpx; top: 0rpx">❤️ {{venueName || '听澜轩'}} ❤️</text>
    <text class="brand-subtitle" style="color: {{theme.textMuted || '#5C5C72'}}; position: relative; left: 0rpx; top: -54rpx">等风，也等你</text>
  </view>

  <!-- Login card -->
  <glass-card theme="{{theme}}" blur="24" opacity="0.08" padding="48rpx 40rpx" class="{{shakeAnimation ? 'shake' : ''}}" style="width: 529rpx; height: 789rpx; display: block; box-sizing: border-box; position: relative; left: 0rpx; top: 21rpx">
    <view class="login-form">
      <view class="form-title" style="color: {{theme.textPrimary || '#F0F0F5'}};">欢迎回来</view>
      <view class="form-subtitle" style="color: {{theme.textMuted || '#5C5C72'}};">请输入您的微信号登录</view>

      <view class="input-group" style="border-bottom: 2rpx solid {{theme.border || 'rgba(255,255,255,0.1)'}};">
        <text class="input-label" style="color: {{theme.textSecondary || '#9A9AB0'}};">微信号</text>
        <input class="login-input" placeholder="请输入微信号" placeholder-style="color: {{theme.textMuted || '#5C5C72'}}" value="{{wechatId}}" bindinput="onWechatIdInput" confirm-type="done" style="color: {{theme.textPrimary || '#F0F0F5'}};" />
      </view>

      <view class="input-group" style="border-bottom: 2rpx solid {{theme.border || 'rgba(255,255,255,0.1)'}};">
        <text class="input-label" style="color: {{theme.textSecondary || '#9A9AB0'}};">手机号(选填)</text>
        <input class="login-input" type="number" placeholder="请输入手机号" placeholder-style="color: {{theme.textMuted || '#5C5C72'}}" value="{{phone}}" bindinput="onPhoneInput" maxlength="11" style="color: {{theme.textPrimary || '#F0F0F5'}};" />
      </view>

      <view class="login-btn-wrap">
        <theme-btn style="position: relative; left: 35rpx; top: 0rpx" theme="{{theme}}" type="primary" text="登 录" block loading="{{loading}}" bind:tap="onLogin" />
      </view>

      <view class="login-hint" style="color: {{theme.textMuted || '#5C5C72'}};">
        如无账号请联系管理员注册
      </view>
    </view>
  </glass-card>
</view>
