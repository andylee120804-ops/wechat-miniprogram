.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
  position: relative;
  overflow: hidden;
}

.login-bg-decor {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  pointer-events: none;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
}

.circle-1 {
  width: 600rpx;
  height: 600rpx;
  top: -200rpx;
  right: -200rpx;
}

.circle-2 {
  width: 400rpx;
  height: 400rpx;
  bottom: -100rpx;
  left: -100rpx;
}

.login-brand {
  text-align: center;
  margin-bottom: 64rpx;
}

.brand-name {
  font-size: 64rpx;
  font-weight: 800;
  letter-spacing: 8rpx;
  display: block;
  margin-bottom: 16rpx;
}

.brand-subtitle {
  font-size: 26rpx;
  letter-spacing: 4rpx;
  display: block;
}

.login-form {
  width: 100%;
}

.form-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.form-subtitle {
  font-size: 26rpx;
  margin-bottom: 48rpx;
}

.input-group {
  margin-bottom: 32rpx;
  padding-bottom: 16rpx;
}

.input-label {
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  display: block;
  margin-bottom: 12rpx;
}

.login-input {
  font-size: 26rpx;
  height: 48rpx;
}

.login-btn-wrap {
  margin-top: 48rpx;
}

.login-hint {
  text-align: center;
  font-size: 24rpx;
  margin-top: 32rpx;
}

.shake {
  animation: shakeX 0.4s ease;
}

@keyframes shakeX {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-16rpx); }
  40% { transform: translateX(16rpx); }
  60% { transform: translateX(-10rpx); }
  80% { transform: translateX(10rpx); }
}
