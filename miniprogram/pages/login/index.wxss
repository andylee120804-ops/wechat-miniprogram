@import '../../styles/mixins.wxss';

.login-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
  position: relative;
  overflow: hidden;
}

.login-bg-decor {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  pointer-events: none;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
}

.circle-1 {
  width: 600rpx;
  height: 600rpx;
  top: -200rpx;
  right: -200rpx;
}

.circle-2 {
  width: 400rpx;
  height: 400rpx;
  bottom: -100rpx;
  left: -100rpx;
}

.login-brand {
  text-align: center;
  margin-bottom: 24rpx;
}

.brand-name {
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  display: block;
  margin-bottom: 6rpx;
  max-width: 90vw;
}

.brand-subtitle {
  font-size: 22rpx;
  letter-spacing: 3rpx;
  display: block;
}

.login-form {
  width: 100%;
}

.form-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.form-subtitle {
  font-size: 24rpx;
  margin-bottom: 32rpx;
}

.input-group {
  margin-bottom: 24rpx;
  padding-bottom: 12rpx;
}

.input-label {
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  display: block;
  margin-bottom: 12rpx;
}

.login-input {
  font-size: 26rpx;
  height: 48rpx;
}

.login-btn-wrap {
  margin-top: 32rpx;
  width: 100%;
}

.login-hint {
  text-align: center;
  font-size: 22rpx;
  margin-top: 24rpx;
}

.login-card {
  width: 100% !important;
  max-width: 560rpx;
}

.shake {
  animation: shakeX 0.4s ease;
}

/* Auto-login overlay */
.auto-login-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.auto-login-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.auto-login-icon {
  width: 72rpx;
  height: 72rpx;
  border: 4rpx solid rgba(201, 169, 110, 0.3);
  border-top-color: #C9A96E;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.auto-login-text {
  font-size: 28rpx;
  color: #F0F0F5;
  letter-spacing: 2rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

@keyframes shakeX {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-16rpx); }
  40% { transform: translateX(16rpx); }
  60% { transform: translateX(-10rpx); }
  80% { transform: translateX(10rpx); }
}
