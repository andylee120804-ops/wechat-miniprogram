<view class="detail-page" style="background: {{theme.surface || '#1A1A2E'}}; min-height: 100vh; padding-top: {{statusBarHeight + 44}}px;">
  <!-- Custom Navigation Bar -->
  <view class="nav-bar" style="background: {{theme.gradientHeader || theme.surfaceColor || '#1A1A2E'}}; padding-top: {{statusBarHeight}}px; height: {{statusBarHeight + 44}}px; box-sizing: border-box;">
    <view class="nav-bar-content">
      <view class="nav-back" bindtap="onBack">
        <text class="nav-back-icon" style="color: {{theme.textPrimary || '#F5F0E8'}}">❮</text>
      </view>
      <text class="nav-title" style="color: {{theme.textPrimary || '#F5F0E8'}};">收入详情</text>
      <view class="nav-action"></view>
    </view>
  </view>
  <block wx:if="{{!loading && income}}">
    <!-- Amount Hero -->
    <view class="amount-hero" style="background: linear-gradient(135deg, rgba(74,222,128,0.15), rgba(74,222,128,0.03)); padding: 48rpx 32rpx;">
      <theme-badge theme="{{theme}}" status="{{income.type}}" type="status" text="{{income.typeName}}" size="lg" />
      <text class="amount-display" style="color: {{theme.amountPositive || '#4ADE80'}}; font-size: 56rpx; font-weight: 800; font-family: 'DIN Alternate', monospace; margin-top: 16rpx; display: block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">+¥{{income.formattedAmount}}</text>
      <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 26rpx; margin-top: 12rpx; display: block;">{{income.formattedDate}}</text>
    </view>

    <!-- Detail Card -->
    <view class="detail-content-wrapper" style="padding: 32rpx 32rpx 180rpx;">
      <theme-card theme="{{theme}}" padding="32rpx">
        <view class="detail-row">
          <text class="detail-label" style="color: {{theme.textMuted || '#5C5C72'}};">来源</text>
          <text style="color: {{theme.textPrimary || '#F0F0F5'}}; font-size: 28rpx;">{{income.source || '无来源'}}</text>
        </view>
        <view class="detail-row" wx:if="{{income.guestCount}}">
          <text class="detail-label" style="color: {{theme.textMuted || '#5C5C72'}};">人数</text>
          <text style="color: {{theme.textPrimary || '#F0F0F5'}}; font-size: 28rpx;">{{income.guestCount}}人</text>
        </view>
        <view class="detail-row" wx:if="{{income.standard}}">
          <text class="detail-label" style="color: {{theme.textMuted || '#5C5C72'}};">餐标</text>
          <text style="color: {{theme.textPrimary || '#F0F0F5'}}; font-size: 28rpx;">¥{{income.standard}}/人</text>
        </view>
        <view class="detail-row" wx:if="{{income.roomName}}">
          <text class="detail-label" style="color: {{theme.textMuted || '#5C5C72'}};">房间</text>
          <text style="color: {{theme.textPrimary || '#F0F0F5'}}; font-size: 28rpx;">{{income.roomName}}</text>
        </view>
        <view class="detail-row" wx:if="{{income.calcMode === 'dishPrice'}}">
          <text class="detail-label" style="color: {{theme.textMuted || '#5C5C72'}};">计算方式</text>
          <text style="color: {{theme.accentColor || '#C9A96E'}}; font-size: 28rpx;">菜价+服务费</text>
        </view>
        <view class="detail-row" wx:if="{{income.calcMode === 'dishPrice' && income.dishPrice > 0}}">
          <text class="detail-label" style="color: {{theme.textMuted || '#5C5C72'}};">预定菜价</text>
          <text style="color: {{theme.textPrimary || '#F0F0F5'}}; font-size: 28rpx;">¥{{income.dishPrice}}</text>
        </view>
        <view class="detail-row" wx:if="{{income.calcMode === 'dishPrice' && income.serviceCharge > 0}}">
          <text class="detail-label" style="color: {{theme.textMuted || '#5C5C72'}};">服务费</text>
          <text style="color: {{theme.textPrimary || '#F0F0F5'}}; font-size: 28rpx;">¥{{income.serviceCharge}}</text>
        </view>
        <view class="detail-row" wx:if="{{income.collectedByName}}">
          <text class="detail-label" style="color: {{theme.textMuted || '#5C5C72'}};">收款人</text>
          <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 28rpx;">{{income.collectedByName}}</text>
        </view>
        <view class="detail-row" wx:if="{{income.remark && !reservation}}">
          <text class="detail-label" style="color: {{theme.textMuted || '#5C5C72'}};">备注</text>
          <text style="color: {{theme.textPrimary || '#F0F0F5'}}; font-size: 28rpx; flex: 1; text-align: right;">{{income.remark}}</text>
        </view>
      </theme-card>

      <!-- Linked Reservation -->
      <theme-card theme="{{theme}}" padding="32rpx" style="margin-top: 24rpx;" wx:if="{{reservation}}">
        <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx;">
          <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 24rpx; font-weight: 500;">关联预约</text>
          <view style="display: inline-flex; align-items: center; background: {{reservation.status === 'cancelled' ? 'rgba(248,113,113,0.15)' : 'rgba(74,222,128,0.15)'}}; padding: 6rpx 16rpx; border-radius: 100rpx;">
            <view style="width: 10rpx; height: 10rpx; border-radius: 50%; background: {{reservation.status === 'cancelled' ? '#F87171' : '#4ADE80'}}; margin-right: 8rpx;"></view>
            <text style="color: {{reservation.status === 'cancelled' ? '#F87171' : '#4ADE80'}}; font-size: 22rpx; font-weight: 500;">{{reservation.statusText}}</text>
          </view>
        </view>
        <view style="background: {{theme.glassBg || 'rgba(255,255,255,0.04)'}}; border-radius: 16rpx; padding: 24rpx; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.08)'}};">
          <view style="margin-bottom: 20rpx;">
            <text style="color: {{theme.textPrimary || '#F0F0F5'}}; font-size: 34rpx; font-weight: 700;">{{reservation.customerName}}</text>
          </view>
          <view style="display: flex; flex-wrap: nowrap; gap: 12rpx; margin-bottom: 16rpx; overflow: hidden;">
            <view style="display: flex; align-items: center; background: rgba(255,255,255,0.05); padding: 6rpx 12rpx; border-radius: 8rpx; flex-shrink: 0;">
              <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 22rpx;">📅</text>
              <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 22rpx; margin-left: 6rpx;">{{reservation.dateDisplay}}</text>
            </view>
            <view style="display: flex; align-items: center; background: rgba(255,255,255,0.05); padding: 6rpx 12rpx; border-radius: 8rpx; flex-shrink: 0;">
              <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 22rpx;">⏰</text>
              <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 22rpx; margin-left: 6rpx;">{{reservation.time}}</text>
            </view>
            <view style="display: flex; align-items: center; background: rgba(255,255,255,0.05); padding: 6rpx 12rpx; border-radius: 8rpx; flex-shrink: 0;">
              <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 22rpx;">👥</text>
              <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 22rpx; margin-left: 6rpx;">{{reservation.guestCount}}人</text>
            </view>
            <view style="display: flex; align-items: center; background: rgba(255,255,255,0.05); padding: 6rpx 12rpx; border-radius: 8rpx; flex-shrink: 0;">
              <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 22rpx;">🚪</text>
              <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 22rpx; margin-left: 6rpx;">{{reservation.roomNameDisplay}}</text>
            </view>
          </view>
          <view wx:if="{{reservation.phone}}" style="padding: 10rpx 0; border-top: 1rpx solid rgba(255,255,255,0.06);">
            <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 22rpx;">📞 </text>
            <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 22rpx;">{{reservation.phone}}</text>
          </view>
          <view wx:if="{{reservation.dishPrice > 0}}" style="padding: 10rpx 0; border-top: 1rpx solid rgba(255,255,255,0.06);">
            <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 22rpx;">菜价 </text>
            <text style="color: {{theme.accentColor || '#C9A96E'}}; font-size: 22rpx; font-weight: 600;">¥{{reservation.dishPrice}}</text>
          </view>
          <view style="padding: 10rpx 0; border-top: 1rpx solid rgba(255,255,255,0.06);">
            <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 22rpx;">人均 </text>
            <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 22rpx;">¥{{reservation.standard}}/人</text>
          </view>
          <view wx:if="{{reservation.remark}}" style="padding: 10rpx 0; border-top: 1rpx solid rgba(255,255,255,0.06);">
            <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 22rpx;">备注 </text>
            <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 22rpx;">{{reservation.remark}}</text>
          </view>
        </view>
      </theme-card>
    </view>

    <!-- Action Bar -->
    <view class="bottom-bar">
      <view class="bottom-bar-inner two-btns">
        <view wx:if="{{canDelete}}" class="bar-btn bar-btn-danger" bindtap="onDelete">删除</view>
        <view wx:if="{{canEdit}}" class="bar-btn bar-btn-primary bar-btn-primary-wide" bindtap="onEdit">编辑</view>
      </view>
    </view>

    <!-- Delete Modal -->
    <theme-modal theme="{{theme}}" visible="{{showDeleteModal}}" title="删除收入" confirmText="确认删除" cancelText="返回" bind:confirm="onConfirmDelete" bind:close="onCloseDelete">
      <view style="padding: 16rpx 0;">
        <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 28rpx;">确定要删除此收入记录吗？删除后无法恢复。</text>
      </view>
    </theme-modal>
  </block>

  <view wx:if="{{loading}}" style="display: flex; align-items: center; justify-content: center; height: 60vh;">
    <text style="color: {{theme.textMuted || '#5C5C72'}};">加载中...</text>
  </view>
</view>
