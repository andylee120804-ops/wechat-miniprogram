<view class="income-add-page" style="background: {{theme.surface || '#1A1A2E'}}; min-height: 100vh; padding-bottom: 140rpx;">
  <!-- Custom Navigation Bar -->
  <view class="nav-bar" style="background: {{theme.gradientHeader || theme.surfaceColor || '#1A1A2E'}}; padding-top: {{statusBarHeight}}px; height: {{statusBarHeight + 44}}px; box-sizing: border-box;">
    <view class="nav-bar-content">
      <view class="nav-back" bindtap="onBack">
        <text class="nav-back-icon" style="color: {{theme.textPrimary || '#F5F0E8'}}">❮</text>
      </view>
      <text class="nav-title" style="color: {{theme.textPrimary || '#F5F0E8'}};">{{isEdit ? '编辑收入' : '新增收入'}}</text>
      <view class="nav-action"></view>
    </view>
  </view>
  <view style="padding: 32rpx; padding-top: {{statusBarHeight + 44}}px;">
    <!-- Income Type -->
    <theme-card theme="{{theme}}" padding="32rpx">
      <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 24rpx; font-weight: 500; display: block; margin-bottom: 20rpx;">收入类型</text>
      <view class="type-grid">
        <view class="type-pill {{type === item.value ? 'active' : ''}}" wx:for="{{typeOptions}}" wx:key="value" data-value="{{item.value}}" bindtap="selectType" style="{{type === item.value ? 'background:' + (theme.accentColor || '#C9A96E') + ';color:' + (theme.textInverse || '#0F0F1A') + ';' : 'background:' + (theme.elevated || '#252540') + ';color:' + (theme.textSecondary || '#9A9AB0') + ';'}}">
          <text style="font-size: 28rpx; font-weight: 600;">{{item.label}}</text>
        </view>
      </view>
    </theme-card>

    <!-- Date Picker -->
    <theme-card theme="{{theme}}" padding="32rpx" style="margin-top: 24rpx;">
      <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 24rpx; font-weight: 500; display: block; margin-bottom: 20rpx;">日期</text>
      <picker mode="date" value="{{date}}" bindchange="onDateChange">
        <view class="date-display flex-row flex-between" style="background: {{theme.elevated || '#252540'}}; border-radius: 12rpx; padding: 20rpx 24rpx; border: 1rpx solid {{theme.border || 'rgba(255,255,255,0.10)'}};">
          <text style="color: {{theme.textPrimary || '#F5F0E8'}};">{{date}}</text>
          <text style="color: {{theme.textMuted || '#5C5C72'}};">▾</text>
        </view>
      </picker>
    </theme-card>

    <!-- Reservation Link -->
    <theme-card theme="{{theme}}" padding="32rpx" style="margin-top: 24rpx;">
      <view class="toggle-row">
        <text style="color: {{theme.textPrimary || '#F0F0F5'}}; font-size: 30rpx; font-weight: 600;">关联预约</text>
        <switch checked="{{!noReservation}}" bindchange="toggleNoReservation" color="{{theme.accentColor || '#C9A96E'}}" />
      </view>

      <block wx:if="{{!noReservation}}">
        <view class="picker-wrap" wx:if="{{recentReservations.length > 0}}">
          <picker mode="selector" range="{{pickerItems}}" bindchange="onReservationPickerChange">
            <view class="picker-display" style="background: {{theme.elevated || '#252540'}}; border-radius: 12rpx; padding: 20rpx 24rpx; border: 1rpx solid {{theme.border || 'rgba(255,255,255,0.10)'}}; display: flex; justify-content: space-between; align-items: center;">
              <text style="color: {{pickerIndex >= 0 ? theme.textPrimary || '#F0F0F5' : theme.textMuted || '#5C5C72'}}; font-size: 28rpx;">{{pickerIndex >= 0 ? pickerItems[pickerIndex] : '请选择预约'}}</text>
              <text style="color: {{theme.textMuted || '#5C5C72'}}; margin-left: 8rpx;">▾</text>
            </view>
          </picker>
          <view wx:if="{{selectedReservation}}" class="selected-res-info" style="margin-top: 16rpx; padding: 16rpx 20rpx; background: rgba(201,169,110,0.08); border-radius: 12rpx; border: 1rpx solid {{theme.accentColor || '#C9A96E'}};">
            <text style="color: {{theme.textPrimary || '#F0F0F5'}}; font-size: 26rpx;">{{selectedReservation.customerName}} · {{selectedReservation.guestCount}}人 · ¥{{selectedReservation.standard}}/人</text>
          </view>
        </view>
        <text wx:else style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 26rpx; display: block; margin-top: 16rpx;">暂无可关联的预约</text>
      </block>
    </theme-card>

    <!-- Amount -->
    <theme-card theme="{{theme}}" padding="32rpx" style="margin-top: 24rpx;">
      <theme-form-item theme="{{theme}}" label="金额">
        <input class="amount-input" type="digit" placeholder="请输入金额" placeholder-style="color: {{theme.textMuted || '#5C5C72'}};" value="{{amount}}" bindinput="onAmountInput" style="color: {{theme.textPrimary || '#F0F0F5'}}; font-size: 36rpx; font-weight: 700; font-family: 'DIN Alternate', monospace; height: 48rpx;" />
      </theme-form-item>
    </theme-card>

    <!-- Remark -->
    <theme-card theme="{{theme}}" padding="32rpx" style="margin-top: 24rpx;">
      <theme-form-item theme="{{theme}}" label="备注">
        <textarea class="remark-input" placeholder="请输入备注(选填)" placeholder-style="color: {{theme.textMuted || '#5C5C72'}};" value="{{remark}}" bindinput="onRemarkInput" style="color: {{theme.textPrimary || '#F0F0F5'}}; font-size: 28rpx; min-height: 120rpx; width: 100%;" />
      </theme-form-item>
    </theme-card>
  </view>

  <!-- Fixed Bottom Bar -->
  <view class="bottom-bar safe-bottom">
    <view class="bottom-bar-inner single-btn">
      <view class="bar-btn bar-btn-primary" bindtap="onSubmit" style="position: relative; left: -3rpx; top: -13rpx">{{isEdit ? '保存修改' : '记录收入'}}</view>
    </view>
  </view>
</view>
