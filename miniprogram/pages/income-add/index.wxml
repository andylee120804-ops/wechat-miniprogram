<view class="page" style="background: {{theme.surfaceColor || '#1A1A2E'}};">
  <!-- Custom Navigation Bar -->
  <view class="nav-bar" style="background: {{theme.gradientHeader || theme.surfaceColor}}; padding-top: {{statusBarHeight}}px; height: {{statusBarHeight + 44}}px; box-sizing: border-box;">
    <view class="nav-bar-content">
      <view class="nav-back" bindtap="onBack">
        <text class="nav-back-icon" style="color: {{theme.textPrimary || '#F5F0E8'}}">❮</text>
      </view>
      <text class="nav-title" style="color: {{theme.textPrimary || '#F5F0E8'}};">{{isEdit ? '编辑收入' : '新增收入'}}</text>
      <view class="nav-action"></view>
    </view>
  </view>

  <view class="page-content px-lg pt-xl">
    <!-- Income Type -->
    <view style="background: {{theme.elevated || '#252540'}}; border-radius: 10rpx; padding: 14rpx 20rpx; margin-top: 16rpx; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}};">
      <view class="flex-row" style="align-items: center; margin-bottom: 10rpx;">
        <text style="font-size: 28rpx; margin-right: 8rpx;">🏷️</text>
        <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 26rpx;">收入类型</text>
      </view>
      <view class="type-grid flex-row flex-wrap" style="gap: 10rpx;">
        <view class="type-pill {{type === item.value ? 'active' : ''}}" wx:for="{{typeOptions}}" wx:key="value" data-value="{{item.value}}" bindtap="selectType"
          style="{{type === item.value ? 'background:' + (theme.accentColor || '#C9A96E') + ';color:' + (theme.textInverse || '#0F0F1A') + ';' : 'background:' + (theme.surfaceColor || '#1A1A2E') + ';color:' + (theme.textSecondary || '#9A9AB0') + ';'}}; border-radius: 8rpx; padding: 8rpx 18rpx;">
          <text style="font-size: 24rpx;">{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- Date & Reservation Row -->
    <view style="border-radius: 10rpx; margin-top: 12rpx; gap: 12rpx;">
      <view class="flex-row flex-between" style="background: {{theme.elevated || '#252540'}}; border-radius: 10rpx; padding: 14rpx 20rpx; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}};">
        <view class="flex-row" style="align-items: center;">
          <text style="font-size: 28rpx; margin-right: 8rpx;">📅</text>
          <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 26rpx;">日期</text>
        </view>
        <picker mode="date" value="{{date}}" bindchange="onDateChange">
          <view class="flex-row" style="align-items: center;">
            <text style="color: {{theme.textPrimary || '#F5F0E8'}}; font-size: 26rpx;">{{date}}</text>
            <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 22rpx; margin-left: 8rpx;">▾</text>
          </view>
        </picker>
      </view>
      <view class="flex-row flex-between" wx:if="{{!noReservation}}" style="background: {{theme.elevated || '#252540'}}; border-radius: 10rpx; padding: 14rpx 20rpx; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}};">
        <view class="flex-row" style="align-items: center; flex-shrink: 0;">
          <text style="font-size: 28rpx; margin-right: 8rpx;">📋</text>
          <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 26rpx;">关联预约</text>
        </view>
        <block wx:if="{{recentReservations.length > 0}}">
          <picker mode="selector" range="{{pickerItems}}" bindchange="onReservationPickerChange" style="flex:1">
            <view class="flex-row" style="align-items: center; justify-content: flex-end;">
              <text style="color: {{pickerIndex >= 0 ? theme.textPrimary || '#F5F0E8' : theme.textMuted || '#5C5C72'}}; font-size: 24rpx;">{{pickerIndex >= 0 ? pickerItems[pickerIndex] : ''}}</text>
              <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 20rpx; margin-left: 4rpx; flex-shrink:0;">▾</text>
            </view>
          </picker>
        </block>
        <text wx:else style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 24rpx;">暂无</text>
      </view>
    </view>

    <!-- Amount -->
    <view style="background: {{theme.elevated || '#252540'}}; border-radius: 10rpx; padding: 20rpx; margin-top: 12rpx; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}};">
      <view class="flex-row" style="align-items: center; margin-bottom: 8rpx;">
        <text style="font-size: 28rpx; margin-right: 8rpx;">💰</text>
        <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 26rpx;">金额</text>
      </view>
      <view style="display: flex; align-items: baseline;">
        <text style="color: {{theme.amountPositive || '#4ADE80'}}; font-size: 36rpx; font-weight: 600; margin-right: 6rpx; flex-shrink: 0;">¥</text>
        <input type="digit" placeholder="0.00" placeholder-style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 44rpx; font-weight: 600;"
          value="{{amount}}" bindinput="onAmountInput" disabled="{{isStoredValueIncome}}"
          style="color: {{theme.amountPositive || '#4ADE80'}}; text-align: left; width: 100%; font-size: 44rpx; font-weight: 600; height: 57rpx; display: block; box-sizing: border-box" />
      </view>
      <text wx:if="{{isStoredValueIncome}}" style="display: block; color: {{theme.warningColor || '#F59E0B'}}; font-size: 24rpx; margin-top: 10rpx;">储值关联收入不可直接编辑，请在储值流水中处理。</text>
    </view>

    <!-- Stored Value Preview -->
    <view wx:if="{{storedValueConflictMessage}}" class="stored-value-warning" style="background: {{theme.elevated || '#252540'}}; border-color: {{theme.warningColor || '#F59E0B'}};">
      <text class="stored-value-warning-title" style="color: {{theme.warningColor || '#F59E0B'}};">储值账户冲突</text>
      <text class="stored-value-warning-text" style="color: {{theme.textSecondary || '#9A9AB0'}};">{{storedValueConflictMessage}}</text>
    </view>

    <view wx:elif="{{storedValuePreview}}" class="stored-value-preview" style="background: {{theme.elevated || '#252540'}}; border-color: {{theme.borderColor || 'rgba(255,255,255,0.10)'}};">
      <view class="stored-value-header">
        <text class="stored-value-title" style="color: {{theme.textPrimary || '#F5F0E8'}};">储值结算预览</text>
        <text class="stored-value-badge" style="background: {{theme.accentColor || '#C9A96E'}}; color: {{theme.textInverse || '#0F0F1A'}};">自动抵扣</text>
      </view>
      <view class="stored-value-row">
        <text class="stored-value-label" style="color: {{theme.textSecondary || '#9A9AB0'}};">账户余额</text>
        <text class="stored-value-value" style="color: {{theme.textPrimary || '#F5F0E8'}};">¥{{storedValuePreview.balanceText}}</text>
      </view>
      <view class="stored-value-row">
        <text class="stored-value-label" style="color: {{theme.textSecondary || '#9A9AB0'}};">原始金额</text>
        <text class="stored-value-value" style="color: {{theme.textPrimary || '#F5F0E8'}};">¥{{storedValuePreview.originalAmountText}}</text>
      </view>
      <view class="stored-value-row">
        <text class="stored-value-label" style="color: {{theme.textSecondary || '#9A9AB0'}};">储值抵扣</text>
        <text class="stored-value-value stored-value-deduct" style="color: {{theme.amountNegative || '#F87171'}};">-¥{{storedValuePreview.deductedText}}</text>
      </view>
      <view class="stored-value-divider" style="background: {{theme.borderColor || 'rgba(255,255,255,0.10)'}};"></view>
      <view class="stored-value-row stored-value-total">
        <text class="stored-value-label" style="color: {{theme.textPrimary || '#F5F0E8'}};">本次实收</text>
        <text class="stored-value-income" style="color: {{theme.amountPositive || '#4ADE80'}};">¥{{storedValuePreview.incomeAmountText}}</text>
      </view>
    </view>

    <!-- Remark -->
    <view style="background: {{theme.elevated || '#252540'}}; border-radius: 10rpx; padding: 14rpx 20rpx; margin-top: 12rpx; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}};">
      <view class="flex-row" style="align-items: center; margin-bottom: 10rpx;">
        <text style="font-size: 28rpx; margin-right: 8rpx;">📝</text>
        <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 26rpx;">备注</text>
      </view>
      <textarea placeholder="选填" placeholder-style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 26rpx;"
        value="{{remark}}" bindinput="onRemarkInput" maxlength="200"
        style="color: {{theme.textPrimary || '#F5F0E8'}}; background: {{theme.surfaceColor || '#1A1A2E'}}; border-radius: 8rpx; padding: 16rpx; min-height: 100rpx; max-height: 100rpx; width: 100%; box-sizing: border-box;" />
    </view>

    <!-- Bottom Spacer for fixed bar -->
    <view style="height: 200rpx;"></view>
  </view>

  <!-- Fixed Bottom Bar -->
  <view class="bottom-bar">
    <view class="bottom-bar-inner single-btn">
      <view class="bar-btn bar-btn-primary bar-btn-primary-wide {{submitting ? 'bar-btn-disabled' : ''}}" bindtap="onSubmit">
        <text wx:if="{{submitting}}">保存中...</text>
        <text wx:elif="{{isEdit}}">保存修改</text>
        <text wx:else>记录收入</text>
      </view>
    </view>
  </view>

  <!-- No Dish Price Modal -->
  <theme-modal
    theme="{{theme}}"
    visible="{{showNoDishPriceModal}}"
    title="菜价未填写"
    showFooter="{{false}}"
    bind:close="onCloseNoDishPriceModal"
  >
    <view style="padding: 16rpx 0;">
      <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 28rpx;">该预约未填写预定菜价，请手动输入收入金额。</text>
    </view>
  </theme-modal>
</view>
