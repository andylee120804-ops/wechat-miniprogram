@import '../../styles/mixins.wxss';
@import '../../styles/bottom-bar.wxss';

/* Navigation Bar */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-bar-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 44rpx;
  font-weight: 300;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
}

.nav-action {
  min-width: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.income-add-page {
  min-height: 100vh;
}

/* Page Content - offset for fixed nav bar */
.page-content {
  padding-top: calc(var(--status-bar-height, 44px) + 88rpx + 32rpx);
}

.type-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.type-pill {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  transition: all 0.2s ease;
  border: 2rpx solid transparent;
}

.toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.amount-input {
  width: 100%;
}

.remark-input {
  width: 100%;
  border: none;
  outline: none;
  resize: none;
  padding: 0;
  background: transparent;
}
