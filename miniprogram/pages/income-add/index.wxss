@import '../../styles/mixins.wxss';
@import '../../styles/bottom-bar.wxss';

/* Navigation Bar */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-bar-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 44rpx;
  font-weight: 300;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
}

.nav-action {
  min-width: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.income-add-page {
  min-height: 100vh;
}

/* Page Content - offset for fixed nav bar */
.page-content {
  padding-top: calc(var(--status-bar-height, 44px) + 88rpx + 32rpx);
}

.type-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.type-pill {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  transition: all 0.2s ease;
  border: 2rpx solid transparent;
}

.toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.amount-input {
  width: 100%;
}

.remark-input {
  width: 100%;
  border: none;
  outline: none;
  resize: none;
  padding: 0;
  background: transparent;
}

.stored-value-warning,
.stored-value-preview {
  margin-top: 12rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid;
  border-radius: 10rpx;
}

.stored-value-warning {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.stored-value-warning-title {
  font-size: 26rpx;
  font-weight: 600;
}

.stored-value-warning-text {
  font-size: 24rpx;
  line-height: 1.5;
}

.stored-value-header,
.stored-value-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stored-value-header {
  margin-bottom: 12rpx;
}

.stored-value-title {
  font-size: 28rpx;
  font-weight: 600;
}

.stored-value-badge {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.stored-value-row {
  min-height: 46rpx;
}

.stored-value-label {
  font-size: 24rpx;
}

.stored-value-value {
  font-size: 26rpx;
  font-weight: 500;
}

.stored-value-deduct {
  font-weight: 600;
}

.stored-value-divider {
  height: 1rpx;
  margin: 10rpx 0;
}

.stored-value-total {
  min-height: 54rpx;
}

.stored-value-income {
  font-size: 34rpx;
  font-weight: 700;
}
