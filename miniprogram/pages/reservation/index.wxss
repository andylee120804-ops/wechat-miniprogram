@import '../../styles/mixins.wxss';

/* Navigation Bar */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-bar-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 44rpx;
  font-weight: 300;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
}

.nav-action {
  min-width: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.page {
  min-height: 100vh;
}

/* Calendar Section - takes ~55% viewport */
.calendar-section {
  padding: 24rpx 24rpx 0;
}

/* Date Label */
.date-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 8rpx;
}

.date-text {
  font-size: 32rpx;
  font-weight: 600;
}

.date-count {
  font-size: 24rpx;
}

/* List Section */
.list-section {
  padding: 0 24rpx;
}

/* Room Group */
.room-group {
  margin-bottom: 24rpx;
}

.room-pill {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 24rpx;
  border-radius: 100rpx;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

/* Reservation Cards */
.reservation-cards {
  padding-left: 8rpx;
}

.reservation-card {
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  transition: transform 0.2s ease;
}

.reservation-card:active {
  transform: scale(0.98);
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.time-pill {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;
  border-radius: 100rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.card-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.customer-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.customer-name {
  font-size: 30rpx;
  font-weight: 600;
}

.stored-value-marker {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border: 1rpx solid;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.3;
}

.card-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.meta-item {
  font-size: 24rpx;
}

.meta-divider {
  font-size: 20rpx;
  opacity: 0.5;
}

/* Cancelled reservation - grey + strikethrough */
.reservation-card.cancelled {
  opacity: 0.6;
}

.reservation-card.cancelled .customer-name {
  text-decoration: line-through;
  color: #5C5C72 !important;
}

.reservation-card.cancelled .meta-item {
  color: #5C5C72 !important;
}

.reservation-card.cancelled .time-pill {
  background: rgba(150,150,170,0.15) !important;
  color: #9A9AB0 !important;
}

/* FAB Button */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(136rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 80;
  border: 2rpx solid rgba(201, 169, 110, 0.35);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.fab::after {
  content: '';
  position: absolute;
  top: -6rpx;
  left: -6rpx;
  right: -6rpx;
  bottom: -6rpx;
  border-radius: 62rpx;
  background: radial-gradient(circle at 30% 30%, rgba(201, 169, 110, 0.25) 0%, transparent 70%);
  z-index: -1;
  pointer-events: none;
}

.fab:active {
  transform: scale(0.90);
}

.fab-icon {
  font-size: 52rpx;
  font-weight: 400;
  line-height: 1;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.15);
}

/* Blocked Date Banner */
.blocked-banner {
  margin: 0 24rpx 16rpx;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
}

.blocked-banner-text {
  font-size: 26rpx;
  font-weight: 500;
}

/* Block Date Modal */
.block-modal-body {
  padding: 8rpx 0 16rpx;
}

.block-modal-section {
  margin-bottom: 24rpx;
}

.block-modal-label {
  display: block;
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.block-scope-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.block-pill {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: rgba(255, 255, 255, 0.06);
  color: #9A9AB0;
}

.block-pill.active {
  background: rgba(201, 169, 110, 0.18);
  color: #C9A96E;
  border: 1rpx solid rgba(201, 169, 110, 0.45);
}

.block-reason-input {
  height: 72rpx;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.block-reason-placeholder {
  color: #6B6B80;
}

.block-radio-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-top: 8rpx;
}

.block-radio {
  flex: 1;
  padding: 14rpx 0;
  text-align: center;
  border-radius: 12rpx;
  font-size: 26rpx;
  background: rgba(255, 255, 255, 0.06);
  color: #9A9AB0;
}

.block-radio.active {
  background: rgba(46, 204, 113, 0.15);
  color: #2ECC71;
  border: 1rpx solid rgba(46, 204, 113, 0.4);
}

.block-info-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.block-info-label {
  font-size: 26rpx;
}

.block-info-value {
  font-size: 26rpx;
  font-weight: 600;
}

.block-unblock-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-top: 24rpx;
}

.unblock-btn {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: rgba(192, 57, 43, 0.15);
  color: #E74C3C;
  border: 1rpx solid rgba(192, 57, 43, 0.35);
}
