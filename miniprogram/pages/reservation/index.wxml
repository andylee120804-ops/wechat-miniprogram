<view class="page" style="background: {{theme.surfaceColor || '#1A1A2E'}}; min-height: 100vh;">
  <!-- Custom Navigation Bar -->
  <view class="nav-bar" style="background: {{theme.gradientHeader || theme.surfaceColor || '#1A1A2E'}}; padding-top: {{statusBarHeight}}px; height: {{statusBarHeight + 44}}px; box-sizing: border-box;">
    <view class="nav-bar-content">
      <view class="nav-action"></view>
      <text class="nav-title" style="color: {{theme.textPrimary || '#F5F0E8'}};">预约管理</text>
      <view class="nav-action"></view>
    </view>
  </view>
  <!-- Calendar Section -->
  <view class="calendar-section" style="padding-top: {{statusBarHeight + 44 + 12}}px; width: 750rpx; display: block; box-sizing: border-box">
    <calendar
      theme="{{theme}}"
      year="{{currentYear}}"
      month="{{currentMonth}}"
      markDates="{{markDates}}"
      selectedDate="{{selectedDate}}"
      bind:daytap="onDayTap"
      bind:monthchange="onMonthChange"
    />
  </view>

  <!-- Selected Date Label -->
  <view class="date-label" style="height: 87rpx; display: flex; box-sizing: border-box">
    <text class="date-text" style="color: {{theme.textPrimary || '#F5F0E8'}};">{{selectedDate}}</text>
    <text class="date-count" style="color: {{theme.textMuted || 'rgba(245,240,232,0.40)'}};">{{reservations.length}}个预约</text>
  </view>

  <!-- Loading Skeleton -->
  <view class="list-section" wx:if="{{loading}}">
    <skeleton theme="{{theme}}" type="list" count="{{3}}" />
  </view>

  <!-- Reservation List -->
  <view class="list-section" wx:elif="{{reservations.length > 0}}">
    <block wx:for="{{groupedReservationsDynamic}}" wx:key="key">
      <view wx:if="{{item.items.length > 0}}" class="room-group">
        <view class="room-pill" style="background: {{item.color}}; color: {{item.textColor}};">
          {{item.label}}
        </view>
        <view class="reservation-cards">
          <view
            class="reservation-card {{inner.status === 'cancelled' ? 'cancelled' : ''}}"
            wx:for="{{item.items}}"
            wx:for-item="inner"
            wx:key="_id"
            data-id="{{inner._id}}"
            bindtap="onReservationTap"
            style="background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border: 1rpx solid {{theme.border || 'rgba(255,255,255,0.10)'}}; box-shadow: {{theme.shadowMd || '0 8rpx 24rpx rgba(0,0,0,0.28)'}};"
          >
            <view class="card-top">
              <view class="time-pill" style="background: {{inner.status === 'cancelled' ? 'rgba(150,150,170,0.3)' : theme.accentColor || '#C9A96E'}}; color: {{inner.status === 'cancelled' ? '#9A9AB0' : theme.textInverse || '#0F0F1A'}};">
                {{inner.time}}
              </view>
              <theme-badge theme="{{theme}}" status="{{inner.status}}" type="status" text="{{inner.statusText}}" size="sm" />
            </view>
            <view class="card-info">
              <text class="customer-name" style="color: {{inner.status === 'cancelled' ? '#5C5C72' : theme.textPrimary || '#F5F0E8'}}; {{inner.status === 'cancelled' ? 'text-decoration: line-through;' : ''}}">{{inner.customerName}}</text>
              <view class="card-meta">
                <text class="meta-item" style="color: {{inner.status === 'cancelled' ? '#5C5C72' : theme.textSecondary || 'rgba(245,240,232,0.65)'}};">{{inner.guestCount}}人</text>
                <text class="meta-divider" style="color: {{theme.divider || 'rgba(255,255,255,0.08)'}};">|</text>
                <text class="meta-item" style="color: {{inner.status === 'cancelled' ? '#5C5C72' : theme.accentColor || '#C9A96E'}};">{{inner.dishPrice > 0 ? '菜价 ¥' : '¥'}}{{inner.displayPrice}}{{inner.dishPrice > 0 ? '' : '/人'}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- Empty State -->
  <view class="list-section" wx:else>
    <empty-state theme="{{theme}}" type="no-reservation" title="暂无预约" description="该日暂无预约记录" />
  </view>

  <!-- FAB Button -->
  <view class="fab press-scale" bindtap="onAddReservation"
    style="background: {{theme.gradientFab || 'linear-gradient(145deg, #E8D5A8 0%, #C9A96E 40%, #A68B4B 100%)'}}; box-shadow: {{theme.shadowMd || '0 8rpx 24rpx rgba(0,0,0,0.28), 0 4rpx 16rpx rgba(201,169,110,0.20)'}};">
    <text class="fab-icon" style="color: {{theme.textInverse || '#0F0F1A'}};">＋</text>
  </view>

  <!-- Bottom Spacer for tab bar -->
  <view class="tab-bar-safe-bottom"></view>
</view>