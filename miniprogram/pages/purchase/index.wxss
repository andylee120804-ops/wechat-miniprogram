@import '../../styles/mixins.wxss';

.page {
  min-height: 100vh;
}

/* Navigation Bar */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-bar-content {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 24rpx;
  position: relative;
}

.nav-back {
  position: absolute;
  left: 24rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 44rpx;
  font-weight: 300;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
}

.nav-action {
  min-width: 64rpx;
}

/* Filter Bar */
.filter-bar {
  position: sticky;
  top: 0;
  z-index: 90;
  padding-top: calc(var(--status-bar-height, 44px) + 88rpx);
}

.month-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
}

.month-arrow {
  font-size: 36rpx;
  font-weight: 300;
  padding: 8rpx 16rpx;
  color: rgba(255,255,255,0.6);
}

.month-label {
  font-size: 32rpx;
  font-weight: 600;
  min-width: 160rpx;
  text-align: center;
}

.search-wrapper {
  padding-bottom: 16rpx;
}

/* Summary Card */
.summary-card {
  border-radius: 20rpx;
  overflow: hidden;
}

.summary-inner {
  display: flex;
  flex-direction: column;
}

.summary-amount-row {
  align-items: flex-end;
}

.summary-count {
  display: inline-flex;
  align-items: center;
}

/* Purchase List */
.purchase-list {
  display: flex;
  flex-direction: column;
}

.purchase-card {
  border-radius: 16rpx;
  overflow: hidden;
  transition: transform 0.15s ease;
}

.purchase-card:active {
  transform: scale(0.98);
}

.card-inner {
  display: flex;
  flex-direction: column;
}

.card-header {
  align-items: center;
}

.card-item-name {
  max-width: 400rpx;
}

.card-amount {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.card-meta {
  align-items: center;
}

.card-footer {
  align-items: center;
}

.card-remark {
  max-width: 360rpx;
}

/* FAB */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(136rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 80;
  border: 2rpx solid rgba(201, 169, 110, 0.35);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.fab::after {
  content: '';
  position: absolute;
  top: -6rpx;
  left: -6rpx;
  right: -6rpx;
  bottom: -6rpx;
  border-radius: 62rpx;
  background: radial-gradient(circle at 30% 30%, rgba(201, 169, 110, 0.25) 0%, transparent 70%);
  z-index: -1;
  pointer-events: none;
}

.fab:active {
  transform: scale(0.90);
}

.fab-icon {
  font-size: 52rpx;
  font-weight: 400;
  line-height: 1;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.15);
}

/* Stagger animation overrides for card list */
.stagger-item {
  opacity: 0;
  transform: translateY(30rpx);
  animation: staggerIn 0.4s ease-out forwards;
}
