<view class="insights-page" style="background: {{theme.surface || '#1A1A2E'}}; min-height: 100vh; padding-bottom: 120rpx;">
  <!-- Header -->
  <view class="page-header" style="background: {{theme.headerGradient || 'linear-gradient(135deg, #1A1A2E, #252540)'}}; padding: 32rpx;">
    <text class="page-title" style="color: {{theme.textPrimary || '#F0F0F5'}};">经营洞察</text>
    <text class="page-subtitle" style="color: {{theme.textMuted || '#5C5C72'}};">数据驱动的经营决策</text>
  </view>

  <!-- Skeleton -->
  <skeleton wx:if="{{loading}}" theme="{{theme}}" type="stats" />

  <block wx:else>
    <!-- Top Stats -->
    <view class="stats-row">
      <view class="stat-item" style="background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border: 1rpx solid {{theme.border || 'rgba(255,255,255,0.06)'}}; border-radius: 24rpx; padding: 24rpx;">
        <text class="stat-icon">📅</text>
        <text class="stat-val" style="color: {{theme.textPrimary || '#F0F0F5'}}; font-family: 'DIN Alternate', 'SF Mono', monospace;">{{busiestDay.count || 0}}</text>
        <text class="stat-lbl" style="color: {{theme.textMuted || '#5C5C72'}};">最忙日预约</text>
      </view>
      <view class="stat-item" style="background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border: 1rpx solid {{theme.border || 'rgba(255,255,255,0.06)'}}; border-radius: 24rpx; padding: 24rpx;">
        <text class="stat-icon">💵</text>
        <text class="stat-val" style="color: {{theme.amountPositive || '#4ADE80'}}; font-family: 'DIN Alternate', 'SF Mono', monospace;">¥{{avgDailyRevenue}}</text>
        <text class="stat-lbl" style="color: {{theme.textMuted || '#5C5C72'}};">日均收入</text>
      </view>
    </view>

    <!-- Insight Cards -->
    <view class="section">
      <text class="section-title" style="color: {{theme.textPrimary || '#F0F0F5'}};">关键洞察</text>
      <view class="insight-cards">
        <view class="insight-card" wx:for="{{insights}}" wx:key="title" style="background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border: 1rpx solid {{theme.border || 'rgba(255,255,255,0.06)'}}; border-radius: 24rpx; padding: 28rpx; margin-bottom: 16rpx;">
          <view class="insight-header">
            <text class="insight-icon">{{item.icon}}</text>
            <text class="insight-title" style="color: {{theme.textPrimary || '#F0F0F5'}};">{{item.title}}</text>
          </view>
          <text class="insight-desc" style="color: {{theme.textSecondary || '#9A9AB0'}};">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <!-- Revenue Trend Chart -->
    <view class="section" wx:if="{{revenueChart}}">
      <text class="section-title" style="color: {{theme.textPrimary || '#F0F0F5'}};">收入趋势</text>
      <view class="chart-wrap" style="background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border: 1rpx solid {{theme.border || 'rgba(255,255,255,0.06)'}}; border-radius: 24rpx; padding: 24rpx;">
        <ucharts type="line" opts="{{revenueChart}}" canvasId="insight-revenue-chart" canvasWidth="650" canvasHeight="300" />
      </view>
    </view>

    <empty-state wx:if="{{insights.length === 0}}" theme="{{theme}}" type="no-data" title="暂无洞察数据" description="开始记录收入和预约后，系统将自动生成经营洞察" />
  </block>
</view>
