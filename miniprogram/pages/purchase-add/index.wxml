<view class="page" style="background: {{theme.surfaceColor || '#1A1A2E'}};">
  <!-- Custom Navigation Bar -->
  <view class="nav-bar" style="background: {{theme.gradientHeader || theme.surfaceColor}}; padding-top: {{statusBarHeight}}px; height: {{statusBarHeight + 44}}px; box-sizing: border-box;">
    <view class="nav-bar-content">
      <view class="nav-back" bindtap="onBack">
        <text class="nav-back-icon" style="color: {{theme.textPrimary || '#F5F0E8'}}">❮</text>
      </view>
      <text class="nav-title" style="color: {{theme.textPrimary || '#F5F0E8'}};">{{isEdit ? '编辑采购' : '新增采购'}}</text>
      <view class="nav-action"></view>
    </view>
  </view>

  <view class="page-content px-lg pt-xl">
    <!-- Date -->
    <view class="flex-row flex-between" style="background: {{theme.elevated || '#252540'}}; border-radius: 10rpx; padding: 16rpx 20rpx; margin-top: 16rpx; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}};">
      <view class="flex-row" style="align-items: center;">
        <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 26rpx;">采购日期</text>
        <text style="color: {{theme.accentColor || '#C9A96E'}}; font-size: 22rpx; margin-left: 8rpx;">*</text>
      </view>
      <picker mode="date" value="{{date}}" bindchange="onDateChange">
        <view class="flex-row" style="align-items: center;">
          <text style="color: {{theme.textPrimary || '#F5F0E8'}}; font-size: 26rpx;">{{date}}</text>
          <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 22rpx; margin-left: 8rpx;">▾</text>
        </view>
      </picker>
    </view>

    <!-- Category -->
    <view style="background: {{theme.elevated || '#252540'}}; border-radius: 10rpx; padding: 16rpx 20rpx; margin-top: 16rpx; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}};">
      <view class="flex-row" style="align-items: center; margin-bottom: 12rpx;">
        <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 26rpx;">采购分类</text>
        <text style="color: {{theme.accentColor || '#C9A96E'}}; font-size: 22rpx; margin-left: 8rpx;">*</text>
      </view>
      <view class="category-pills flex-row flex-wrap">
        <view class="category-pill {{category === item.value ? 'active' : ''}}"
          wx:for="{{categoryOptions}}" wx:key="value"
          data-value="{{item.value}}" bindtap="onCategorySelect"
          style="{{category === item.value ? 'background:' + (theme.accentColor || '#C9A96E') + ';color:' + (theme.textInverse || '#0F0F1A') + ';' : 'background:' + (theme.surfaceColor || '#1A1A2E') + ';color:' + (theme.textSecondary || '#9A9AB0') + ';'}}">
          <text class="pill-text" style="font-size: 24rpx;">{{item.label}}</text>
        </view>
      </view>
      <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 22rpx; margin-top: 12rpx; display: block;">{{category === 'banquet' ? '必填：采购日期、采购分类、关联预约、金额' : '必填：采购日期、采购分类、物品名称、金额'}}</text>
    </view>

    <!-- Reservation Picker (only for banquet category) -->
    <block wx:if="{{category === 'banquet'}}">
      <view class="flex-row flex-between" style="background: {{theme.elevated || '#252540'}}; border-radius: 10rpx; padding: 16rpx 20rpx; margin-top: 16rpx; border: 1rpx solid {{errors.reservation ? '#F87171' : theme.borderColor || 'rgba(255,255,255,0.10)'}};">
        <view class="flex-row" style="align-items: center; flex-shrink: 0;">
          <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 26rpx;">关联预约</text>
          <text style="color: {{theme.accentColor || '#C9A96E'}}; font-size: 22rpx; margin-left: 8rpx;">*</text>
        </view>
        <block wx:if="{{recentReservations.length > 0}}">
          <picker mode="selector" range="{{pickerItems}}" bindchange="onReservationPickerChange" style="flex:1">
            <view class="flex-row" style="align-items: center; justify-content: flex-end;">
              <text style="color: {{pickerIndex >= 0 ? theme.textPrimary || '#F5F0E8' : theme.textMuted || '#5C5C72'}}; font-size: 24rpx;">{{pickerIndex >= 0 ? pickerItems[pickerIndex] : '请选择预约'}}</text>
              <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 20rpx; margin-left: 4rpx; flex-shrink: 0;">▾</text>
            </view>
          </picker>
        </block>
        <text wx:else style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 24rpx;">暂无可关联预约</text>
      </view>
      <text wx:if="{{errors.reservation}}" style="color: #F87171; font-size: 22rpx; margin-top: 4rpx; display: block;">{{errors.reservation}}</text>
    </block>

    <!-- Item Name -->
    <view class="flex-row flex-between" style="background: {{theme.elevated || '#252540'}}; border-radius: 10rpx; padding: 16rpx 20rpx; margin-top: 16rpx; border: 1rpx solid {{errors.item ? '#F87171' : theme.borderColor || 'rgba(255,255,255,0.10)'}};">
      <view class="flex-row" style="align-items: center; flex-shrink: 0;">
        <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 26rpx;">物品名称</text>
        <text wx:if="{{category !== 'banquet'}}" style="color: {{theme.accentColor || '#C9A96E'}}; font-size: 22rpx; margin-left: 8rpx;">*</text>
        <text wx:else style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 22rpx; margin-left: 8rpx;">选填</text>
      </view>
      <input class="form-input" placeholder="{{category === 'banquet' ? '可选填' : '必填'}}" placeholder-style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 26rpx;"
        value="{{item}}" bindinput="onItemInput"
        style="color: {{theme.textPrimary || '#F5F0E8'}}; text-align: right; flex: 1; margin-left: 20rpx;" />
    </view>
    <text wx:if="{{errors.item}}" style="color: #F87171; font-size: 22rpx; margin-top: 4rpx; display: block;">{{errors.item}}</text>

    <!-- Amount -->
    <view class="flex-row flex-between" style="background: {{theme.elevated || '#252540'}}; border-radius: 10rpx; padding: 16rpx 20rpx; margin-top: 16rpx; border: 1rpx solid {{errors.amount ? '#F87171' : theme.borderColor || 'rgba(255,255,255,0.10)'}};">
      <view class="flex-row" style="align-items: center;">
        <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 26rpx;">金额</text>
        <text style="color: {{theme.accentColor || '#C9A96E'}}; font-size: 22rpx; margin-left: 8rpx;">*</text>
      </view>
      <view class="flex-row" style="align-items: center;">
        <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 26rpx;">¥</text>
        <input class="amount-input" type="digit" placeholder="必填，大于0" placeholder-style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 24rpx;"
          value="{{amount}}" bindinput="onAmountInput"
          style="color: {{theme.amountNegative || '#F87171'}}; text-align: right; width: 200rpx; margin-left: 8rpx;" />
      </view>
    </view>
    <text wx:if="{{errors.amount}}" style="color: #F87171; font-size: 22rpx; margin-top: 4rpx; display: block;">{{errors.amount}}</text>

    <!-- Receipt Images -->
    <view style="background: {{theme.elevated || '#252540'}}; border-radius: 10rpx; padding: 16rpx 20rpx; margin-top: 16rpx; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}};">
      <view class="flex-row flex-between" style="align-items: center; margin-bottom: 12rpx;">
        <text style="color: {{theme.textPrimary || '#F5F0E8'}}; font-size: 26rpx; font-weight: 500;">单据照片</text>
        <text class="receipt-count" style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 24rpx;">{{receiptImages.length}}/3</text>
      </view>
      <view class="receipt-grid">
        <view class="receipt-thumb" wx:for="{{receiptImages}}" wx:key="fileID">
          <image class="receipt-thumb-image" src="{{item.fileID}}" mode="aspectFill" />
          <view class="receipt-thumb-del" data-index="{{index}}" bindtap="onRemoveReceiptImage">
            <text>×</text>
          </view>
        </view>
        <view class="receipt-add" wx:if="{{receiptImages.length < 3}}"
          style="background: rgba(201,169,110,0.1); border: 1.5rpx dashed rgba(201,169,110,0.4);"
          bindtap="onAddReceiptImage">
          <text class="receipt-add-icon" style="color: {{theme.accentColor || '#C9A96E'}};">+</text>
          <text class="receipt-add-text" style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 22rpx;">上传</text>
        </view>
      </view>
    </view>

    <!-- Remark -->
    <view style="background: {{theme.elevated || '#252540'}}; border-radius: 10rpx; padding: 16rpx 20rpx; margin-top: 16rpx; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}};">
      <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 26rpx; display: block; margin-bottom: 12rpx;">备注</text>
      <textarea class="remark-input" placeholder="选填" placeholder-style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 26rpx;"
        value="{{remark}}" bindinput="onRemarkInput" maxlength="200"
        style="color: {{theme.textPrimary || '#F5F0E8'}}; background: {{theme.surfaceColor || '#1A1A2E'}}; border-radius: 8rpx; padding: 16rpx; min-height: 100rpx; max-height: 100rpx; width: 100%; box-sizing: border-box;" />
    </view>

    <!-- 审批人展示 -->
    <view class="approver-row" wx:if="{{approverName}}" style="margin: 16rpx 0; padding: 12rpx 0;">
      <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 24rpx;">审批人：</text>
      <text style="color: {{theme.accentColor || '#C9A96E'}}; font-size: 24rpx;">{{approverName}}</text>
    </view>

    <!-- Bottom Spacer for fixed bar -->
    <view style="height: 200rpx;"></view>
  </view>

  <!-- Fixed Bottom Action Bar -->
  <view class="bottom-bar">
    <view class="bottom-bar-inner {{isEdit ? 'two-btns' : 'single-btn'}}">
      <view wx:if="{{isEdit}}" class="bar-btn bar-btn-danger" bindtap="onDelete">删除</view>
      <view class="bar-btn bar-btn-primary bar-btn-primary-wide {{submitting ? 'bar-btn-disabled' : ''}}" bindtap="onSubmit">{{submitting ? '提交中...' : (isEdit ? '保存修改' : '确认添加')}}</view>
    </view>
  </view>

  <!-- Delete Confirmation Modal -->
  <theme-modal theme="{{theme}}" visible="{{showDeleteModal}}" title="确认删除" confirmText="删除" cancelText="取消" bind:confirm="onDeleteConfirm" bind:close="onDeleteCancel">
    <view class="p-lg">
      <text style="color: {{theme.textPrimary || '#F5F0E8'}};">确定要删除此采购记录吗？删除后不可恢复。</text>
    </view>
  </theme-modal>
</view>
