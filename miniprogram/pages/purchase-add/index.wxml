<view class="page" style="background: {{theme.surfaceColor || '#1A1A2E'}};">
  <!-- Custom Navigation Bar -->
  <view class="nav-bar" style="background: {{theme.gradientHeader || theme.surfaceColor}}; padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar-content">
      <view class="nav-back" bindtap="onBack">
        <text class="nav-back-icon" style="color: {{theme.textPrimary || '#F5F0E8'}}">❮</text>
      </view>
      <text class="nav-title" style="color: {{theme.textPrimary || '#F5F0E8'}};">{{isEdit ? '编辑采购' : '新增采购'}}</text>
      <view class="nav-action"></view>
    </view>
  </view>

  <view class="page-content px-lg pt-xl">
    <!-- Item Name -->
    <theme-card theme="{{theme}}">
      <view class="p-lg">
        <theme-form-item theme="{{theme}}" label="物品名称" required="{{true}}" error="{{errors.item || ''}}">
          <input class="form-input" placeholder="请输入物品名称" placeholder-style="color: {{theme.textMuted || '#5C5C72'}};"
            value="{{item}}" bindinput="onItemInput"
            style="color: {{theme.textPrimary || '#F5F0E8'}};" />
        </theme-form-item>
      </view>
    </theme-card>

    <!-- Amount -->
    <theme-card theme="{{theme}}" class="mt-md">
      <view class="p-lg">
        <theme-form-item theme="{{theme}}" label="金额" required="{{true}}" error="{{errors.amount || ''}}">
          <view class="amount-input-wrapper flex-row" style="border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}}; border-radius: 12rpx; background: {{theme.elevated || '#252540'}};">
            <text class="amount-prefix text-title2" style="color: {{theme.textMuted || '#5C5C72'}};">¥</text>
            <input class="amount-input" type="digit" placeholder="0.00" placeholder-style="color: {{theme.textMuted || '#5C5C72'}};"
              value="{{amount}}" bindinput="onAmountInput"
              style="color: {{theme.amountNegative || '#F87171'}};" />
          </view>
        </theme-form-item>
      </view>
    </theme-card>

    <!-- Category Selector -->
    <theme-card theme="{{theme}}" class="mt-md">
      <view class="p-lg">
        <theme-form-item theme="{{theme}}" label="采购分类">
          <view class="category-pills flex-row flex-wrap">
            <view class="category-pill {{category === item.value ? 'active' : ''}}"
              wx:for="{{categoryOptions}}" wx:key="value"
              data-value="{{item.value}}" bindtap="onCategorySelect"
              style="{{category === item.value ? 'background:' + (theme.accentColor || '#C9A96E') + ';color:' + (theme.textInverse || '#0F0F1A') + ';' : 'background:' + (theme.elevated || '#252540') + ';color:' + (theme.textSecondary || '#9A9AB0') + ';'}}">
              <text class="pill-text">{{item.label}}</text>
            </view>
          </view>
        </theme-form-item>
      </view>
    </theme-card>

    <!-- Date -->
    <theme-card theme="{{theme}}" class="mt-md">
      <view class="p-lg">
        <theme-form-item theme="{{theme}}" label="采购日期">
          <picker mode="date" value="{{date}}" bindchange="onDateChange">
            <view class="date-display flex-row flex-between" style="background: {{theme.elevated || '#252540'}}; border-radius: 12rpx; padding: 20rpx 24rpx; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}};">
              <text style="color: {{theme.textPrimary || '#F5F0E8'}};">{{date}}</text>
              <text style="color: {{theme.textMuted || '#5C5C72'}};">▾</text>
            </view>
          </picker>
        </theme-form-item>
      </view>
    </theme-card>

    <!-- Remark -->
    <theme-card theme="{{theme}}" class="mt-md">
      <view class="p-lg">
        <theme-form-item theme="{{theme}}" label="备注">
          <textarea class="remark-input" placeholder="添加备注信息(选填)" placeholder-style="color: {{theme.textMuted || '#5C5C72'}};"
            value="{{remark}}" bindinput="onRemarkInput" maxlength="200" auto-height
            style="color: {{theme.textPrimary || '#F5F0E8'}}; background: {{theme.elevated || '#252540'}}; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}}; border-radius: 12rpx; padding: 20rpx 24rpx; min-height: 120rpx;" />
        </theme-form-item>
      </view>
    </theme-card>

    <!-- Bottom Spacer for fixed bar -->
    <view style="height: 200rpx;"></view>
  </view>

  <!-- Fixed Bottom Action Bar -->
  <view class="bottom-bar">
    <view class="bottom-bar-inner {{isEdit ? 'two-btns' : 'single-btn'}}">
      <view wx:if="{{isEdit}}" class="bar-btn bar-btn-danger" bindtap="onDelete">删除</view>
      <view class="bar-btn bar-btn-primary" bindtap="onSubmit">{{isEdit ? '保存修改' : '确认添加'}}</view>
    </view>
  </view>

  <!-- Delete Confirmation Modal -->
  <theme-modal theme="{{theme}}" visible="{{showDeleteModal}}" title="确认删除" confirmText="删除" cancelText="取消" bind:confirm="onDeleteConfirm" bind:close="onDeleteCancel">
    <view class="p-lg">
      <text style="color: {{theme.textPrimary || '#F5F0E8'}};">确定要删除此采购记录吗？删除后不可恢复。</text>
    </view>
  </theme-modal>
</view>
