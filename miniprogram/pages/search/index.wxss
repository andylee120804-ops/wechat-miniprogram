@import '../../styles/mixins.wxss';

.search-page {
  min-height: 100vh;
}

/* Navigation Bar */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-bar-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 44rpx;
  font-weight: 300;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
}

.nav-action {
  min-width: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.search-header {
  position: sticky;
  top: 0;
  z-index: 99;
}

.recent-section {
  padding: 24rpx 32rpx;
}

.recent-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.recent-chips {
  display: flex;
  flex-wrap: wrap;
}

.recent-chip {
  transition: opacity 0.2s;
}

.recent-chip:active {
  opacity: 0.7;
}

.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.tab-bar {
  display: flex;
  padding: 0 32rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  font-weight: 500;
  border-bottom: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.result-list {
  padding-bottom: 32rpx;
}

.result-item {
  transition: background 0.15s;
}

.result-item:active {
  background: rgba(255,255,255,0.02) !important;
}
