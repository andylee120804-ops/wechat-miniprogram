@import '../../styles/mixins.wxss';

.clockin-page {
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* Navigation Bar */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-bar-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 44rpx;
  font-weight: 300;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
}

.nav-action {
  min-width: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

/* Status Hero */
.status-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 48rpx 48rpx;
  position: relative;
  overflow: hidden;
}

/* Status Indicator */
.status-indicator-wrap {
  margin-bottom: 24rpx;
}

.status-indicator {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.4s ease;
}

.status-indicator.active {
  box-shadow: 0 0 40rpx rgba(74, 222, 128, 0.25);
}

.status-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 12rpx;
}

/* Pulse animation for not-yet-clocked */
.status-indicator.pulse {
  animation: indicatorPulse 2s ease-in-out infinite;
}

@keyframes indicatorPulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.08); opacity: 0.85; }
}

/* Status Text */
.status-label {
  font-weight: 600;
}

/* Time Row */
.time-row {
  align-items: center;
  gap: 32rpx;
}

.time-block {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.time-label {
  display: block;
  margin-bottom: 4rpx;
}

.time-value {
  font-weight: 700;
}

.time-divider {
  width: 1rpx;
  height: 48rpx;
  margin-top: 24rpx;
}

/* Clock Button */
.clock-btn-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
}

.clock-ring {
  width: 280rpx;
  height: 280rpx;
  border-radius: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.4s ease;
  position: relative;
}

/* Ring states */
.clock-ring.ring-ready {
  background: transparent;
  border: 6rpx solid rgba(201, 169, 110, 0.3);
  animation: ringPulse 2.5s ease-in-out infinite;
}

.clock-ring.ring-pause {
  background: transparent;
  border: 6rpx solid rgba(239, 68, 68, 0.5);
  box-shadow: 0 0 30rpx rgba(239, 68, 68, 0.2) inset;
}

.clock-ring.ring-done {
  background: transparent;
  border: 6rpx solid rgba(74, 222, 128, 0.4);
  box-shadow: 0 0 30rpx rgba(74, 222, 128, 0.15) inset;
}

@keyframes ringPulse {
  0%, 100% { border-color: rgba(201, 169, 110, 0.3); transform: scale(1); }
  50% { border-color: rgba(201, 169, 110, 0.6); transform: scale(1.03); }
}

.clock-btn {
  width: 220rpx;
  height: 220rpx;
  border-radius: 110rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.clock-ring.ring-ready .clock-btn {
  background: linear-gradient(135deg, #C9A96E 0%, #E8D5A8 100%);
  box-shadow: 0 8rpx 32rpx rgba(201, 169, 110, 0.4);
}

.clock-ring.ring-pause .clock-btn {
  background: linear-gradient(135deg, #9B2335 0%, #C1404D 100%);
  box-shadow: 0 8rpx 32rpx rgba(155, 35, 53, 0.4);
}

.clock-ring.ring-done .clock-btn {
  background: linear-gradient(135deg, #2D6A4F 0%, #40916C 100%);
  box-shadow: 0 8rpx 32rpx rgba(45, 106, 79, 0.4);
}

.clock-btn:active {
  transform: scale(0.96);
}

.clock-btn-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.clock-icon {
  font-size: 56rpx;
  line-height: 1;
}

.clock-btn-text {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.clock-hint {
  font-size: 26rpx;
  text-align: center;
  margin-top: 24rpx;
  letter-spacing: 1rpx;
}

/* ========== Makeup Entry Card (Today Mode) ========== */
.makeup-entry-wrap {
  margin-top: 16rpx;
}

.makeup-entry-card {
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.makeup-entry-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.makeup-entry-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.makeup-entry-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: rgba(251, 191, 36, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.makeup-entry-icon {
  font-size: 36rpx;
}

.makeup-entry-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.makeup-entry-title {
  font-size: 30rpx;
  font-weight: 700;
}

.makeup-entry-desc {
  font-size: 24rpx;
}

.makeup-entry-arrow {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ========== Makeup Mode ========== */
.makeup-mode-content {
  padding: 0 0 32rpx;
}

/* Date Picker Section */
.makeup-date-section {
  margin-top: 0;
}

.makeup-date-card {
  overflow: hidden;
}

.makeup-date-header {
  margin-bottom: 16rpx;
}

.makeup-date-label {
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.makeup-date-value-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background: rgba(201, 169, 110, 0.08);
  border-radius: 14rpx;
  border: 1rpx solid rgba(201, 169, 110, 0.15);
}

.makeup-date-icon {
  font-size: 32rpx;
}

.makeup-date-value {
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
}

.makeup-date-arrow {
  font-size: 28rpx;
}

.makeup-date-status {
  display: flex;
  align-items: center;
}

/* Makeup Form Section */
.makeup-form-section {
  margin-top: 24rpx;
}

.makeup-form-card {
  overflow: hidden;
}

.makeup-form-header {
  display: flex;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.08);
}

.makeup-form-badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.makeup-form-date {
  font-size: 24rpx;
}

/* Makeup Time Section */
.makeup-time-section {
  margin-top: 8rpx;
}

.makeup-time-row {
  display: flex;
  gap: 16rpx;
}

.makeup-time-item {
  flex: 1;
  min-width: 0;
}

.makeup-time-item.editable {
  /* editable time slot */
}

.makeup-time-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.makeup-time-label {
  font-size: 24rpx;
  font-weight: 500;
}

.makeup-time-filled-tag {
  display: inline-flex;
}

.makeup-time-picker-box {
  border-radius: 14rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: border-color 0.2s ease;
}

.makeup-time-picker-box:active {
  opacity: 0.85;
}

.makeup-time-picker-text {
  font-size: 36rpx;
  font-weight: 700;
}

.makeup-time-filled-box {
  border-radius: 14rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
}

.reason-input-wrap {
  margin-top: 0;
}

/* Makeup hint area */
.makeup-hint-area {
  margin-top: 24rpx;
}

.makeup-hint-card {
  overflow: hidden;
}

/* Back to today button */
.back-today-wrap {
  margin-top: 16rpx;
}

.back-today-btn {
  transition: opacity 0.2s ease;
}

.back-today-btn:active {
  opacity: 0.7;
}

/* Location Card */
.location-card {
  overflow: hidden;
}

.location-inner {
  align-items: center;
  gap: 12rpx;
}

.location-icon {
  font-size: 32rpx;
}

.location-text {
  line-height: 1.4;
}

/* Records Section */
.records-section {
  padding-bottom: 32rpx;
}

.section-title {
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.records-list {
  display: flex;
  flex-direction: column;
}

.record-item {
  align-items: center;
}

.record-item:active {
  opacity: 0.85;
}

.record-left {
  flex: 1;
}

.record-date {
  font-weight: 500;
  display: block;
}

.record-times {
  align-items: center;
}

.record-badge {
  display: inline-flex;
}

.record-separator {
  font-size: 24rpx;
}

.record-right {
  flex-shrink: 0;
}

.record-late {
  margin-top: 4rpx;
}

/* Record item makeup tag */
.record-makeup-tag {
  display: inline-flex;
}

/* Safe bottom */
.safe-bottom {
  height: env(safe-area-inset-bottom);
}
