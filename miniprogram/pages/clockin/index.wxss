@import '../../styles/mixins.wxss';

.clockin-page {
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* Navigation Bar */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-bar-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 44rpx;
  font-weight: 300;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
}

.nav-action {
  min-width: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

/* Status Hero */
.status-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 48rpx 48rpx;
  position: relative;
  overflow: hidden;
}

/* Status Indicator */
.status-indicator-wrap {
  margin-bottom: 24rpx;
}

.status-indicator {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.4s ease;
}

.status-indicator.active {
  box-shadow: 0 0 40rpx rgba(74, 222, 128, 0.25);
}

.status-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 12rpx;
}

/* Pulse animation for not-yet-clocked */
.status-indicator.pulse {
  animation: indicatorPulse 2s ease-in-out infinite;
}

@keyframes indicatorPulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.08); opacity: 0.85; }
}

/* Status Text */
.status-label {
  font-weight: 600;
}

/* Time Row */
.time-row {
  align-items: center;
  gap: 32rpx;
}

.time-block {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.time-label {
  display: block;
  margin-bottom: 4rpx;
}

.time-value {
  font-weight: 700;
}

.time-divider {
  width: 1rpx;
  height: 48rpx;
  margin-top: 24rpx;
}

/* Date picker row */
.date-picker-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.date-hint {
  font-size: 24rpx;
}

/* Clock Button */
.clock-btn-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
}

.clock-ring {
  width: 280rpx;
  height: 280rpx;
  border-radius: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.4s ease;
  position: relative;
}

/* Ring states */
.clock-ring.ring-ready {
  background: transparent;
  border: 6rpx solid rgba(201, 169, 110, 0.3);
  animation: ringPulse 2.5s ease-in-out infinite;
}

.clock-ring.ring-pause {
  background: transparent;
  border: 6rpx solid rgba(239, 68, 68, 0.5);
  box-shadow: 0 0 30rpx rgba(239, 68, 68, 0.2) inset;
}

.clock-ring.ring-done {
  background: transparent;
  border: 6rpx solid rgba(74, 222, 128, 0.4);
  box-shadow: 0 0 30rpx rgba(74, 222, 128, 0.15) inset;
}

@keyframes ringPulse {
  0%, 100% { border-color: rgba(201, 169, 110, 0.3); transform: scale(1); }
  50% { border-color: rgba(201, 169, 110, 0.6); transform: scale(1.03); }
}

.clock-btn {
  width: 220rpx;
  height: 220rpx;
  border-radius: 110rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.clock-ring.ring-ready .clock-btn {
  background: linear-gradient(135deg, #C9A96E 0%, #E8D5A8 100%);
  box-shadow: 0 8rpx 32rpx rgba(201, 169, 110, 0.4);
}

.clock-ring.ring-pause .clock-btn {
  background: linear-gradient(135deg, #9B2335 0%, #C1404D 100%);
  box-shadow: 0 8rpx 32rpx rgba(155, 35, 53, 0.4);
}

.clock-ring.ring-done .clock-btn {
  background: linear-gradient(135deg, #2D6A4F 0%, #40916C 100%);
  box-shadow: 0 8rpx 32rpx rgba(45, 106, 79, 0.4);
}

.clock-btn:active {
  transform: scale(0.96);
}

.clock-btn-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.clock-icon {
  font-size: 56rpx;
  line-height: 1;
}

.clock-btn-text {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.clock-hint {
  font-size: 26rpx;
  text-align: center;
  margin-top: 24rpx;
  letter-spacing: 1rpx;
}

/* Date Selector */
.date-selector {
  width: 100%;
  display: flex;
  justify-content: center;
}

.date-display-card {
  min-width: 320rpx;
  width: auto;
}

.date-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.date-icon {
  font-size: 28rpx;
}

.date-main-text {
  display: inline;
}

.date-arrow {
  margin-left: 4rpx;
}

.makeup-tag-row {
  display: flex;
  align-items: center;
  justify-content: center;
}

.makeup-hint {
  font-size: 22rpx;
}

/* Make-up clock area */
.makeup-clock-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.makeup-clock-btn {
  background: linear-gradient(135deg, #C9A96E 0%, #E8D5A8 100%);
  border-radius: 999rpx;
  padding: 20rpx 60rpx;
  box-shadow: 0 8rpx 24rpx rgba(201, 169, 110, 0.3);
}

.makeup-form-card {
  overflow: hidden;
}

.makeup-form-header {
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.08);
}

.time-picker-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.time-picker-item {
  flex: 1;
}

.time-picker-label {
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.time-picker-box {
  align-items: center;
  justify-content: space-between;
}

.time-picker-box {
  align-items: center;
  justify-content: center;
}

.time-picker-text {
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
  flex: none;
  display: block;
  width: 100%;
}

.reason-input-wrap {
  margin-top: 0;
}

/* Record item makeup tag */
.record-makeup-tag {
  display: inline-flex;
}
.location-card {
  overflow: hidden;
}

.location-inner {
  align-items: center;
  gap: 12rpx;
}

.location-icon {
  font-size: 32rpx;
}

.location-text {
  line-height: 1.4;
}

/* Records Section */
.records-section {
  padding-bottom: 32rpx;
}

.section-title {
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.records-list {
  display: flex;
  flex-direction: column;
}

.record-item {
  align-items: center;
}

.record-item:active {
  opacity: 0.85;
}

.record-left {
  flex: 1;
}

.record-date {
  font-weight: 500;
  display: block;
}

.record-times {
  align-items: center;
}

.record-badge {
  display: inline-flex;
}

.record-separator {
  font-size: 24rpx;
}

.record-right {
  flex-shrink: 0;
}

.record-late {
  margin-top: 4rpx;
}

/* Safe bottom */
.safe-bottom {
  height: env(safe-area-inset-bottom);
}
