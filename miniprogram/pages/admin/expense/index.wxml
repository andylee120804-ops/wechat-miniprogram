<view class="page" style="background: {{theme.surfaceColor || '#1A1A2E'}};">
  <!-- Custom Navigation Bar -->
  <view class="nav-bar" style="background: {{theme.gradientHeader || theme.surfaceColor}}; padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar-content">
      <view class="nav-back" bindtap="onBack">
        <text class="nav-back-icon" style="color: {{theme.textPrimary || '#F5F0E8'}}">❮</text>
      </view>
      <text class="nav-title" style="color: {{theme.textPrimary || '#F5F0E8'}};">支出管理</text>
      <view class="nav-action">
        <text class="text-caption" style="color: {{theme.textMuted || '#5C5C72'}};">{{monthLabel}}</text>
      </view>
    </view>
  </view>

  <!-- Sticky Filter Bar -->
  <view class="filter-bar" style="background: {{theme.surfaceColor || '#1A1A2E'}};">
    <view class="month-picker flex-row flex-between">
      <view class="month-arrow" bindtap="onPrevMonth" style="color: {{theme.textSecondary || '#9A9AB0'}};">&#x2039;</view>
      <text class="month-label text-body" style="color: {{theme.textPrimary || '#F5F0E8'}};">{{monthStr}}</text>
      <view class="month-arrow" bindtap="onNextMonth" style="color: {{theme.textSecondary || '#9A9AB0'}};">&#x203A;</view>
    </view>
  </view>

  <!-- Monthly Total Card -->
  <view class="summary-card mx-lg mt-md" style="background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}}; box-shadow: {{theme.shadowMd || '0 8rpx 24rpx rgba(0,0,0,0.28)'}};">
    <view class="summary-inner p-lg">
      <text class="text-caption" style="color: {{theme.textMuted || '#5C5C72'}};">本月支出总额</text>
      <view class="summary-amount-row flex-row flex-between mt-xs">
        <text class="text-display font-mono" style="color: {{theme.amountNegative || '#F87171'}};">-¥{{totalAmount.toFixed ? totalAmount.toFixed(2) : '0.00'}}</text>
        <view class="summary-count px-sm py-2xs" style="background: {{theme.amountNegativeBg || 'rgba(248,113,113,0.10)'}}; border-radius: 12rpx;">
          <text class="text-bodySmall" style="color: {{theme.amountNegative || '#F87171'}};">{{expenses.length}}笔</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Expense List -->
  <view class="expense-list px-lg mt-md" wx:if="{{!loading}}">
    <view class="expense-card stagger-item mb-md"
      wx:for="{{expenses}}" wx:key="_id"
      style="animation-delay: {{index * 60}}ms; background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}}; box-shadow: {{theme.shadowSm || '0 2rpx 8rpx rgba(0,0,0,0.20)'}};"
      data-id="{{item._id}}" bindtap="onExpenseTap">
      <view class="card-inner p-lg">
        <view class="card-header flex-row flex-between">
          <theme-badge theme="{{theme}}" status="{{item.category}}" type="expense" text="{{item.categoryName}}" size="sm" />
          <text class="card-amount font-mono text-title2" style="color: {{theme.amountNegative || '#F87171'}};">-¥{{item.formattedAmount}}</text>
        </view>
        <view class="card-body mt-sm" wx:if="{{item.description}}">
          <text class="text-bodySmall ellipsis" style="color: {{theme.textSecondary || '#9A9AB0'}};">{{item.description}}</text>
        </view>
        <view class="card-footer mt-sm">
          <text class="text-caption" style="color: {{theme.textMuted || '#5C5C72'}};">{{item.formattedDate}}</text>
        </view>
      </view>
    </view>

    <!-- Empty State -->
    <empty-state wx:if="{{expenses.length === 0}}" theme="{{theme}}" type="no-data" title="暂无支出记录" description="点击下方按钮添加支出" actionText="添加支出" bind:action="onAddExpense" />
  </view>

  <!-- Skeleton Loading -->
  <view class="px-lg mt-md" wx:if="{{loading}}">
    <skeleton theme="{{theme}}" type="card" count="4" />
  </view>

  <!-- FAB -->
  <view class="fab press-scale" bindtap="onAddExpense"
    style="background: {{theme.gradientFab || 'linear-gradient(135deg, #C9A96E 0%, #D4B87A 100%)'}}; box-shadow: {{theme.shadowMd || '0 8rpx 24rpx rgba(0,0,0,0.28)'}};">
    <text class="fab-icon" style="color: {{theme.textInverse || '#0F0F1A'}};">+</text>
  </view>

  <!-- Bottom Sheet Modal -->
  <view class="modal-overlay" wx:if="{{showModal}}" bindtap="onModalClose"
    style="background: rgba(0,0,0,0.50);"></view>
  <view class="modal-sheet {{showModal ? 'modal-show' : ''}}" wx:if="{{showModal}}"
    style="background: {{theme.elevatedColor || '#252540'}}; border-top: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}};">
    <view class="modal-handle-bar" style="background: {{theme.dividerColor || 'rgba(255,255,255,0.08)'}};"></view>
    <view class="modal-header flex-row flex-between p-lg">
      <text class="text-title3" style="color: {{theme.textPrimary || '#F5F0E8'}};">{{isEdit ? '编辑支出' : '新增支出'}}</text>
      <view class="modal-close" bindtap="onModalClose">
        <text class="text-title2" style="color: {{theme.textMuted || '#5C5C72'}};">&#x2715;</text>
      </view>
    </view>

    <scroll-view class="modal-body" scroll-y="true">
      <!-- Category Picker -->
      <view class="form-section p-lg pt-xs">
        <text class="form-label text-bodySmall" style="color: {{theme.textSecondary || '#9A9AB0'}};">分类</text>
        <view class="category-grid flex-row flex-wrap mt-sm">
          <view class="category-chip {{category === item.id ? 'category-active' : ''}}"
            wx:for="{{categoryOptions}}" wx:key="id"
            data-cat="{{item.id}}" bindtap="onCategoryTap"
            style="background: {{category === item.id ? (theme.accentColor || '#C9A96E') : (theme.glassBg || 'rgba(255,255,255,0.06)')}}; color: {{category === item.id ? (theme.textInverse || '#0F0F1A') : (theme.textSecondary || '#9A9AB0')}}; border: 1rpx solid {{category === item.id ? (theme.accentColor || '#C9A96E') : (theme.borderColor || 'rgba(255,255,255,0.10)')}};">
            <text class="text-bodySmall">{{item.name}}</text>
          </view>
        </view>
      </view>

      <!-- Amount Input -->
      <view class="form-section px-lg">
        <text class="form-label text-bodySmall" style="color: {{theme.textSecondary || '#9A9AB0'}};">金额</text>
        <view class="input-wrap mt-sm" style="border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}}; background: {{theme.glassBg || 'rgba(255,255,255,0.06)'}}; border-radius: 12rpx;">
          <text class="input-prefix font-mono text-title2" style="color: {{theme.textMuted || '#5C5C72'}};">¥</text>
          <input class="amount-input font-mono" type="digit" placeholder="0.00" placeholder-style="color: {{theme.textMuted || '#5C5C72'}}"
            value="{{amount}}" bindinput="onAmountInput" style="color: {{theme.textPrimary || '#F5F0E8'}};" />
        </view>
      </view>

      <!-- Description Input -->
      <view class="form-section p-lg">
        <text class="form-label text-bodySmall" style="color: {{theme.textSecondary || '#9A9AB0'}};">备注</text>
        <view class="input-wrap mt-sm" style="border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}}; background: {{theme.glassBg || 'rgba(255,255,255,0.06)'}}; border-radius: 12rpx;">
          <input class="desc-input" placeholder="请输入备注说明" placeholder-style="color: {{theme.textMuted || '#5C5C72'}}"
            value="{{description}}" bindinput="onDescriptionInput" style="color: {{theme.textPrimary || '#F5F0E8'}};" />
        </view>
      </view>
    </scroll-view>

    <!-- Modal Actions -->
    <view class="modal-actions p-lg" style="border-top: 1rpx solid {{theme.dividerColor || 'rgba(255,255,255,0.08)'}};">
      <view class="action-row flex-row">
        <view class="delete-btn {{isEdit ? '' : 'btn-hidden'}}" wx:if="{{isEdit}}" bindtap="onDeleteExpense"
          style="background: {{theme.statusDangerBg || 'rgba(248,113,113,0.12)'}}; border: 1rpx solid {{theme.statusDanger || '#F87171'}};">
          <text class="text-bodySmall" style="color: {{theme.statusDanger || '#F87171'}};">删除</text>
        </view>
        <view class="save-btn flex-1" bindtap="onSaveExpense"
          style="background: {{theme.gradientButton || 'linear-gradient(135deg, #C9A96E 0%, #E8D5A8 100%)'}};">
          <text class="text-body" style="color: {{theme.textInverse || '#0F0F1A'}}; font-weight: 600;">保存</text>
        </view>
      </view>
    </view>
    <view class="safe-bottom"></view>
  </view>

  <!-- Bottom Spacer -->
  <view style="height: 120rpx;"></view>
</view>
