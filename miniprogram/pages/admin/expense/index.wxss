@import '../../../styles/mixins.wxss';

.page {
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* Navigation Bar */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-bar-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 44rpx;
  font-weight: 300;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
}

.nav-action {
  min-width: 64rpx;
}

/* Filter Bar */
.filter-bar {
  position: sticky;
  top: 0;
  z-index: 90;
  padding-top: calc(var(--status-bar-height, 44px) + 88rpx);
}

.month-picker {
  padding: 16rpx 32rpx;
  align-items: center;
}

.month-arrow {
  font-size: 40rpx;
  font-weight: 300;
  padding: 8rpx 16rpx;
}

.month-label {
  font-weight: 500;
}

/* Summary Card */
.summary-card {
  border-radius: 20rpx;
  overflow: hidden;
}

.summary-inner {
  display: flex;
  flex-direction: column;
}

.summary-amount-row {
  align-items: flex-end;
}

.summary-count {
  display: inline-flex;
  align-items: center;
}

/* Expense List */
.expense-list {
  display: flex;
  flex-direction: column;
}

.expense-card {
  border-radius: 16rpx;
  overflow: hidden;
  transition: transform 0.15s ease;
}

.expense-card:active {
  transform: scale(0.98);
}

.card-inner {
  display: flex;
  flex-direction: column;
}

.card-header {
  align-items: center;
}

.card-amount {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.card-body {
  padding-top: 4rpx;
}

.card-footer {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
}

/* FAB */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 80;
}

.fab-icon {
  font-size: 56rpx;
  font-weight: 300;
  line-height: 1;
}

.press-scale:active {
  transform: scale(0.92);
}

/* Modal Overlay */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
}

/* Bottom Sheet Modal */
.modal-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 210;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.modal-show {
  transform: translateY(0);
}

.modal-handle-bar {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  margin: 16rpx auto 0;
}

.modal-header {
  flex-shrink: 0;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-body {
  flex: 1;
  max-height: 50vh;
}

/* Form Sections */
.form-section {
  margin-bottom: 8rpx;
}

.form-label {
  display: block;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.category-grid {
  gap: 16rpx;
}

.category-chip {
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  transition: all 0.2s ease;
}

.category-chip:active {
  transform: scale(0.96);
}

.category-active {
  font-weight: 600;
}

.input-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 24rpx;
  height: 88rpx;
}

.input-prefix {
  margin-right: 12rpx;
}

.amount-input {
  flex: 1;
  font-size: 36rpx;
  height: 88rpx;
}

.desc-input {
  flex: 1;
  font-size: 28rpx;
  height: 88rpx;
}

/* Modal Actions */
.modal-actions {
  flex-shrink: 0;
}

.action-row {
  gap: 16rpx;
}

.delete-btn {
  padding: 20rpx 32rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-hidden {
  display: none;
}

.save-btn {
  padding: 20rpx 0;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.save-btn:active {
  opacity: 0.85;
}

/* Stagger animation */
.stagger-item {
  opacity: 0;
  transform: translateY(30rpx);
  animation: staggerIn 0.4s ease-out forwards;
}

@keyframes staggerIn {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
