@import '../../../styles/mixins.wxss';

.page {
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* Navigation Bar */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-bar-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 44rpx;
  font-weight: 300;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
}

.nav-action {
  min-width: 64rpx;
}

/* Item Card */
.item-card {
  overflow: hidden;
  transition: transform 0.15s ease;
}

.item-card:active {
  transform: scale(0.98);
}

/* FAB */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 80;
}

.fab-icon {
  font-size: 56rpx;
  font-weight: 300;
  line-height: 1;
}

.press-scale:active {
  transform: scale(0.92);
}

/* Modal Overlay */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
}

/* Bottom Sheet Modal */
.modal-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 210;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.modal-show {
  transform: translateY(0);
}

.modal-handle-bar {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  margin: 16rpx auto 0;
}

.modal-body {
  flex: 1;
}

.form-section {
  margin-bottom: 8rpx;
}

.form-input {
  border-bottom: 1rpx solid rgba(255,255,255,0.06);
  padding: 8rpx 0;
}

/* Cycle selector */
.cycle-btn:active {
  opacity: 0.8;
}

/* Stagger animation */
.stagger-item {
  opacity: 0;
  transform: translateY(30rpx);
  animation: staggerIn 0.4s ease-out forwards;
}

@keyframes staggerIn {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
