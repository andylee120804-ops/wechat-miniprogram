@import '../../../styles/mixins.wxss';

.page {
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ==================== Navigation Bar ==================== */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-bar-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 44rpx;
  font-weight: 300;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
}

.nav-action {
  min-width: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.nav-action-text {
  font-size: 26rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.page-content {
  min-height: 100vh;
}

/* ==================== Period Selector ==================== */
.period-section {
  padding-bottom: 8rpx;
}

.period-tabs {
  display: flex;
  flex-direction: row;
  padding: 6rpx;
}

.period-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
  transition: all 0.25s ease;
}

.period-tab-active {
  font-weight: 600;
}

.period-nav {
  padding: 8rpx 16rpx;
}

.period-arrow-disabled {
  opacity: 0.3;
  pointer-events: none;
}

.period-label {
  font-weight: 500;
  letter-spacing: 1rpx;
}

/* Custom date range */
.custom-range {
  padding: 8rpx 16rpx;
  align-items: center;
}

.custom-date-btn {
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  min-width: 180rpx;
  text-align: center;
}

.custom-range-sep {
  font-size: 26rpx;
  margin: 0 12rpx;
}

.custom-query-btn {
  padding: 16rpx 28rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  margin-left: 12rpx;
}

/* ==================== KPI Cards ==================== */
.kpi-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.kpi-card {
  flex: 1;
  border-radius: 20rpx;
  overflow: hidden;
  min-width: 0;
}

.kpi-inner {
  display: flex;
  flex-direction: column;
}

.kpi-label {
  font-size: 24rpx;
}

.kpi-value-row {
  align-items: flex-end;
}

.kpi-amount {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 220rpx;
}

.kpi-trend {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  margin-left: 8rpx;
  flex-shrink: 0;
}

.trend-arrow {
  font-size: 22rpx;
  margin-right: 4rpx;
}

.trend-value {
  font-size: 20rpx;
}

/* ==================== Chart Section ==================== */
.chart-section {
  border-radius: 20rpx;
}

.chart-header {
  border-bottom: 1rpx solid;
  border-bottom-color: rgba(255, 255, 255, 0.06);
}

.chart-tabs {
  display: flex;
  flex-direction: row;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 12rpx;
  padding: 4rpx;
}

.chart-tab {
  padding: 12rpx 24rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
  font-weight: 500;
  transition: all 0.25s ease;
}

.chart-tab-active {
  font-weight: 600;
}

.chart-type-toggle {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.chart-type-btn {
  font-size: 24rpx;
  padding: 4rpx 8rpx;
  font-weight: 500;
}

.chart-type-sep {
  font-size: 24rpx;
  margin: 0 8rpx;
  opacity: 0.3;
}

.chart-canvas-wrapper {
  padding: 16rpx 0;
  width: 100%;
  min-height: 280rpx;
  display: flex;
  justify-content: center;
}

/* Chart Legend */
.chart-legend {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.legend-item {
  padding: 4rpx 0;
}

.legend-left {
  align-items: center;
  flex: 1;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.legend-name {
  font-size: 26rpx;
}

.legend-right {
  align-items: center;
}

.legend-percent {
  min-width: 80rpx;
  text-align: right;
}

.legend-value {
  min-width: 120rpx;
  text-align: right;
}

/* ==================== Fixed Expenses ==================== */
.section-title {
  font-weight: 600;
}

.fixed-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.fixed-item {
  border-radius: 14rpx;
  overflow: hidden;
  transition: transform 0.15s ease;
}

.fixed-item:active {
  transform: scale(0.98);
}

.fixed-info {
  display: flex;
  flex-direction: column;
}

.fixed-delete {
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-fixed {
  padding: 48rpx 0;
}

/* ==================== Quick Navigation ==================== */
.quick-nav-grid {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.quick-nav-pill {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 28rpx 16rpx;
  border-radius: 16rpx;
  transition: transform 0.15s ease;
}

.quick-nav-pill:active {
  transform: scale(0.96);
}

.quick-nav-icon {
  font-size: 40rpx;
}

.quick-nav-text {
  font-size: 24rpx;
  font-weight: 500;
}

/* ==================== Modal ==================== */
.modal-form {
  display: flex;
  flex-direction: column;
}

.modal-field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.modal-label {
  font-weight: 500;
}

.modal-actions {
  margin-top: 16rpx;
}

/* ==================== Animations ==================== */
.press-scale:active {
  transform: scale(0.96);
  transition: transform 0.1s ease;
}
