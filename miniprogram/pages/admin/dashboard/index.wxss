@import '../../../styles/mixins.wxss';

.page {
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ==================== Navigation Bar ==================== */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-bar-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 44rpx;
  font-weight: 300;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
}

.nav-action {
  min-width: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.page-content {
  min-height: 100vh;
}

/* ==================== Period Selector ==================== */
.period-section {
  padding-bottom: 8rpx;
}

.period-tabs {
  display: flex;
  flex-direction: row;
  padding: 6rpx;
}

.period-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
  transition: all 0.25s ease;
}

.period-tab-active {
  font-weight: 600;
}

.period-nav {
  padding: 8rpx 16rpx;
}

.period-arrow-disabled {
  opacity: 0.3;
  pointer-events: none;
}

.period-label {
  font-weight: 500;
  letter-spacing: 1rpx;
}

.period-label-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
}

.period-dropdown-icon {
  transition: transform 0.2s ease;
}

.quick-chips {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  padding: 0 4rpx;
}

.quick-chip {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.quick-chip-active {
  font-weight: 600;
}

.period-range {
  letter-spacing: 0.5rpx;
}

/* ==================== Period Picker ==================== */
.picker-content {
  min-height: 300rpx;
}

.picker-section-title {
  font-size: 24rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.picker-chips {
  gap: 12rpx;
}

.picker-chip {
  padding: 14rpx 24rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.picker-chip:active {
  transform: scale(0.96);
}

/* ==================== Export Button ==================== */
.export-section {
  margin-bottom: 16rpx;
}

.export-btn:active {
  transform: scale(0.97);
  transition: transform 0.1s ease;
}

/* ==================== Profit Hero Section ==================== */
.profit-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.profit-label {
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.profit-value {
  font-size: 64rpx;
  font-weight: 700;
  font-family: 'DIN Alternate', 'SF Pro Display', sans-serif;
}

/* ==================== Summary Cards ==================== */
.summary-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.summary-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  transition: all 0.25s ease;
}

.summary-card-active {
  transform: scale(1.02);
}

.summary-label {
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.summary-value {
  font-size: 32rpx;
  font-weight: 600;
  font-family: 'DIN Alternate', 'SF Pro Display', sans-serif;
}

/* ==================== Chart Section ==================== */
.chart-section {
  border-radius: 20rpx;
}

.chart-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.chart-mode-text {
  font-size: 28rpx;
  font-weight: 500;
}

.chart-hint {
  font-size: 22rpx;
}

.chart-wrapper {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 0 auto;
}

.chart-center-overlay {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
}

.chart-center-total {
  font-size: 36rpx;
  font-weight: 700;
  font-family: 'DIN Alternate', 'SF Pro Display', sans-serif;
}

.chart-center-label {
  font-size: 22rpx;
  margin-top: 4rpx;
}

/* Chart Legend */
.chart-legend {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.legend-item {
  padding: 8rpx 0;
}

.legend-left {
  flex: 1;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
}

.legend-name {
  font-size: 26rpx;
}

.legend-percent {
  min-width: 80rpx;
  text-align: right;
  margin-right: 16rpx;
  font-family: 'DIN Alternate', 'SF Pro Display', sans-serif;
}

.legend-amount {
  min-width: 140rpx;
  text-align: right;
  font-family: 'DIN Alternate', 'SF Pro Display', sans-serif;
}

/* ==================== Animations ==================== */
.press-scale:active {
  transform: scale(0.96);
  transition: transform 0.1s ease;
}
