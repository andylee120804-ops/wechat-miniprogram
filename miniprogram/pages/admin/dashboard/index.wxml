<view class="page" style="background: {{theme.surfaceColor || '#1A1A2E'}};">
  <!-- Custom Navigation Bar -->
  <view class="nav-bar" style="background: {{theme.gradientHeader || theme.surfaceColor}}; padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar-content">
      <view class="nav-back" bindtap="onBack">
        <text class="nav-back-icon" style="color: {{theme.textPrimary || '#F5F0E8'}}">❮</text>
      </view>
      <text class="nav-title" style="color: {{theme.textPrimary || '#F5F0E8'}}">经营报表</text>
      <view class="nav-action"></view>
    </view>
  </view>

  <view class="page-content" style="padding-top: {{statusBarHeight + 44}}px;">

    <!-- Skeleton Loading -->
    <view wx:if="{{loading}}" class="px-lg mt-md">
      <skeleton theme="{{theme}}" type="card" count="3" />
    </view>

    <view wx:if="{{!loading}}">
      <!-- Period Selector -->
      <view class="period-section px-lg pt-md">
        <view class="period-tabs" style="background: {{theme.glassBg || 'rgba(255,255,255,0.06)'}}; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}}; border-radius: 16rpx;">
          <view class="period-tab {{periodType === 'week' ? 'period-tab-active' : ''}}"
            data-type="week" bindtap="switchPeriodType"
            style="{{periodType === 'week' ? 'background: ' + (theme.accentColor || '#C9A96E') + '; color: ' + (theme.textInverse || '#0F0F1A') + ';' : 'color: ' + (theme.textSecondary || '#9A9AB0') + ';'}}">
            <text>周</text>
          </view>
          <view class="period-tab {{periodType === 'month' ? 'period-tab-active' : ''}}"
            data-type="month" bindtap="switchPeriodType"
            style="{{periodType === 'month' ? 'background: ' + (theme.accentColor || '#C9A96E') + '; color: ' + (theme.textInverse || '#0F0F1A') + ';' : 'color: ' + (theme.textSecondary || '#9A9AB0') + ';'}}">
            <text>月</text>
          </view>
          <view class="period-tab {{periodType === 'year' ? 'period-tab-active' : ''}}"
            data-type="year" bindtap="switchPeriodType"
            style="{{periodType === 'year' ? 'background: ' + (theme.accentColor || '#C9A96E') + '; color: ' + (theme.textInverse || '#0F0F1A') + ';' : 'color: ' + (theme.textSecondary || '#9A9AB0') + ';'}}">
            <text>年</text>
          </view>
        </view>

        <!-- Quick Period Chips -->
        <view class="quick-chips mt-sm" style="display: flex; justify-content: center; gap: 12rpx; position: relative; top: 5rpx">
          <view class="quick-chip {{periodType === 'month' ? (periodOffset === 0 ? 'quick-chip-active' : '') : ''}}" bindtap="quickSelect" data-offset="0" data-type="month"
            style="{{periodType === 'month' && periodOffset === 0 ? 'background:' + (theme.accentColor || '#C9A96E') + ';color:' + (theme.textInverse || '#0F0F1A') + ';' : 'background:' + (theme.elevated || '#252540') + ';color:' + (theme.textSecondary || '#9A9AB0') + ';'}}">
            <text>本月</text>
          </view>
          <view class="quick-chip {{periodType === 'month' ? (periodOffset === -1 ? 'quick-chip-active' : '') : ''}}" bindtap="quickSelect" data-offset="-1" data-type="month"
            style="{{periodType === 'month' && periodOffset === -1 ? 'background:' + (theme.accentColor || '#C9A96E') + ';color:' + (theme.textInverse || '#0F0F1A') + ';' : 'background:' + (theme.elevated || '#252540') + ';color:' + (theme.textSecondary || '#9A9AB0') + ';'}}">
            <text>上月</text>
          </view>
          <view class="quick-chip {{periodType === 'year' ? 'quick-chip-active' : ''}}" bindtap="quickSelect" data-offset="0" data-type="year"
            style="{{periodType === 'year' && periodOffset === 0 ? 'background:' + (theme.accentColor || '#C9A96E') + ';color:' + (theme.textInverse || '#0F0F1A') + ';' : 'background:' + (theme.elevated || '#252540') + ';color:' + (theme.textSecondary || '#9A9AB0') + ';'}}">
            <text>本年</text>
          </view>
        </view>

        <!-- Period Navigation -->
        <view class="period-nav flex-row flex-between flex-center-y mt-sm">
          <view class="period-arrow press-scale" bindtap="prevPeriod"
            style="color: {{theme.textSecondary || '#9A9AB0'}}; width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; font-size: 40rpx;">
            <text decode="true">&lt;</text>
          </view>
          <view class="period-label-wrap press-scale" bindtap="showPeriodPicker">
            <view class="flex-col flex-center">
              <text class="period-label text-body" style="color: {{theme.textPrimary || '#F5F0E8'}}; font-size: 32rpx; font-weight: 600;">{{periodLabel}}</text>
              <text class="period-range" style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 22rpx; margin-top: 2rpx;">{{startDate}} ~ {{endDate}}</text>
            </view>
            </view>
          <view class="period-arrow press-scale {{periodOffset >= 0 ? 'period-arrow-disabled' : ''}}" bindtap="nextPeriod"
            style="color: {{periodOffset >= 0 ? theme.textMuted || '#5C5C72' : theme.textSecondary || '#9A9AB0'}}; width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; font-size: 40rpx;">
            <text decode="true">&gt;</text>
          </view>
        </view>
      </view>

      <!-- Period Picker Modal -->
      <theme-modal theme="{{theme}}" visible="{{showPicker}}" title="选择时段" confirmText="确定" cancelText="取消" bind:confirm="onPickerConfirm" bind:close="onPickerCancel">
        <view class="picker-content p-lg">
          <!-- Year selector -->
          <view class="picker-section">
            <text class="picker-section-title" style="color: {{theme.textSecondary || '#9A9AB0'}};">年份</text>
            <view class="picker-chips flex-row flex-wrap">
              <view class="picker-chip {{pickerYear === item ? 'picker-chip-active' : ''}}" wx:for="{{pickerYears}}" wx:key="*this"
                data-year="{{item}}" bindtap="onPickerYearSelect"
                style="{{pickerYear === item ? 'background:' + (theme.accentColor || '#C9A96E') + ';color:' + (theme.textInverse || '#0F0F1A') + ';' : 'background:' + (theme.elevated || '#252540') + ';color:' + (theme.textSecondary || '#9A9AB0') + ';'}}">{{item}}年</view>
            </view>
          </view>
          <!-- Month selector (only for month mode) -->
          <view class="picker-section mt-lg" wx:if="{{periodType === 'month'}}">
            <text class="picker-section-title" style="color: {{theme.textSecondary || '#9A9AB0'}};">月份</text>
            <view class="picker-chips flex-row flex-wrap">
              <view class="picker-chip {{pickerMonth === item ? 'picker-chip-active' : ''}}" wx:for="{{pickerMonths}}" wx:key="*this"
                data-month="{{item}}" bindtap="onPickerMonthSelect"
                style="{{pickerMonth === item ? 'background:' + (theme.accentColor || '#C9A96E') + ';color:' + (theme.textInverse || '#0F0F1A') + ';' : 'background:' + (theme.elevated || '#252540') + ';color:' + (theme.textSecondary || '#9A9AB0') + ';'}}">{{item}}月</view>
            </view>
          </view>
          <!-- Week selector (only for week mode) -->
          <view class="picker-section mt-lg" wx:if="{{periodType === 'week'}}">
            <text class="picker-section-title" style="color: {{theme.textSecondary || '#9A9AB0'}};">周数</text>
            <view class="picker-chips flex-row flex-wrap">
              <view class="picker-chip {{pickerWeek === item ? 'picker-chip-active' : ''}}" wx:for="{{pickerWeeks}}" wx:key="*this"
                data-week="{{item}}" bindtap="onPickerWeekSelect"
                style="{{pickerWeek === item ? 'background:' + (theme.accentColor || '#C9A96E') + ';color:' + (theme.textInverse || '#0F0F1A') + ';' : 'background:' + (theme.elevated || '#252540') + ';color:' + (theme.textSecondary || '#9A9AB0') + ';'}}">第{{item}}周</view>
            </view>
          </view>
        </view>
      </theme-modal>

      <!-- Profit Hero Section -->
      <view class="profit-hero mx-lg mt-lg">
        <view class="profit-label" style="color: {{theme.textSecondary || '#9A9AB0'}};">净利润</view>
        <view class="profit-value" style="color: {{profit >= 0 ? theme.amountPositive || '#4ADE80' : theme.amountNegative || '#F87171'}};">
          {{profit >= 0 ? '' : '-'}}¥{{profitAbs}}
        </view>
      </view>

      <!-- Income/Expense Cards (clickable to switch chart) -->
      <view class="summary-row px-lg mt-lg">
        <view class="summary-card {{chartMode === 'income' ? 'summary-card-active' : ''}}" bindtap="switchToIncome"
          style="background: {{chartMode === 'income' ? (theme.amountPositiveBg || 'rgba(74,222,128,0.10)') : (theme.cardBg || 'rgba(26,26,46,0.85)')}}; border: 2rpx solid {{chartMode === 'income' ? (theme.amountPositive || '#4ADE80') : (theme.borderColor || 'rgba(255,255,255,0.10)')}}; border-radius: 16rpx;">
          <text class="summary-label" style="color: {{theme.textSecondary || '#9A9AB0'}};">收入</text>
          <text class="summary-value" style="color: {{theme.amountPositive || '#4ADE80'}};">¥{{totalIncome}}</text>
        </view>
        <view class="summary-card {{chartMode === 'expense' ? 'summary-card-active' : ''}}" bindtap="switchToExpense"
          style="background: {{chartMode === 'expense' ? (theme.amountNegativeBg || 'rgba(248,113,113,0.10)') : (theme.cardBg || 'rgba(26,26,46,0.85)')}}; border: 2rpx solid {{chartMode === 'expense' ? (theme.amountNegative || '#F87171') : (theme.borderColor || 'rgba(255,255,255,0.10)')}}; border-radius: 16rpx;">
          <text class="summary-label" style="color: {{theme.textSecondary || '#9A9AB0'}};">支出</text>
          <text class="summary-value" style="color: {{theme.amountNegative || '#F87171'}};">¥{{totalExpense}}</text>
        </view>
      </view>

      <!-- Ring Chart Section -->
      <view class="chart-section mx-lg mt-lg mb-xl" style="background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}}; border-radius: 20rpx; overflow: hidden;">
        <!-- Mode Indicator -->
        <view class="chart-header p-lg flex-row flex-between" style="border-bottom: 1rpx solid {{theme.dividerColor || 'rgba(255,255,255,0.06)'}};">
          <text class="chart-mode-text" style="color: {{theme.textSecondary || '#9A9AB0'}};">{{chartMode === 'income' ? '收入构成' : '支出构成'}}</text>
        </view>

        <!-- Chart Canvas -->
        <view class="chart-wrapper">
          <ucharts wx:if="{{currentChartData && !showPicker}}" chartData="{{currentChartData}}" canvasId="mainChart" canvasWidth="280" canvasHeight="280" />
          <!-- Center Overlay for Tap -->
          <view class="chart-center-overlay">
            <text class="chart-center-total" style="color: {{theme.textPrimary || '#F5F0E8'}}">{{chartMode === 'income' ? totalIncome : totalExpense}}</text>
            <text class="chart-center-label" style="color: {{theme.textMuted || '#5C5C72'}};">{{chartMode === 'income' ? '收入' : '支出'}}</text>
          </view>
        </view>

        <!-- Legend -->
        <view class="chart-legend px-lg pb-lg">
          <view class="legend-item flex-row flex-between" wx:for="{{currentBreakdown}}" wx:key="name">
            <view class="legend-left flex-row flex-center-y">
              <view class="legend-dot" style="background: {{item.color}};"></view>
              <text class="legend-name" style="color: {{theme.textSecondary || '#9A9AB0'}};">{{item.name}}</text>
            </view>
            <view class="legend-right flex-row">
              <text class="legend-percent" style="color: {{theme.textPrimary || '#F5F0E8'}}">{{item.percent}}%</text>
              <text class="legend-amount" style="color: {{theme.textMuted || '#5C5C72'}};">¥{{item.value}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- Bottom Spacer -->
    <view style="height: 60rpx;"></view>
  </view>
</view>
