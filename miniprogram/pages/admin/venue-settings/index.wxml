<view class="page" style="background: {{theme.surfaceColor || '#1A1A2E'}}; min-height: 100vh;">
  <!-- Navigation Bar -->
  <view class="nav-bar" style="background: {{theme.gradientHeader || theme.surfaceColor}}; padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar-content">
      <view class="nav-back" bindtap="onBack">
        <text class="nav-back-icon" style="color: {{theme.textPrimary || '#F5F0E8'}}">❮</text>
      </view>
      <text class="nav-title" style="color: {{theme.textPrimary || '#F5F0E8'}};">食堂设置</text>
      <view class="nav-action"></view>
    </view>
  </view>

  <view class="page-content" style="padding-top: {{statusBarHeight + 44}}px;">
    <view wx:if="{{loading}}" style="padding: 60rpx; text-align: center;">
      <text style="color: {{theme.textMuted || '#5C5C72'}};">加载中...</text>
    </view>

    <view wx:if="{{!loading}}" class="px-lg mt-lg">
      <view class="p-lg" style="background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}}; border-radius: 20rpx;">
        <!-- 食堂名称 -->
        <view class="form-item" style="margin-bottom: 32rpx;">
          <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 28rpx; display: block; margin-bottom: 12rpx;">食堂名称</text>
          <view style="background: {{theme.glassBg || 'rgba(255,255,255,0.05)'}}; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}}; border-radius: 12rpx; padding: 0 24rpx; display: flex; align-items: center; min-height: 80rpx;">
            <input value="{{venueName}}" bindinput="onNameInput" placeholder="请输入食堂名称" placeholder-style="color: {{theme.textMuted || '#5C5C72'}}"
              style="flex: 1; font-size: 28rpx; color: {{theme.textPrimary || '#F5F0E8'}}; background: transparent; padding: 0; height: auto; line-height: normal;" />
          </view>
        </view>

        <!-- 食堂地址 -->
        <view class="form-item">
          <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 28rpx; display: block; margin-bottom: 12rpx;">食堂地址</text>
          <view style="display: flex; gap: 16rpx;">
            <textarea value="{{venueAddress}}" bindinput="onAddressInput" placeholder="请输入食堂地址" placeholder-style="color: {{theme.textMuted || '#5C5C72'}}"
              style="flex: 1; background: {{theme.glassBg || 'rgba(255,255,255,0.05)'}}; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}}; border-radius: 12rpx; padding: 24rpx; color: {{theme.textPrimary || '#F5F0E8'}}; font-size: 28rpx; width: 100%; box-sizing: border-box; min-height: 160rpx;" />
            <view class="flex-center" bindtap="onPickLocation"
              style="background: {{theme.accentColor || '#C9A96E'}}; border-radius: 12rpx; padding: 20rpx; flex-shrink: 0; align-self: flex-end;">
              <text style="color: {{theme.textInverse || '#0F0F1A'}}; font-size: 26rpx; font-weight: 600;">📍 选位置</text>
            </view>
          </view>
          <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 22rpx; display: block; margin-top: 8rpx;">点击「选位置」从地图选取，地址自动填充</text>
        </view>
      </view>

      <view class="mt-lg">
        <button class="save-btn" bindtap="onSave" loading="{{saving}}" disabled="{{saving}}"
          style="background: {{theme.accentColor || '#C9A96E'}}; color: {{theme.textInverse || '#0F0F1A'}}; width: 100%; border-radius: 16rpx; padding: 28rpx; font-size: 30rpx; font-weight: 600; border: none;">
          {{saving ? '保存中...' : '保存设置'}}
        </button>
      </view>
    </view>
  </view>
</view>
