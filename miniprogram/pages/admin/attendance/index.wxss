.attendance-page {
  min-height: 100vh;
}

.month-header {
  padding-top: 48rpx;
}

.month-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
}

.nav-arrow {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: rgba(255,255,255,0.6);
  border: 1rpx solid rgba(255,255,255,0.1);
  border-radius: 50%;
}

.staff-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
}

.toggle-btn {
  padding: 8rpx 16rpx;
}

.record-row:last-child {
  border-bottom: none !important;
}
