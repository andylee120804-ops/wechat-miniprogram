.staff-add-page {
  min-height: 100vh;
}

.role-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.role-pill {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.2s ease;
  border: 2rpx solid transparent;
}

.perm-module-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.select-all-btn {
  padding: 4rpx 12rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(15,15,26,0.95);
  backdrop-filter: blur(20rpx);
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  border-top: 1rpx solid rgba(255,255,255,0.06);
  z-index: 100;
}
