@import '../../../styles/mixins.wxss';
@import '../../../styles/bottom-bar.wxss';

/* Navigation Bar */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-bar-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 44rpx;
  font-weight: 300;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
}

.nav-action {
  min-width: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.staff-add-page {
  min-height: 100vh;
}

.role-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.role-pill {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.2s ease;
  border: 2rpx solid transparent;
}

.perm-module-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.select-all-btn {
  padding: 4rpx 12rpx;
}

/* 微信绑定状态卡片 */
.wechat-bind-card {
  background: rgba(201, 169, 110, 0.08);
  border: 1rpx solid rgba(201, 169, 110, 0.18);
  border-radius: 24rpx;
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  position: relative;
}

.wechat-bind-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, rgba(201, 169, 110, 0.0), rgba(201, 169, 110, 0.5), rgba(201, 169, 110, 0.0));
}

.wechat-bind-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.wechat-bind-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(201, 169, 110, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.wechat-bind-icon {
  color: #C9A96E;
  font-size: 28rpx;
  font-weight: 700;
}

.wechat-bind-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.wechat-bind-title {
  color: #E8D5A8;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.3;
}

.wechat-bind-desc {
  color: rgba(245, 240, 232, 0.45);
  font-size: 24rpx;
  margin-top: 4rpx;
}

.wechat-bind-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(201, 169, 110, 0.10);
}

.wechat-bind-hint {
  color: rgba(245, 240, 232, 0.40);
  font-size: 24rpx;
  flex: 1;
}

.wechat-unbind-btn {
  background: rgba(201, 169, 110, 0.12);
  border: 1rpx solid rgba(201, 169, 110, 0.25);
  border-radius: 999rpx;
  padding: 8rpx 28rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.wechat-unbind-btn:active {
  background: rgba(201, 169, 110, 0.22);
  transform: scale(0.96);
}

.wechat-unbind-btn-text {
  color: #C9A96E;
  font-size: 24rpx;
  font-weight: 500;
}

/* 通用状态横幅 - 墨金风格 */
.status-banner {
  display: flex;
  align-items: center;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
}

.status-banner-danger {
  background: rgba(248, 113, 113, 0.08);
  border: 1rpx solid rgba(248, 113, 113, 0.15);
}

.status-banner-warning {
  background: rgba(251, 191, 36, 0.08);
  border: 1rpx solid rgba(251, 191, 36, 0.15);
}

.status-banner-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.status-banner-dot-danger {
  background: #F87171;
  box-shadow: 0 0 12rpx rgba(248, 113, 113, 0.4);
}

.status-banner-dot-warning {
  background: #FBBF24;
  box-shadow: 0 0 12rpx rgba(251, 191, 36, 0.4);
}

.status-banner-text {
  font-size: 26rpx;
  flex: 1;
  line-height: 1.5;
}

.status-banner-text-danger {
  color: rgba(248, 113, 113, 0.85);
}

.status-banner-text-warning {
  color: rgba(251, 191, 36, 0.85);
}

.status-banner-action {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
  margin-left: 16rpx;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.status-banner-action-warning {
  background: rgba(251, 191, 36, 0.12);
  border: 1rpx solid rgba(251, 191, 36, 0.25);
  color: #FBBF24;
}

.status-banner-action:active {
  transform: scale(0.96);
}
