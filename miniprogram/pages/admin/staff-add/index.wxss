@import '../../../styles/mixins.wxss';
@import '../../../styles/bottom-bar.wxss';

/* Navigation Bar */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-bar-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 44rpx;
  font-weight: 300;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
}

.nav-action {
  min-width: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.staff-add-page {
  min-height: 100vh;
}

.role-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.role-pill {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.2s ease;
  border: 2rpx solid transparent;
}

.perm-module-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.select-all-btn {
  padding: 4rpx 12rpx;
}
