<view class="staff-page" style="background: {{theme.surface || '#1A1A2E'}}; min-height: 100vh; padding-bottom: 120rpx; padding-top: {{statusBarHeight + 44}}px;">
  <!-- Custom Navigation Bar -->
  <view class="nav-bar" style="background: {{theme.gradientHeader || theme.surfaceColor}}; padding-top: {{statusBarHeight}}px; height: {{statusBarHeight + 44}}px; box-sizing: border-box;">
    <view class="nav-bar-content">
      <view class="nav-back" bindtap="onBack">
        <text class="nav-back-icon" style="color: {{theme.textPrimary || '#F5F0E8'}}">❮</text>
      </view>
      <text class="nav-title" style="color: {{theme.textPrimary || '#F5F0E8'}};">员工管理</text>
      <view class="nav-action"></view>
    </view>
  </view>

  <skeleton wx:if="{{loading}}" theme="{{theme}}" type="list" count="3" />

  <view wx:else style="padding: 24rpx;">
    <view class="resigned-toggle" bindtap="onToggleResigned" style="background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border: 1rpx solid {{theme.border || 'rgba(255,255,255,0.06)'}}; border-radius: 16rpx; padding: 20rpx 24rpx; margin-bottom: 16rpx; display: flex; align-items: center; justify-content: space-between;">
      <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 26rpx;">显示已离职员工</text>
      <view style="width: 64rpx; height: 36rpx; border-radius: 999rpx; background: {{showResigned ? (theme.accentColor || '#C9A96E') : 'rgba(255,255,255,0.12)'}}; position: relative; transition: background 0.2s ease;">
        <view style="position: absolute; top: 4rpx; left: {{showResigned ? '32rpx' : '4rpx'}}; width: 28rpx; height: 28rpx; border-radius: 50%; background: #fff; transition: left 0.2s ease;"></view>
      </view>
    </view>

    <view class="staff-item stagger-item {{item.isResigned ? 'staff-resigned' : ''}}" wx:for="{{staffList}}" wx:key="_id" style="background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border: 1rpx solid {{theme.border || 'rgba(255,255,255,0.06)'}}; border-radius: 24rpx; padding: 28rpx; margin-bottom: 16rpx; {{item.isResigned || item.isLoginRevoked ? 'opacity: 0.55;' : ''}}">
      <view class="staff-header">
        <view class="avatar" style="background: {{theme.accentBg || 'rgba(201,169,110,0.15)'}}; color: {{theme.accentColor || '#C9A96E'}}; width: 80rpx; height: 80rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 36rpx; font-weight: 700; margin-right: 20rpx; flex-shrink: 0;">
          {{item.nameInitial}}
        </view>
        <view style="flex: 1;">
          <view style="display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; flex-wrap: wrap;">
            <text style="color: {{theme.textPrimary || '#F0F0F5'}}; font-size: 32rpx; font-weight: 600;">{{item.name}}</text>
            <theme-badge theme="{{theme}}" status="{{item.role}}" type="role" text="{{item.roleName}}" size="sm" />
            <view wx:if="{{item.isResigned}}" style="background: rgba(248, 113, 113, 0.15); color: #F87171; padding: 4rpx 14rpx; border-radius: 999rpx; font-size: 22rpx;">已离职</view>
            <view wx:if="{{item.isLoginRevoked}}" style="background: rgba(251, 191, 36, 0.15); color: #FBBF24; padding: 4rpx 14rpx; border-radius: 999rpx; font-size: 22rpx;">已退出</view>
          </view>
          <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 24rpx;">{{item.wechatId}}</text>
          <text wx:if="{{item.isResigned}}" style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 22rpx; display: block; margin-top: 4rpx;">离职于 {{item.resignDate}}</text>
        </view>
        <view bindtap="onEditStaff" data-id="{{item._id}}" style="padding: 12rpx;">
          <text style="color: {{theme.accentColor || '#C9A96E'}}; font-size: 28rpx;">编辑</text>
        </view>
      </view>

      <view class="perm-tags" style="margin-top: 16rpx; display: flex; flex-wrap: wrap; gap: 8rpx;">
        <view wx:if="{{item.role === 'admin'}}" style="background: {{theme.accentBg || 'rgba(201,169,110,0.15)'}}; color: {{theme.accentColor || '#C9A96E'}}; padding: 6rpx 16rpx; border-radius: 999rpx; font-size: 22rpx;">全部权限</view>
        <view wx:if="{{item.role !== 'admin' && item.permissionModules.length > 0}}" wx:for="{{item.permissionModules}}" wx:for-item="mod" wx:key="*this" style="background: {{theme.elevated || '#252540'}}; color: {{theme.textSecondary || '#9A9AB0'}}; padding: 6rpx 16rpx; border-radius: 999rpx; font-size: 22rpx;">{{mod}}</view>
        <text wx:if="{{item.role !== 'admin' && item.permissionModules.length === 0}}" style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 22rpx;">未配置权限</text>
      </view>
    </view>

    <empty-state wx:if="{{staffList.length === 0}}" theme="{{theme}}" type="no-data" title="{{showResigned ? '暂无员工' : '暂无在职员工'}}" description="{{showResigned ? '点击底部按钮添加员工' : '或开启「显示已离职员工」'}}" />
  </view>

  <view class="fab" bindtap="onAddStaff" style="background: {{theme.buttonGradient || 'linear-gradient(135deg, #C9A96E, #E8D5A8)'}}; box-shadow: {{theme.shadowLg || '0 8rpx 32rpx rgba(201,169,110,0.3)'}};">
    <text style="color: {{theme.textInverse || '#0F0F1A'}}; font-size: 48rpx; font-weight: 300; line-height: 1;">+</text>
  </view>
</view>
