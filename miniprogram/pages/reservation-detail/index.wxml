<view class="detail-page" style="background: {{theme.surface || '#1A1A2E'}}; min-height: 100vh; padding-bottom: 160rpx;">
  <!-- Custom Navigation Bar -->
  <view class="nav-bar" style="background: {{theme.gradientHeader || theme.surfaceColor || '#1A1A2E'}}; padding-top: {{statusBarHeight}}px; height: {{statusBarHeight + 44}}px; box-sizing: border-box;">
    <view class="nav-bar-content">
      <view class="nav-back" bindtap="onBack">
        <text class="nav-back-icon" style="color: {{theme.textPrimary || '#F5F0E8'}}">❮</text>
      </view>
      <text class="nav-title" style="color: {{theme.textPrimary || '#F5F0E8'}};">预约详情</text>
      <view class="nav-action"></view>
    </view>
  </view>
  <block wx:if="{{!loading && reservation}}">
    <!-- Status Hero - grey for cancelled -->
    <view class="status-hero" style="background: {{reservation.status === 'cancelled' ? 'linear-gradient(135deg, rgba(150,150,170,0.15), rgba(100,100,110,0.05))' : 'linear-gradient(135deg, rgba(201,169,110,0.2), rgba(201,169,110,0.05))'}}; padding-top: {{statusBarHeight + 44 + 24}}px;">
      <view class="hero-content">
        <!-- Status indicator - clear display -->
        <view style="display: inline-flex; align-items: center; background: {{reservation.status === 'cancelled' ? 'rgba(248,113,113,0.2)' : 'rgba(74,222,128,0.2)'}}; padding: 8rpx 20rpx; border-radius: 100rpx; margin-bottom: 12rpx;">
          <view style="width: 12rpx; height: 12rpx; border-radius: 50%; background: {{reservation.status === 'cancelled' ? '#F87171' : '#4ADE80'}}; margin-right: 8rpx;"></view>
          <text style="color: {{reservation.status === 'cancelled' ? '#F87171' : '#4ADE80'}}; font-size: 24rpx; font-weight: 600;">{{reservation.status === 'cancelled' ? '已取消' : '正常'}}</text>
        </view>
        <text class="customer-name" style="color: {{reservation.status === 'cancelled' ? theme.textMuted || '#5C5C72' : theme.textPrimary || '#F0F0F5'}}; margin-top: 16rpx; font-size: 40rpx; font-weight: 700; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; {{reservation.status === 'cancelled' ? 'text-decoration: line-through;' : ''}}">{{reservation.customerName}}</text>
        <view class="hero-meta">
          <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 28rpx;">{{reservation.roomNameDisplay}} · {{reservation.time}} · {{reservation.guestCount}}人</text>
        </view>
      </view>
    </view>

    <!-- Detail Card -->
    <view style="padding: 32rpx;">
      <theme-card theme="{{theme}}" padding="32rpx">
        <view class="detail-row">
          <text class="detail-label" style="color: {{theme.textMuted || '#5C5C72'}};">预约日期</text>
          <text class="detail-value" style="color: {{theme.textPrimary || '#F0F0F5'}};">{{reservation.dateDisplay || ''}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label" style="color: {{theme.textMuted || '#5C5C72'}};">时段</text>
          <text class="detail-value" style="color: {{theme.textPrimary || '#F0F0F5'}};">{{reservation.time || '未设置'}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label" style="color: {{theme.textMuted || '#5C5C72'}};">房间</text>
          <text class="detail-value" style="color: {{theme.textPrimary || '#F0F0F5'}};">{{reservation.roomNameDisplay}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label" style="color: {{theme.textMuted || '#5C5C72'}};">人数</text>
          <text class="detail-value" style="color: {{theme.textPrimary || '#F0F0F5'}};">{{reservation.guestCount}}人</text>
        </view>
        <view class="detail-row">
          <text class="detail-label" style="color: {{theme.textMuted || '#5C5C72'}};">人均餐标</text>
          <text class="detail-value" style="color: {{theme.accentColor || '#C9A96E'}}; font-weight: 600;">¥{{reservation.standard}}</text>
        </view>
        <view class="detail-row" wx:if="{{reservation.dishPrice > 0}}">
          <text class="detail-label" style="color: {{theme.textMuted || '#5C5C72'}};">预定菜价</text>
          <text class="detail-value" style="color: {{theme.accentColor || '#C9A96E'}}; font-weight: 600;">¥{{reservation.dishPrice}}</text>
        </view>
        <view class="detail-row" wx:if="{{reservation.phone}}">
          <text class="detail-label" style="color: {{theme.textMuted || '#5C5C72'}};">联系电话</text>
          <text class="detail-value" style="color: {{theme.textPrimary || '#F0F0F5'}};">{{reservation.phone}}</text>
        </view>
        <view class="detail-row" wx:if="{{reservation.remark}}">
          <text class="detail-label" style="color: {{theme.textMuted || '#5C5C72'}};">备注</text>
          <text class="detail-value" style="color: {{theme.textPrimary || '#F0F0F5'}}; flex: 1; text-align: right;">{{reservation.remark}}</text>
        </view>
        <!-- Custom fields -->
        <block wx:if="{{customFieldItems.length > 0}}">
          <view class="detail-row" wx:for="{{customFieldItems}}" wx:key="label">
            <text class="detail-label" style="color: {{theme.textMuted || '#5C5C72'}};">{{item.label}}</text>
            <text class="detail-value" style="color: {{theme.textPrimary || '#F0F0F5'}};">{{item.value}}</text>
          </view>
        </block>
        <view class="detail-row">
          <text class="detail-label" style="color: {{theme.textMuted || '#5C5C72'}};">创建人</text>
          <text class="detail-value" style="color: {{theme.textSecondary || '#9A9AB0'}};">{{reservation.createdByName}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label" style="color: {{theme.textMuted || '#5C5C72'}};">创建时间</text>
          <text class="detail-value" style="color: {{theme.textSecondary || '#9A9AB0'}};">{{reservation.createdAtDisplay}}</text>
        </view>
      </theme-card>
    </view>

    <!-- Action Bar - only for non-cancelled
    (moved outside the block below to ensure fixed positioning) -->

    <!-- Cancel Modal -->
    <theme-modal theme="{{theme}}" visible="{{showCancelModal}}" title="取消预约" confirmText="确认取消" cancelText="返回" position="center" bind:confirm="onConfirmCancel" bind:close="onCloseCancel">
      <view style="padding: 16rpx 0;">
        <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 28rpx;">确定要取消此预约吗？取消后无法恢复。</text>
      </view>
    </theme-modal>

    <!-- Share Modal -->
    <theme-modal theme="{{theme}}" visible="{{showShareModal}}" title="分享给客人" showFooter="{{false}}" bind:close="onCloseShareModal">
      <scroll-view scroll-y style="max-height: 80vh; padding: 16rpx 0;">
        <!-- Template selector -->
        <view style="display:flex; align-items:center; margin-bottom:16rpx;">
          <text style="color:{{selectedTemplate==='business'?'#C9A96E':'#5C5C72'}};font-size:26rpx;font-weight:{{selectedTemplate==='business'?'600':'400'}};" data-id="business" bindtap="onTemplateSelect">商务风格</text>
          <text style="color:#5C5C72;font-size:26rpx;margin:0 16rpx;">|</text>
          <text style="color:{{selectedTemplate==='friend'?'#C9A96E':'#5C5C72'}};font-size:26rpx;font-weight:{{selectedTemplate==='friend'?'600':'400'}};" data-id="friend" bindtap="onTemplateSelect">友情风格</text>
        </view>
        <!-- Share title -->
        <text style="color: {{theme.textSecondary || '#9A9AB0'}}; font-size: 30rpx; display: block; margin-bottom: 16rpx;">分享标题</text>
        <textarea value="{{shareTitle}}" bindinput="onShareTitleInput" placeholder="输入分享标题" placeholder-style="color: {{theme.textMuted || '#5C5C72'}}"
          style="background: {{theme.glassBg || 'rgba(255,255,255,0.05)'}}; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}}; border-radius: 12rpx; padding: 20rpx; color: {{theme.textPrimary || '#F5F0E8'}}; font-size: 30rpx; width: 100%; box-sizing: border-box; min-height: 68rpx; max-height: 120rpx;" />

        <!-- Preview card -->
        <view style="margin-top: 28rpx; background: {{theme.glassBg || 'rgba(255,255,255,0.04)'}}; border-radius: 16rpx; padding: 28rpx; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}};">
          <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 24rpx; display: block; margin-bottom: 16rpx;">📋 客人将看到的内容</text>
          <view style="display: flex; justify-content: space-between; padding: 12rpx 0;">
            <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 26rpx;">日期</text>
            <text style="color: {{theme.textPrimary || '#F5F0E8'}}; font-size: 26rpx; font-weight: 500;">{{reservation.dateDisplay || ''}}</text>
          </view>
          <view style="display: flex; justify-content: space-between; padding: 12rpx 0;">
            <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 26rpx;">时段</text>
            <text style="color: {{theme.textPrimary || '#F5F0E8'}}; font-size: 26rpx; font-weight: 500;">{{reservation.time || ''}}</text>
          </view>
          <view style="display: flex; justify-content: space-between; padding: 12rpx 0;">
            <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 26rpx;">包厢</text>
            <text style="color: {{theme.textPrimary || '#F5F0E8'}}; font-size: 26rpx; font-weight: 500;">{{reservation.roomNameDisplay || ''}}</text>
          </view>
          <view style="display: flex; justify-content: space-between; padding: 12rpx 0;">
            <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 26rpx;">人数</text>
            <text style="color: {{theme.textPrimary || '#F5F0E8'}}; font-size: 26rpx; font-weight: 500;">{{reservation.guestCount || ''}}人</text>
          </view>
          <view wx:if="{{reservation.remark}}" style="display: flex; justify-content: space-between; padding: 12rpx 0;">
            <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 26rpx;">备注</text>
            <text style="color: {{theme.textPrimary || '#F5F0E8'}}; font-size: 26rpx; max-width: 55%; text-align: right;">{{reservation.remark}}</text>
          </view>

          <!-- Share remark (editable, shown to guest) -->
          <view style="border-top: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.08)'}}; margin-top: 12rpx; padding-top: 16rpx;">
            <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 24rpx; display: block; margin-bottom: 8rpx;">📝 分享备注（客人可见）</text>
            <textarea value="{{shareRemark}}" bindinput="onShareRemarkInput" placeholder="输入给客人的特殊备注，如停车指引、到店须知等"
              placeholder-style="color: {{theme.textMuted || '#5C5C72'}}"
              style="background: {{theme.glassBg || 'rgba(255,255,255,0.05)'}}; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}}; border-radius: 10rpx; padding: 16rpx; color: {{theme.textPrimary || '#F5F0E8'}}; font-size: 24rpx; width: 100%; box-sizing: border-box; min-height: 60rpx; max-height: 120rpx; line-height: 1.4;" />
          </view>

          <!-- Address (editable) -->
          <view style="border-top: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.08)'}}; margin-top: 12rpx; padding-top: 12rpx;">
            <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 24rpx; display: block; margin-bottom: 6rpx;">📍 地址（可改）</text>
            <input value="{{shareAddress}}" bindinput="onShareAddressInput" placeholder="食堂地址"
              style="background: {{theme.glassBg || 'rgba(255,255,255,0.05)'}}; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}}; border-radius: 10rpx; padding: 0 16rpx; color: {{theme.textPrimary || '#F5F0E8'}}; font-size: 24rpx; width: 100%; box-sizing: border-box; height: 72rpx; line-height: 72rpx;" />
          </view>
        </view>

        <view style="margin-top: 36rpx;">
          <button open-type="share" bindtap="onShareAndSave"
            style="width: 100%; background: {{theme.accentColor || '#C9A96E'}}; color: {{theme.textInverse || '#0F0F1A'}}; border-radius: 16rpx; padding: 28rpx 0; font-size: 32rpx; font-weight: 700; border: none; line-height: 1.2; margin-bottom: 20rpx;">
            分享到微信
          </button>
          <view style="display: flex; gap: 20rpx;">
            <view bindtap="onConfirmShare" style="flex: 1; background: {{theme.elevated || '#252540'}}; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.15)'}}; border-radius: 12rpx; padding: 18rpx 0; text-align: center;">
              <text style="color: {{theme.textPrimary || '#F5F0E8'}}; font-size: 26rpx; font-weight: 500;">保存</text>
            </view>
            <view bindtap="onCloseShareModal" style="flex: 1; background: transparent; border: 1rpx solid {{theme.borderColor || 'rgba(255,255,255,0.10)'}}; border-radius: 12rpx; padding: 18rpx 0; text-align: center;">
              <text style="color: {{theme.textMuted || '#5C5C72'}}; font-size: 26rpx;">取消</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </theme-modal>
  </block>

  <!-- Action Bar - fixed at bottom, independent of content -->
  <view class="bottom-bar" wx:if="{{!loading && reservation && reservation.status !== 'cancelled' && (canEdit || canCancel || canShare)}}">
    <view class="bottom-bar-inner" style="justify-content: space-between;">
      <view wx:if="{{canCancel}}" class="bar-btn bar-btn-danger" style="flex: 1; border-radius: 14rpx;" bindtap="onCancel">取消预定</view>
      <view wx:if="{{canEdit}}" class="bar-btn bar-btn-primary" style="flex: 1; border-radius: 14rpx; margin: 0 12rpx;" bindtap="onEdit">编辑</view>
      <view wx:if="{{canShare}}" class="bar-btn" style="flex: 1; background: {{theme.accentColor || '#C9A96E'}}; color: {{theme.textInverse || '#0F0F1A'}}; font-weight: 700; border-radius: 14rpx;" bindtap="onShareToGuest">分享给客人</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-state" style="padding-top: {{statusBarHeight + 44}}px;">
    <text style="color: {{theme.textMuted || '#5C5C72'}};">加载中...</text>
  </view>
</view>