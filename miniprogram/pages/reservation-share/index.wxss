.page {
  background: linear-gradient(180deg, #F8F4ED 0%, #F0EBE0 100%);
  min-height: 100vh;
}

/* Loading / Error states */
.state-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 60rpx;
}
.state-text {
  color: #B0A89A;
  font-size: 28rpx;
  margin-top: 20rpx;
}
.error-icon {
  font-size: 80rpx;
}

/* Loading dots */
.loading-dots {
  display: flex;
  gap: 12rpx;
}
.loading-dots .dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #C9A96E;
  animation: bounce 1.4s infinite ease-in-out both;
}
.loading-dots .dot:nth-child(1) { animation-delay: -0.32s; }
.loading-dots .dot:nth-child(2) { animation-delay: -0.16s; }
.loading-dots .dot:nth-child(3) { animation-delay: 0s; }
@keyframes bounce {
  0%, 80%, 100% { transform: scale(0); }
  40% { transform: scale(1); }
}

/* Content wrapper */
.content {
  padding: 0 32rpx 60rpx;
  max-width: 640rpx;
  margin: 0 auto;
}

/* Top bar */
.top-bar {
  display: flex;
  align-items: center;
  padding-left: 24rpx;
}

/* Top decorative band */
.top-band {
  height: 8rpx;
  background: linear-gradient(90deg, transparent, #C9A96E, transparent);
  margin-bottom: 40rpx;
  opacity: 0.5;
}

/* Main card */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.06), 0 2rpx 8rpx rgba(0,0,0,0.04);
}

/* Venue header */
.venue-header {
  background: linear-gradient(135deg, #2D2D3A 0%, #1A1A2E 100%);
  padding: 48rpx 40rpx 36rpx;
  text-align: center;
}
.venue-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
}
.venue-name {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #F5F0E8;
  letter-spacing: 6rpx;
}
.venue-divider {
  width: 48rpx;
  height: 4rpx;
  background: #C9A96E;
  border-radius: 2rpx;
  margin: 20rpx auto 0;
}

/* Share title banner */
.title-banner {
  padding: 32rpx 40rpx 28rpx;
}
.title-text {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #C9A96E;
  text-align: center;
  letter-spacing: 4rpx;
}

/* Detail list */
.detail-list {
  padding: 16rpx 40rpx 36rpx;
}
.detail-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F5F2EC;
}
.detail-item:last-child {
  border-bottom: none;
}
.detail-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.label-icon {
  font-size: 28rpx;
}
.label-text {
  font-size: 28rpx;
  color: #B0A89A;
}
.detail-value {
  font-size: 28rpx;
  color: #2D2D3A;
  font-weight: 500;
}
.detail-value-remark {
  max-width: 55%;
  text-align: right;
  word-break: break-all;
}

/* Address card */
.address-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  margin-top: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.06), 0 2rpx 8rpx rgba(0,0,0,0.04);
  display: flex;
  align-items: center;
  gap: 24rpx;
  transition: opacity 0.2s;
}
.address-card:active {
  opacity: 0.7;
}
.address-left {
  flex-shrink: 0;
}
.address-pin {
  font-size: 40rpx;
}
.address-right {
  flex: 1;
  min-width: 0;
}
.address-label {
  display: block;
  font-size: 24rpx;
  color: #B0A89A;
  margin-bottom: 6rpx;
}
.address-text {
  display: block;
  font-size: 28rpx;
  color: #2D2D3A;
  line-height: 1.5;
}
.address-action {
  flex-shrink: 0;
  background: #F5F2EC;
  border-radius: 12rpx;
  padding: 12rpx 24rpx;
}
.address-copy {
  font-size: 24rpx;
  color: #C9A96E;
  font-weight: 600;
}

/* Close button */
.close-btn {
  width: 52rpx;
  height: 52rpx;
  background: rgba(255,255,255,0.85);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
  flex-shrink: 0;
}
.close-btn:active {
  background: rgba(255,255,255,0.6);
}
.close-icon {
  font-size: 28rpx;
  color: #8A8070;
}

/* Floor map card */
.map-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  margin-top: 24rpx;
  margin-left: auto;
  margin-right: auto;
  max-width: 66.67%;
  overflow: hidden;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.06), 0 2rpx 8rpx rgba(0,0,0,0.04);
  transition: opacity 0.2s;
}
.map-card:active {
  opacity: 0.8;
}
.map-image {
  width: 100%;
  display: block;
}

/* Footer */
.footer {
  text-align: center;
  margin-top: 60rpx;
}
.footer-divider {
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(201,169,110,0.3), transparent);
  margin-bottom: 24rpx;
}
.footer-text {
  font-size: 24rpx;
  color: #CCC5B5;
}
