<view class="page">
  <!-- Loading -->
  <view wx:if="{{loading}}" class="state-wrap">
    <view class="loading-dots">
      <view class="dot"></view>
      <view class="dot"></view>
      <view class="dot"></view>
    </view>
    <text class="state-text">加载中...</text>
  </view>

  <!-- Error -->
  <view wx:if="{{!loading && error}}" class="state-wrap">
    <view class="error-icon">☕</view>
    <text class="state-text">预约信息不存在或已失效</text>
  </view>

  <!-- Content -->
  <view wx:if="{{!loading && !error}}" class="content">
    <!-- Top bar with status bar spacing -->
    <view class="top-bar" style="padding-top: {{statusBarHeight}}px;">
      <view class="close-btn" bindtap="onClose">
        <text class="close-icon">✕</text>
      </view>
    </view>

    <!-- Top decorative band -->
    <view class="top-band"></view>

    <!-- Card -->
    <view class="card">
      <!-- Venue header -->
      <view class="venue-header">
        <view class="venue-name-row">
          <text class="venue-heart">❤️</text>
          <text class="venue-name">{{venueName}}</text>
          <text class="venue-heart">❤️</text>
        </view>
        <text class="venue-subtitle">等风，也等你！</text>
      </view>

      <!-- Share title -->
      <view wx:if="{{shareTitle}}" class="title-banner">
        <text class="title-text">{{shareTitle}}</text>
      </view>

      <!-- Detail rows -->
      <view class="detail-list">
        <view class="detail-item">
          <view class="detail-label">
            <text class="label-icon">📅</text>
            <text class="label-text">日期</text>
          </view>
          <text class="detail-value">{{date}}</text>
        </view>
        <view class="detail-item">
          <view class="detail-label">
            <text class="label-icon">🕐</text>
            <text class="label-text">时段</text>
          </view>
          <text class="detail-value">{{time}}</text>
        </view>
        <view class="detail-item">
          <view class="detail-label">
            <text class="label-icon">🚪</text>
            <text class="label-text">包厢</text>
          </view>
          <text class="detail-value">{{roomName}}</text>
        </view>
        <view class="detail-item">
          <view class="detail-label">
            <text class="label-icon">👥</text>
            <text class="label-text">人数</text>
          </view>
          <text class="detail-value">{{guestCount}}人</text>
        </view>
        <view wx:if="{{remark}}" class="detail-item">
          <view class="detail-label">
            <text class="label-icon">📝</text>
            <text class="label-text">备注</text>
          </view>
          <text class="detail-value detail-value-remark">{{remark}}</text>
        </view>
        <view wx:if="{{shareRemark}}" class="detail-item">
          <view class="detail-label">
            <text class="label-icon">💌</text>
            <text class="label-text">温馨提示</text>
          </view>
          <text class="detail-value detail-value-remark">{{shareRemark}}</text>
        </view>
      </view>
    </view>

    <!-- Address card (tappable - opens navigation) -->
    <view wx:if="{{venueAddress}}" class="address-card" bindtap="onAddressTap">
      <view class="address-left">
        <text class="address-pin">📍</text>
      </view>
      <view class="address-right">
        <text class="address-label">食堂地址</text>
        <text class="address-text">{{venueAddress}}</text>
      </view>
      <view class="address-action">
        <text wx:if="{{venueLatitude && venueLongitude}}" class="address-copy">导航</text>
        <text wx:else class="address-copy">复制</text>
      </view>
    </view>

    <!-- Floor map card -->
    <view wx:if="{{venueMapImage}}" class="map-card" bindtap="onMapImageTap">
      <image src="{{venueMapImage}}" mode="widthFix" class="map-image" />
    </view>

    <!-- Footer -->
    <view class="footer">
      <view class="footer-divider"></view>
      <text class="footer-text"> 由 {{venueName}} 提供</text>
    </view>
  </view>
</view>
