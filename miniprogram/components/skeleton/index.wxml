<view class="skeleton-container">
  <block wx:if="{{type === 'stats'}}">
    <view class="skeleton-stats-row">
      <view class="skeleton-stat-card" wx:for="{{3}}" wx:key="*this" style="background: {{theme.elevated || '#252540'}}; border-radius: 24rpx;">
        <view class="skeleton-line short shimmer" style="background: {{theme.divider || 'rgba(255,255,255,0.06)'}};"></view>
        <view class="skeleton-line medium shimmer" style="background: {{theme.divider || 'rgba(255,255,255,0.06)'}};"></view>
      </view>
    </view>
  </block>
  <block wx:elif="{{type === 'list'}}">
    <view class="skeleton-card" wx:for="{{count}}" wx:key="*this" style="background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border-radius: 24rpx;">
      <view class="skeleton-line long shimmer" style="background: {{theme.divider || 'rgba(255,255,255,0.06)'}};"></view>
      <view class="skeleton-line short shimmer" style="background: {{theme.divider || 'rgba(255,255,255,0.06)'}};"></view>
    </view>
  </block>
  <block wx:elif="{{type === 'detail'}}">
    <view class="skeleton-detail" style="background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border-radius: 24rpx;">
      <view class="skeleton-line full shimmer" style="background: {{theme.divider || 'rgba(255,255,255,0.06)'}};"></view>
      <view class="skeleton-line long shimmer" style="background: {{theme.divider || 'rgba(255,255,255,0.06)'}};"></view>
      <view class="skeleton-line medium shimmer" style="background: {{theme.divider || 'rgba(255,255,255,0.06)'}};"></view>
      <view class="skeleton-line long shimmer" style="background: {{theme.divider || 'rgba(255,255,255,0.06)'}};"></view>
      <view class="skeleton-line short shimmer" style="background: {{theme.divider || 'rgba(255,255,255,0.06)'}};"></view>
    </view>
  </block>
  <block wx:else>
    <view class="skeleton-card" wx:for="{{count}}" wx:key="*this" style="background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border-radius: 24rpx;">
      <view class="skeleton-line long shimmer" style="background: {{theme.divider || 'rgba(255,255,255,0.06)'}};"></view>
      <view class="skeleton-line medium shimmer" style="background: {{theme.divider || 'rgba(255,255,255,0.06)'}};"></view>
    </view>
  </block>
</view>