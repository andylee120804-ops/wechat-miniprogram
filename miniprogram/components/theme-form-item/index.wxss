.theme-form-item {
  margin-bottom: 32rpx;
}

.form-label-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 8rpx;
}

.form-label {
  font-size: 26rpx;
  font-weight: 500;
}

.form-required {
  margin-left: 4rpx;
}

.form-content {
  padding-bottom: 16rpx;
}

.form-error {
  font-size: 22rpx;
  margin-top: 8rpx;
  animation: errorIn 0.2s ease-out;
}

@keyframes errorIn {
  from {
    opacity: 0;
    transform: translateY(-8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}