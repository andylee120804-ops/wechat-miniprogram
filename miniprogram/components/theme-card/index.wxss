.theme-card {
  overflow: hidden;
  position: relative;
  transition: all 0.3s ease;
}

.no-margin {
  margin-bottom: 0 !important;
}

.glass-mode {
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.card-animate {
  animation: cardIn 0.4s ease-out;
}

@keyframes cardIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}