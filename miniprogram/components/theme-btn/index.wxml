<view class="theme-btn {{type}} {{size}} {{block ? 'block' : ''}} {{disabled ? 'disabled' : ''}}" hover-class="btn-press" bindtap="onTap" style="{{type === 'primary' ? 'background:' + (theme.buttonGradient || 'linear-gradient(135deg, #C9A96E, #E8D5A8)') + ';color:' + (theme.textInverse || '#0F0F1A') + ';' : type === 'danger' ? 'background:' + (theme.statusDanger || '#F87171') + ';color:#fff;' : type === 'outline' ? 'background:transparent;border:2rpx solid ' + (theme.accentColor || '#C9A96E') + ';color:' + (theme.accentColor || '#C9A96E') + ';' : 'background:transparent;border:2rpx solid ' + (theme.border || 'rgba(255,255,255,0.1)') + ';color:' + (theme.textPrimary || '#F0F0F5') + ';'}}">
  <view class="btn-loading" wx:if="{{loading}}"></view>
  <text wx:if="{{icon}}" class="btn-icon">{{icon}}</text>
  <text class="btn-text">{{text}}</text>
</view>