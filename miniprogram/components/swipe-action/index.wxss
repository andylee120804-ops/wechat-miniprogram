.swipe-action {
  position: relative;
  overflow: hidden;
}

.swipe-actions {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: row;
}

.swipe-btn {
  width: 140rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.swipe-btn-text {
  color: #fff;
  font-size: 26rpx;
}

.swipe-content {
  position: relative;
  z-index: 1;
  background: inherit;
}