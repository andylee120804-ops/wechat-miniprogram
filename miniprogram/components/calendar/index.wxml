<view class="calendar" style="background: {{theme.cardBg || 'rgba(26,26,46,0.85)'}}; border-radius: 24rpx; padding: 24rpx;">
  <view class="calendar-header">
    <view class="calendar-arrow" bindtap="prevMonth">‹</view>
    <text class="calendar-title" style="color: {{theme.textPrimary || '#F0F0F5'}};">{{currentYear}}年{{currentMonth}}月</text>
    <view class="calendar-arrow" bindtap="nextMonth">›</view>
  </view>
  <view class="calendar-weekdays">
    <text class="weekday" wx:for="{{weekdays}}" wx:key="*this" style="color: {{theme.textMuted || '#5C5C72'}};">{{item}}</text>
  </view>
  <view class="calendar-days">
    <view class="day-cell {{item.isCurrentMonth ? '' : 'other-month'}} {{item.isToday ? 'today' : ''}} {{item.isSelected ? 'selected' : ''}} {{item.isMarked ? 'marked' : ''}}" wx:for="{{days}}" wx:key="dateStr" data-info="{{item}}" bindtap="onDayTap" style="{{item.isSelected ? 'background:' + (theme.accentColor || '#C9A96E') + ';color:' + (theme.textInverse || '#0F0F1A') + ';' : item.isToday ? 'border: 2rpx solid ' + (theme.accentColor || '#C9A96E') + ';' : ''}}">
      <text class="day-number">{{item.day || ''}}</text>
      <view class="day-dot" wx:if="{{item.isMarked && !item.isSelected}}" style="background: {{theme.accentColor || '#C9A96E'}};"></view>
    </view>
  </view>
</view>