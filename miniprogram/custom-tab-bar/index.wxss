.custom-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 100rpx;
  padding-top: 8rpx;
  z-index: 500;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  padding: 4rpx 0;
}

.tab-item:active {
  transform: scale(0.92);
}

.tab-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  margin-bottom: 4rpx;
}

.icon-active {
  transform: scale(1.15);
}

.tab-icon {
  font-size: 36rpx;
  line-height: 1;
}

.tab-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.tab-text {
  font-size: 20rpx;
  font-weight: 500;
  transition: color 0.2s ease;
}

.tab-item.active .tab-text {
  font-weight: 600;
}
