.detail-page {
  background: #0F0F1A;
  min-height: 100vh;
  padding: 32rpx;
  color: #E8E4DC;
}

.loading, .empty {
  text-align: center;
  padding: 64rpx 0;
  color: #8E8E93;
  font-size: 28rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.label {
  font-size: 28rpx;
  color: #8E8E93;
}

.value {
  font-size: 28rpx;
  color: #E8E4DC;
  font-weight: 500;
}
