<view class="detail-page">
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <view class="content" wx:if="{{!loading && purchase}}">
    <view class="amount-row">
      <text class="amount">¥{{amountStr}}</text>
      <text class="status-tag {{purchase.status}}">{{purchase.status === 'pending' ? '待审批' : purchase.status === 'approved' ? '已审批' : purchase.status === 'rejected' ? '已拒绝' : '已报销'}}</text>
    </view>
    <view class="info-row">
      <text class="label">品名</text>
      <text class="value">{{purchase.name || purchase.item}}</text>
    </view>
    <view class="info-row">
      <text class="label">分类</text>
      <text class="value">{{purchase.category || '其他'}}</text>
    </view>
    <view class="info-row">
      <text class="label">数量</text>
      <text class="value">{{purchase.quantity || 1}}{{purchase.unit || '份'}}</text>
    </view>
    <view class="info-row">
      <text class="label">申请人</text>
      <text class="value">{{purchase.purchaseByName || ''}}</text>
    </view>
    <view class="info-row">
      <text class="label">申请日期</text>
      <text class="value">{{dateStr}}</text>
    </view>
    <view class="info-row" wx:if="{{purchase.remark}}">
      <text class="label">备注</text>
      <text class="value">{{purchase.remark}}</text>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && !purchase}}">
    <text>未找到采购记录</text>
  </view>
</view>
