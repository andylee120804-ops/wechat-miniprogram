.detail-page {
  background: #0F0F1A;
  min-height: 100vh;
  padding: 32rpx;
  color: #E8E4DC;
}

.loading, .empty {
  text-align: center;
  padding: 64rpx 0;
  color: #8E8E93;
  font-size: 28rpx;
}

.amount-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.amount {
  font-size: 48rpx;
  font-weight: 700;
}

.positive { color: #4CAF50; }

.type-tag {
  font-size: 22rpx;
  color: #C9A96E;
  background: rgba(201, 169, 110, 0.15);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.label {
  font-size: 28rpx;
  color: #8E8E93;
}

.value {
  font-size: 28rpx;
  color: #E8E4DC;
  font-weight: 500;
}

.link {
  color: #C9A96E;
}
