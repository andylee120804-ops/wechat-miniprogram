.card {
  background: #1A1A2E;
  border-radius: 16rpx;
  padding: 24rpx;
  color: #E8E4DC;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
}

.card-header {
  margin-bottom: 20rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #C9A96E;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.label {
  font-size: 26rpx;
  color: #8E8E93;
}

.value {
  font-size: 26rpx;
  color: #E8E4DC;
  font-weight: 500;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: rgba(201, 169, 110, 0.15);
  color: #C9A96E;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.btn.secondary {
  background: rgba(255, 255, 255, 0.05);
  color: #8E8E93;
}

.error {
  text-align: center;
  padding: 32rpx 0;
  color: #FF6B6B;
  font-size: 26rpx;
}
