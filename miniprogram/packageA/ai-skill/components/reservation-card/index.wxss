.card {
  background: #1A1A2E;
  border-radius: 16rpx;
  padding: 24rpx;
  color: #E8E4DC;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #C9A96E;
}

.badge {
  font-size: 24rpx;
  color: #C9A96E;
  background: rgba(201, 169, 110, 0.15);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.section-title {
  font-size: 26rpx;
  color: #8E8E93;
  margin: 16rpx 0 8rpx;
}

.slot-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.slot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.slot.available {
  background: rgba(76, 175, 80, 0.1);
  border: 1rpx solid rgba(76, 175, 80, 0.3);
}

.slot.booked {
  background: rgba(142, 142, 147, 0.1);
}

.tag {
  font-size: 24rpx;
  color: #4CAF50;
}

.booked-tag {
  color: #8E8E93;
}

.item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.item-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.time {
  font-size: 28rpx;
  color: #C9A96E;
  font-weight: 500;
}

.room {
  font-size: 26rpx;
  color: #E8E4DC;
}

.item-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.guest {
  font-size: 26rpx;
  color: #8E8E93;
}

.count {
  font-size: 24rpx;
  color: #8E8E93;
}

.empty {
  text-align: center;
  padding: 32rpx 0;
  color: #8E8E93;
  font-size: 26rpx;
}

.error {
  text-align: center;
  padding: 32rpx 0;
  color: #FF6B6B;
  font-size: 26rpx;
}
