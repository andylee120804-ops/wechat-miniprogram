/* ========================================
   Typography
   ======================================== */

.text-display {
  font-size: 56rpx;
  font-weight: 800;
}

.text-title1 {
  font-size: 44rpx;
  font-weight: 700;
}

.text-title2 {
  font-size: 36rpx;
  font-weight: 600;
}

.text-title3 {
  font-size: 32rpx;
  font-weight: 600;
}

.text-body {
  font-size: 30rpx;
  font-weight: 400;
}

.text-bodySmall {
  font-size: 28rpx;
  font-weight: 400;
}

.text-caption {
  font-size: 26rpx;
  font-weight: 400;
}

.text-overline {
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

/* Semantic text colors - these are defaults, override per-theme via inline styles */
.text-primary {
  color: #1A202C;
}

.text-secondary {
  color: rgba(26, 32, 44, 0.60);
}

.text-muted {
  color: rgba(26, 32, 44, 0.38);
}

/* Text alignment */
.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

/* Monospace font for financial numbers */
.font-mono {
  font-family: 'DIN Alternate', 'SF Mono', -apple-system, monospace;
  font-variant-numeric: tabular-nums;
}

/* ========================================
   Common Patterns
   ======================================== */

/* Single-line text overflow */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Two-line text overflow */
.ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* Card base style */
.card-base {
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* Glass morphism effect */
.glass-effect {
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  background-color: rgba(255, 255, 255, 0.70);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
}

/* Horizontal divider line */
.divider {
  height: 1rpx;
  background-color: rgba(0, 0, 0, 0.06);
  width: 100%;
}

/* iPhone X+ bottom safe area padding */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
