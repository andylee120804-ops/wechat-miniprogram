/**
 * Bottom Bar Styles - Premium WeChat Mini-Program
 *
 * Unified bottom action bar styles for all pages.
 * Import this file in any page/component wxss:
 *   @import "../../styles/bottom-bar.wxss";
 *
 * Structure:
 *   <view class="bottom-bar">
 *     <view class="bottom-bar-inner single-btn|two-btns">
 *       <view class="bar-btn bar-btn-primary">确认</view>
 *       <view class="bar-btn bar-btn-danger">删除</view>
 *     </view>
 *   </view>
 */

/* Base bottom bar container */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100vw;
  background: rgba(26, 26, 46, 0.4);
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  z-index: 100;
  box-sizing: border-box;
  padding: 24rpx 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* Inner flex container - base styles */
.bottom-bar-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  width: 100%;
}

/* Single button - center aligned */
.bottom-bar-inner.single-btn {
  justify-content: center;
}

/* Two buttons - space between */
.bottom-bar-inner.two-btns {
  justify-content: space-between;
}

/* Bar button - matches section block style */
.bar-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.2s ease;
  min-width: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bar-btn:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.bar-btn-primary {
  background: rgba(201, 169, 110, 0.15);
  color: #C9A96E;
  border: 1rpx solid rgba(201, 169, 110, 0.3);
}

/* Wide primary button - 2x width of danger button to prevent accidental taps */
.bar-btn-primary-wide {
  flex: 2;
}

.bar-btn-danger {
  background: rgba(248, 113, 113, 0.12);
  color: #F87171;
  border: 1rpx solid rgba(248, 113, 113, 0.25);
}

/* Three buttons - space between */
.bottom-bar-inner.three-btns {
  justify-content: space-between;
}

/* Outline button - subtle border only, for secondary actions */
.bar-btn-outline {
  background: transparent;
  color: #C9A96E;
  border: 1rpx solid rgba(201, 169, 110, 0.3);
}

/* Safe area bottom padding */
.bottom-bar.safe-bottom,
.action-bar.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}